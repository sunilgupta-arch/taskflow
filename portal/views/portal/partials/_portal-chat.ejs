<%# ── Portal Chat Floating Widget ─────────────────────────────────────────── %>
<style>
/* ── Widget shell ─────────────────────────────────────────────────────────── */
.pcw {
  position: fixed;
  bottom: 80px; right: 20px;
  width: 720px; height: 510px;
  display: flex; flex-direction: column;
  background: #111827;
  border: 1px solid #1f2937;
  border-radius: 14px;
  box-shadow: 0 28px 70px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.04);
  z-index: 8500; overflow: hidden;
  font-family: 'Inter','Segoe UI',system-ui,sans-serif;
  font-weight: 300;
  transition: height .2s cubic-bezier(.4,0,.2,1);
  user-select: none;
}
.pcw.pcw-min { height: 46px; }
.pcw.pcw-min .pcw-body { display: none; }

/* ── Header ───────────────────────────────────────────────────────────────── */
.pcw-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 10px; height: 46px;
  background: #0d1117; border-bottom: 1px solid #1f2937;
  border-radius: 14px 14px 0 0;
  cursor: grab; flex-shrink: 0;
}
.pcw-hdr:active { cursor: grabbing; }
.pcw-hdr-l { display: flex; align-items: center; gap: 8px; }
.pcw-hdr-icon { color: #6366f1; font-size: .8rem; }
.pcw-hdr-title { font-size: .74rem; font-weight: 500; color: #e5e7eb; letter-spacing: .2px; }
.pcw-hdr-badge {
  background: #ef4444; color: #fff;
  font-size: .58rem; font-weight: 700;
  border-radius: 10px; padding: 1px 6px; min-width: 18px; text-align: center;
}
.pcw-hdr-r { display: flex; align-items: center; gap: 2px; }

/* ── Icon button ──────────────────────────────────────────────────────────── */
.pcw-ibtn {
  background: none; border: none; cursor: pointer;
  width: 28px; height: 28px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  color: #4b5563; font-size: .76rem;
  transition: background .12s, color .12s;
}
.pcw-ibtn:hover { background: rgba(255,255,255,.07); color: #e5e7eb; }
.pcw-ibtn.accent { color: #6366f1; }

/* ── Body ─────────────────────────────────────────────────────────────────── */
.pcw-body { display: flex; flex: 1; overflow: hidden; min-height: 0; }

/* ── Sidebar ──────────────────────────────────────────────────────────────── */
.pcw-sb {
  width: 235px; min-width: 235px;
  border-right: 1px solid #1f2937;
  display: flex; flex-direction: column;
  background: #0d1117;
}
.pcw-sb-search {
  padding: 9px 10px; border-bottom: 1px solid #1f2937;
  position: relative; flex-shrink: 0;
}
.pcw-sb-si {
  position: absolute; left: 19px; top: 50%; transform: translateY(-50%);
  color: #374151; font-size: .68rem; pointer-events: none;
}
.pcw-search {
  width: 100%; box-sizing: border-box;
  background: #161b22; border: 1px solid #1f2937; border-radius: 8px;
  padding: 6px 10px 6px 28px;
  font-size: .73rem; font-weight: 300; font-family: inherit;
  color: #d1d5db; outline: none; transition: border-color .15s;
}
.pcw-search:focus { border-color: rgba(99,102,241,.4); }
.pcw-search::placeholder { color: #374151; }

.pcw-conv-list { flex: 1; overflow-y: auto; }
.pcw-conv-list::-webkit-scrollbar { width: 3px; }
.pcw-conv-list::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 2px; }

.pcw-conv-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; cursor: pointer;
  border-bottom: 1px solid rgba(255,255,255,.03);
  transition: background .1s; border-left: 2px solid transparent;
}
.pcw-conv-item:hover { background: rgba(255,255,255,.04); }
.pcw-conv-item.pcw-active { background: rgba(99,102,241,.07); border-left-color: #6366f1; }
.pcw-conv-item.pcw-muted { opacity: .5; }

.pcw-av {
  width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .7rem; color: #fff;
}
.pcw-av-g { border-radius: 9px; }
.pcw-av-wrap { position: relative; flex-shrink: 0; }
.pcw-online-dot {
  position: absolute; bottom: 0; right: 0;
  width: 9px; height: 9px; border-radius: 50%;
  background: #10b981; border: 2px solid #0d1117;
}

.pcw-conv-meta { flex: 1; min-width: 0; }
.pcw-conv-name {
  font-size: .76rem; font-weight: 400; color: #c9d1d9;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pcw-conv-preview {
  font-size: .66rem; font-weight: 300; color: #4b5563; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pcw-conv-r { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.pcw-conv-time { font-size: .6rem; font-weight: 300; color: #374151; }
.pcw-unread-badge {
  background: #6366f1; color: #fff;
  font-size: .58rem; font-weight: 700;
  border-radius: 10px; padding: 1px 6px; min-width: 18px; text-align: center;
}
.pcw-empty { padding: 24px 14px; text-align: center; color: #374151; font-size: .72rem; }

/* ── Main area ────────────────────────────────────────────────────────────── */
.pcw-main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #111827; }

.pcw-placeholder {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10px;
}
.pcw-placeholder i { font-size: 2.2rem; color: #1f2937; }
.pcw-placeholder p { font-size: .74rem; font-weight: 300; color: #374151; margin: 0; }

/* ── Thread ───────────────────────────────────────────────────────────────── */
.pcw-thread { display: none; flex-direction: column; flex: 1; min-height: 0; }
.pcw-thread.pcw-show { display: flex; }

.pcw-thread-hdr {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; border-bottom: 1px solid #1f2937;
  background: #0d1117; flex-shrink: 0;
}
.pcw-back { display: none; }
.pcw-th-av {
  width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .63rem; color: #fff;
}
.pcw-th-info { flex: 1; min-width: 0; }
.pcw-th-name { font-size: .77rem; font-weight: 500; color: #e5e7eb; }
.pcw-th-sub { font-size: .63rem; font-weight: 300; color: #4b5563; margin-top: 1px; }

/* ── Messages ─────────────────────────────────────────────────────────────── */
.pcw-msgs {
  flex: 1; overflow-y: auto; padding: 10px 12px;
  display: flex; flex-direction: column; gap: 1px;
}
.pcw-msgs::-webkit-scrollbar { width: 3px; }
.pcw-msgs::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 2px; }

.pcw-load-more {
  align-self: center; font-size: .65rem; font-weight: 300; color: #6366f1;
  cursor: pointer; padding: 3px 14px;
  border: 1px solid #1f2937; border-radius: 20px;
  background: #161b22; margin-bottom: 6px; transition: border-color .15s;
}
.pcw-load-more:hover { border-color: #6366f1; }

.pcw-date-div { text-align: center; margin: 6px 0 2px; position: relative; }
.pcw-date-div span {
  background: #111827; position: relative; z-index: 1;
  color: #374151; font-size: .6rem; font-weight: 300; padding: 0 10px;
}
.pcw-date-div::before {
  content: ''; position: absolute; top: 50%; left: 0; right: 0;
  height: 1px; background: #1f2937;
}

/* Message rows */
.pcw-row { display: flex; gap: 7px; padding: 2px 0; }
.pcw-row.pcw-mine { flex-direction: row-reverse; }
.pcw-row.pcw-grp { padding-top: 1px; }
.pcw-row.pcw-grp .pcw-row-av { visibility: hidden; }

.pcw-row-av {
  width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0; margin-top: 3px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .56rem; color: #fff;
}
.pcw-row-body { max-width: 74%; display: flex; flex-direction: column; }
.pcw-mine .pcw-row-body { align-items: flex-end; }

.pcw-row-sender { font-size: .61rem; font-weight: 400; color: #4b5563; margin-bottom: 2px; padding: 0 3px; }
.pcw-grp .pcw-row-sender { display: none; }

.pcw-bubble {
  background: #1f2937; border-radius: 12px;
  padding: 7px 11px; font-size: .75rem; font-weight: 300; color: #d1d5db;
  line-height: 1.55; word-break: break-word; position: relative; max-width: 100%;
}
.pcw-mine .pcw-bubble { background: rgba(99,102,241,.15); border: 1px solid rgba(99,102,241,.2); color: #e5e7eb; }
.pcw-bubble a { color: #6366f1; text-decoration: none; }
.pcw-bubble a:hover { text-decoration: underline; }
.pcw-mention { color: #a78bfa; font-weight: 400; }
.pcw-deleted { color: #374151; font-size: .7rem; font-style: italic; }
.pcw-edited-tag { font-size: .58rem; font-weight: 300; color: #374151; margin-left: 4px; }

/* Image in bubble */
.pcw-img {
  max-width: 220px; max-height: 160px; border-radius: 8px;
  display: block; margin-top: 5px; cursor: zoom-in; object-fit: cover;
}
/* File in bubble */
.pcw-file {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.04); border: 1px solid #1f2937; border-radius: 9px;
  padding: 8px 10px; margin-top: 5px; text-decoration: none; max-width: 230px;
  transition: border-color .15s;
}
.pcw-file:hover { border-color: #6366f1; }
.pcw-file-icon { font-size: 1.1rem; color: #4b5563; flex-shrink: 0; }
.pcw-file-info { min-width: 0; }
.pcw-file-name { font-size: .68rem; font-weight: 400; color: #c9d1d9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 165px; }
.pcw-file-size { font-size: .6rem; font-weight: 300; color: #4b5563; margin-top: 1px; }

/* Message hover actions */
.pcw-acts {
  position: absolute; top: -16px; right: 6px;
  background: #161b22; border: 1px solid #1f2937; border-radius: 9px;
  display: flex; gap: 1px; padding: 2px;
  opacity: 0; pointer-events: none; transition: opacity .12s; z-index: 5;
}
.pcw-bubble:hover .pcw-acts { opacity: 1; pointer-events: auto; }
.pcw-act {
  background: none; border: none; cursor: pointer; color: #4b5563;
  width: 22px; height: 22px; border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: .62rem; transition: all .12s;
}
.pcw-act:hover { background: rgba(255,255,255,.07); color: #e5e7eb; }
.pcw-act.danger:hover { color: #ef4444; }

/* Timestamp */
.pcw-row-foot {
  display: flex; align-items: center; gap: 4px;
  margin-top: 2px; padding: 0 3px;
  font-size: .59rem; font-weight: 300; color: #374151;
}
.pcw-mine .pcw-row-foot { justify-content: flex-end; }
.pcw-tick-sent { color: #374151; font-size: .7rem; }
.pcw-tick-read { color: #6366f1; font-size: .7rem; }

/* Typing indicator */
.pcw-typing {
  display: flex; align-items: center; gap: 5px; padding: 4px 0;
  font-size: .63rem; color: #4b5563; font-weight: 300;
}
.pcw-dot {
  width: 5px; height: 5px; background: #374151; border-radius: 50%;
  animation: pcwPulse 1.2s ease-in-out infinite;
}
.pcw-dot:nth-child(2) { animation-delay: .2s; }
.pcw-dot:nth-child(3) { animation-delay: .4s; }
@keyframes pcwPulse {
  0%,60%,100% { transform: scale(1); opacity: .4; }
  30%          { transform: scale(1.5); opacity: 1; }
}

/* Drop zone */
.pcw-drop {
  position: absolute; inset: 0;
  background: rgba(99,102,241,.07); border: 2px dashed #6366f1;
  border-radius: 10px; display: none;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 10px; color: #6366f1; font-size: .82rem; font-weight: 400;
  pointer-events: none; z-index: 20;
}
.pcw-drop.pcw-dropping { display: flex; }
.pcw-drop i { font-size: 2rem; }
.pcw-spin { padding: 20px; text-align: center; color: #374151; font-size: .7rem; font-weight: 300; }

/* ── Scroll-to-bottom ─────────────────────────────────────────────────────── */
.pcw-scroll-btn {
  position: absolute; bottom: 10px; right: 14px;
  width: 30px; height: 30px; border-radius: 50%;
  background: #161b22; border: 1px solid #1f2937;
  color: #4b5563; cursor: pointer; font-size: .72rem;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 12px rgba(0,0,0,.4); transition: all .15s; z-index: 10;
}
.pcw-scroll-btn:hover { background: #1f2937; color: #6366f1; border-color: rgba(99,102,241,.4); }

/* ── Edit message ─────────────────────────────────────────────────────────── */
.pcw-bubble.pcw-editing { background: #161b22; border: 1px solid rgba(99,102,241,.3) !important; }
.pcw-edit-ta {
  width: 100%; box-sizing: border-box;
  background: transparent; border: none; outline: none; resize: none;
  font-size: .75rem; font-weight: 300; font-family: inherit;
  color: #e5e7eb; line-height: 1.5; min-height: 34px; max-height: 100px;
  overflow-y: auto; padding: 0;
}
.pcw-edit-btns { display: flex; gap: 5px; margin-top: 6px; }
.pcw-edit-save, .pcw-edit-cancel {
  font-size: .65rem; font-weight: 400; border-radius: 6px;
  padding: 3px 9px; cursor: pointer; font-family: inherit; transition: all .12s;
}
.pcw-edit-save { background: rgba(99,102,241,.15); border: 1px solid rgba(99,102,241,.3); color: #6366f1; }
.pcw-edit-save:hover { background: rgba(99,102,241,.25); }
.pcw-edit-cancel { background: rgba(255,255,255,.05); border: 1px solid #1f2937; color: #4b5563; }
.pcw-edit-cancel:hover { background: rgba(255,255,255,.09); color: #c9d1d9; }

/* ── Reply bar ────────────────────────────────────────────────────────────── */
.pcw-reply-bar {
  display: none; align-items: center; gap: 8px;
  padding: 6px 12px; border-top: 1px solid #1f2937; background: #0d1117; flex-shrink: 0;
}
.pcw-reply-bar.pcw-show { display: flex; }
.pcw-reply-icon { color: #a78bfa; font-size: .8rem; flex-shrink: 0; }
.pcw-reply-text {
  flex: 1; font-size: .67rem; font-weight: 300; color: #4b5563;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pcw-reply-text strong { color: #a78bfa; font-weight: 400; }

/* ── Pending files ────────────────────────────────────────────────────────── */
.pcw-pend-files {
  display: none; flex-wrap: wrap; gap: 6px;
  padding: 6px 12px 0; flex-shrink: 0;
}
.pcw-pend-files.pcw-show { display: flex; }
.pcw-pend-file {
  display: flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,.04); border: 1px solid #1f2937;
  border-radius: 8px; padding: 4px 8px;
  font-size: .67rem; font-weight: 300; color: #9ca3af; max-width: 180px;
}
.pcw-pend-file span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pcw-pend-rm { background: none; border: none; color: #4b5563; cursor: pointer; padding: 0; font-size: .72rem; }
.pcw-pend-rm:hover { color: #ef4444; }

/* ── Input bar ────────────────────────────────────────────────────────────── */
.pcw-input-bar {
  display: flex; align-items: flex-end; gap: 6px;
  padding: 9px 12px; border-top: 1px solid #1f2937;
  background: #0d1117; flex-shrink: 0;
}
.pcw-input-wrap { flex: 1; position: relative; }
.pcw-input {
  width: 100%; box-sizing: border-box;
  min-height: 34px; max-height: 110px;
  background: #161b22; border: 1px solid #1f2937; border-radius: 10px;
  padding: 8px 12px;
  font-size: .75rem; font-weight: 300; font-family: inherit;
  color: #e5e7eb; outline: none; line-height: 1.5;
  overflow-y: auto; white-space: pre-wrap; word-break: break-word;
  transition: border-color .15s;
}
.pcw-input:focus { border-color: rgba(99,102,241,.35); }
.pcw-input:empty::before { content: attr(data-ph); color: #374151; pointer-events: none; }
.pcw-input::-webkit-scrollbar { width: 3px; }

/* @mention dropdown */
.pcw-mention-dd {
  position: absolute; bottom: calc(100% + 5px); left: 0; right: 0;
  background: #161b22; border: 1px solid #1f2937; border-radius: 10px;
  overflow: hidden; max-height: 160px; overflow-y: auto;
  z-index: 100; box-shadow: 0 10px 28px rgba(0,0,0,.5); display: none;
}
.pcw-mention-dd.pcw-show { display: block; }
.pcw-mitem {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; cursor: pointer;
  font-size: .73rem; font-weight: 300; color: #d1d5db;
  transition: background .1s; border-bottom: 1px solid rgba(255,255,255,.03);
}
.pcw-mitem:last-child { border-bottom: none; }
.pcw-mitem:hover, .pcw-mitem.pcw-msel { background: rgba(99,102,241,.09); }
.pcw-mitem .pcw-av { width: 22px; height: 22px; font-size: .52rem; }
.pcw-mitem-role { font-size: .6rem; color: #374151; }

/* Send button */
.pcw-send {
  width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
  background: rgba(99,102,241,.15); border: 1px solid rgba(99,102,241,.3);
  color: #6366f1; cursor: pointer; font-size: .8rem;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s;
}
.pcw-send:hover { background: rgba(99,102,241,.25); }

/* ── New chat modal ───────────────────────────────────────────────────────── */
.pcw-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.55); backdrop-filter: blur(3px);
  z-index: 9100; display: none;
}
.pcw-overlay.pcw-show { display: block; }
.pcw-modal {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 340px; max-height: 500px;
  background: #111827; border: 1px solid #1f2937; border-radius: 14px;
  display: none; flex-direction: column;
  z-index: 9200; box-shadow: 0 28px 70px rgba(0,0,0,.7);
  font-family: inherit; font-weight: 300;
}
.pcw-modal.pcw-show { display: flex; }
.pcw-modal-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px 12px; border-bottom: 1px solid #1f2937; flex-shrink: 0;
  font-size: .78rem; font-weight: 500; color: #e5e7eb;
}
.pcw-modal-search {
  margin: 10px; box-sizing: border-box;
  background: #161b22; border: 1px solid #1f2937; border-radius: 9px;
  padding: 8px 12px; width: calc(100% - 20px);
  font-size: .74rem; font-weight: 300; font-family: inherit;
  color: #e5e7eb; outline: none; flex-shrink: 0; transition: border-color .15s;
}
.pcw-modal-search:focus { border-color: rgba(99,102,241,.4); }
.pcw-modal-search::placeholder { color: #374151; }
.pcw-user-list { flex: 1; overflow-y: auto; padding: 4px 0; }
.pcw-user-list::-webkit-scrollbar { width: 3px; }
.pcw-uitem {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 14px; cursor: pointer; transition: background .1s;
}
.pcw-uitem:hover { background: rgba(255,255,255,.04); }
.pcw-uitem .pcw-av { width: 32px; height: 32px; font-size: .64rem; }
.pcw-uitem-name { font-size: .76rem; font-weight: 400; color: #c9d1d9; }
.pcw-uitem-role { font-size: .61rem; font-weight: 300; color: #4b5563; margin-top: 1px; }

/* ── Floating toggle button ───────────────────────────────────────────────── */
.pcw-fab {
  position: fixed; bottom: 20px; right: 20px;
  width: 48px; height: 48px; border-radius: 50%;
  background: #6366f1; border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; color: #fff;
  box-shadow: 0 6px 20px rgba(99,102,241,.5);
  transition: all .2s; z-index: 8400;
}
.pcw-fab:hover { background: #4f46e5; transform: scale(1.07); box-shadow: 0 8px 28px rgba(99,102,241,.6); }
.pcw-fab.pcw-on { background: #374151; box-shadow: 0 4px 12px rgba(0,0,0,.4); }
.pcw-fab-badge {
  position: absolute; top: -3px; right: -3px;
  background: #ef4444; color: #fff;
  font-size: .54rem; font-weight: 700;
  border-radius: 10px; padding: 1px 5px; min-width: 16px; text-align: center;
  border: 2px solid #111827; display: none;
}
</style>

<!-- ── Floating Widget ───────────────────────────────────────────────────── -->
<div class="pcw" id="pcwWidget" style="display:none">
  <div class="pcw-hdr" id="pcwHdr">
    <div class="pcw-hdr-l">
      <i class="bi bi-chat-fill pcw-hdr-icon"></i>
      <span class="pcw-hdr-title">Messages</span>
      <span class="pcw-hdr-badge" id="pcwHdrBadge" style="display:none"></span>
    </div>
    <div class="pcw-hdr-r">
      <button class="pcw-ibtn accent" onclick="pcwNewChat()" title="New conversation"><i class="bi bi-pencil-square"></i></button>
      <button class="pcw-ibtn" id="pcwSoundBtn" onclick="pcwToggleSound()" title="Mute notification sound"><i class="bi bi-volume-up-fill" id="pcwSoundIcon"></i></button>
      <button class="pcw-ibtn" id="pcwMinBtn" onclick="pcwMinimize()" title="Minimize"><i class="bi bi-dash-lg"></i></button>
      <button class="pcw-ibtn" onclick="pcwClose()" title="Close"><i class="bi bi-x-lg"></i></button>
    </div>
  </div>

  <div class="pcw-body">
    <!-- Sidebar -->
    <div class="pcw-sb" id="pcwSb">
      <div class="pcw-sb-search">
        <i class="bi bi-search pcw-sb-si"></i>
        <input class="pcw-search" id="pcwSearch" placeholder="Search…" autocomplete="off"
               oninput="pcwFilterConvs(this.value)">
      </div>
      <div class="pcw-conv-list" id="pcwConvList">
        <div class="pcw-empty">Loading…</div>
      </div>
    </div>

    <!-- Main -->
    <div class="pcw-main">
      <div class="pcw-placeholder" id="pcwPh">
        <i class="bi bi-chat-dots"></i>
        <p>Select a conversation or start a new one</p>
      </div>

      <div class="pcw-thread" id="pcwThread">
        <!-- Thread header -->
        <div class="pcw-thread-hdr">
          <button class="pcw-ibtn pcw-back" id="pcwBack" onclick="pcwShowSb()" title="Back"><i class="bi bi-arrow-left"></i></button>
          <div class="pcw-av-wrap" style="flex-shrink:0">
            <div class="pcw-th-av" id="pcwThAv"></div>
          </div>
          <div class="pcw-th-info">
            <div class="pcw-th-name" id="pcwThName"></div>
            <div class="pcw-th-sub" id="pcwThSub"></div>
          </div>
        </div>

        <!-- Messages + scroll btn wrapper -->
        <div style="position:relative;flex:1;min-height:0;display:flex;flex-direction:column;">
          <div class="pcw-msgs" id="pcwMsgs">
            <div class="pcw-spin">Loading…</div>
            <div class="pcw-drop" id="pcwDrop">
              <i class="bi bi-cloud-upload-fill"></i>
              <span>Drop files to send</span>
            </div>
          </div>
          <button class="pcw-scroll-btn" id="pcwScrollBtn" onclick="pcwScrollBottom()" style="display:none" title="Scroll to bottom">
            <i class="bi bi-chevron-double-down"></i>
          </button>
        </div>

        <!-- Reply bar -->
        <div class="pcw-reply-bar" id="pcwReplyBar">
          <i class="bi bi-reply-fill pcw-reply-icon"></i>
          <div class="pcw-reply-text" id="pcwReplyText"></div>
          <button class="pcw-ibtn" onclick="pcwCancelReply()"><i class="bi bi-x"></i></button>
        </div>

        <!-- Pending attachments -->
        <div class="pcw-pend-files" id="pcwPendFiles"></div>

        <!-- Input bar -->
        <div class="pcw-input-bar">
          <label class="pcw-ibtn" title="Attach file" style="cursor:pointer">
            <i class="bi bi-paperclip"></i>
            <input type="file" id="pcwFileIn" style="display:none" multiple onchange="pcwFileSelected(event)">
          </label>
          <div class="pcw-input-wrap">
            <div class="pcw-input" id="pcwInput" contenteditable="true" data-ph="Type a message…"
                 onkeydown="pcwKeydown(event)" oninput="pcwInputChange()" onpaste="pcwPaste(event)"></div>
            <div class="pcw-mention-dd" id="pcwMentionDd"></div>
          </div>
          <button class="pcw-send" onclick="pcwSend()" title="Send (Enter)"><i class="bi bi-send-fill"></i></button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- New chat modal -->
<div class="pcw-overlay" id="pcwOverlay" onclick="pcwCloseModal()"></div>
<div class="pcw-modal" id="pcwModal">
  <div class="pcw-modal-hdr">
    <span>New Message</span>
    <button class="pcw-ibtn" onclick="pcwCloseModal()"><i class="bi bi-x-lg"></i></button>
  </div>
  <input class="pcw-modal-search" id="pcwUSearch" placeholder="Search people…" autocomplete="off"
         oninput="pcwFilterUsers(this.value)">
  <div class="pcw-user-list" id="pcwUList"></div>
</div>

<!-- Floating Action Button -->
<button class="pcw-fab" id="pcwFab" onclick="pcwToggle()" title="Messages">
  <i class="bi bi-chat-fill"></i>
  <span class="pcw-fab-badge" id="pcwFabBadge"></span>
</button>

<script>
(function(){
'use strict';

/* ── constants ──────────────────────────────────────────────────────────── */
const PCW_ME   = <%= user.id %>;
const COLORS   = ['#6366f1','#8b5cf6','#ec4899','#f59e0b','#10b981','#3b82f6','#14b8a6','#f97316'];

/* ── state ──────────────────────────────────────────────────────────────── */
let _open=false, _min=false;
let _cid=null, _convs=[], _users=[];
let _replyTo=null, _pending=[];
let _hasMore={}, _loading=false;
let _mentionIdx=0, _mentionOn=false;
let _dragN=0;
let _px=null, _py=null;
let _online=new Set();
let _editMsgId=null, _editOrig='', _editActsHtml='';
let _soundOn=localStorage.getItem('pcw-sound')!=='0';
let _audioCtx=null;
let _typStop={};  // convId -> timeout for stop-typing

/* ── helpers ────────────────────────────────────────────────────────────── */
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function strip(s){ return (s||'').replace(/<[^>]+>/g,''); }
function aColor(n){ let h=0; for(let c of (n||'?')) h=((h<<5)-h+c.charCodeAt(0))|0; return COLORS[Math.abs(h)%COLORS.length]; }
function aInit(n){ return (n||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase(); }
function fShort(dt){
  if(!dt) return '';
  const d=new Date(dt),now=new Date(),diff=now-d;
  if(diff<60000) return 'now';
  if(diff<3600000) return Math.floor(diff/60000)+'m';
  if(diff<86400000) return d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  const y=new Date(now); y.setDate(y.getDate()-1);
  if(d.toDateString()===y.toDateString()) return 'Yesterday';
  return d.toLocaleDateString([],{month:'short',day:'numeric'});
}
function fTime(dt){ return dt ? new Date(dt).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'}) : ''; }
function fDate(dt){
  if(!dt) return '';
  const d=new Date(dt),now=new Date();
  if(d.toDateString()===now.toDateString()) return 'Today';
  const y=new Date(now); y.setDate(y.getDate()-1);
  if(d.toDateString()===y.toDateString()) return 'Yesterday';
  return d.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric'});
}
function fSize(b){ if(!b) return ''; if(b<1024) return b+' B'; if(b<1048576) return (b/1024).toFixed(1)+' KB'; return (b/1048576).toFixed(1)+' MB'; }
function fIcon(mime){
  if(!mime) return 'bi bi-file-earmark';
  if(mime.startsWith('image/')) return 'bi bi-file-image';
  if(mime.startsWith('video/')) return 'bi bi-file-play';
  if(mime.startsWith('audio/')) return 'bi bi-file-music';
  if(mime.includes('pdf')) return 'bi bi-file-pdf';
  if(mime.includes('word')||mime.includes('document')) return 'bi bi-file-word';
  if(mime.includes('sheet')||mime.includes('excel')||mime.includes('csv')) return 'bi bi-file-excel';
  if(mime.includes('zip')||mime.includes('compressed')) return 'bi bi-file-zip';
  return 'bi bi-file-earmark';
}
function api(url,opts={}){
  opts.headers=Object.assign({'X-Requested-With':'XMLHttpRequest'},opts.headers||{});
  return fetch(url,opts).then(r=>r.json());
}
function $(id){ return document.getElementById(id); }

/* ── open / close / minimize ─────────────────────────────────────────────── */
window.pcwToggle  = ()=>_open ? pcwClose() : pcwOpen();
window.pcwClose   = ()=>{ _open=false; $('pcwWidget').style.display='none'; $('pcwFab').classList.remove('pcw-on'); };
window.pcwMinimize= ()=>{
  _min=!_min;
  $('pcwWidget').classList.toggle('pcw-min',_min);
  $('pcwMinBtn').innerHTML=_min?'<i class="bi bi-chevron-up"></i>':'<i class="bi bi-dash-lg"></i>';
};
window.pcwOpen = async ()=>{
  _open=true;
  const w=$('pcwWidget');
  w.style.display='flex'; w.style.flexDirection='column';
  $('pcwFab').classList.add('pcw-on');
  restorePos();
  if(!_convs.length) await loadConvs();
  if(!_users.length) await loadUsers();
};

/* ── drag ────────────────────────────────────────────────────────────────── */
function restorePos(){
  const w=$('pcwWidget');
  try{ const s=localStorage.getItem('pcwPos'); if(s){ const {x,y}=JSON.parse(s); applyPos(x,y); return; } }catch(e){}
  w.style.cssText+=';bottom:80px;right:20px;left:auto;top:auto';
}
function applyPos(x,y){
  const w=$('pcwWidget');
  x=Math.max(10,Math.min(x,window.innerWidth-(w.offsetWidth||720)-10));
  y=Math.max(10,Math.min(y,window.innerHeight-48-10));
  w.style.left=x+'px'; w.style.top=y+'px'; w.style.right='auto'; w.style.bottom='auto';
  _px=x; _py=y;
}
let _drag=false,_ox=0,_oy=0;
$('pcwHdr').addEventListener('mousedown',e=>{
  if(e.target.closest('.pcw-ibtn')) return;
  _drag=true;
  const r=$('pcwWidget').getBoundingClientRect();
  _ox=e.clientX-r.left; _oy=e.clientY-r.top;
  $('pcwWidget').style.transition='none'; e.preventDefault();
});
document.addEventListener('mousemove',e=>{ if(!_drag) return; applyPos(e.clientX-_ox,e.clientY-_oy); });
document.addEventListener('mouseup',()=>{ if(!_drag) return; _drag=false; if(_px!==null) localStorage.setItem('pcwPos',JSON.stringify({x:_px,y:_py})); });

/* ── data loading ────────────────────────────────────────────────────────── */
async function loadConvs(){
  try{
    const j=await api('/portal/chat/conversations');
    _convs=j.data.conversations||[];
    renderConvList(); updateBadge();
  }catch(e){ console.error('pcw convs',e); }
}
async function loadUsers(){
  try{
    const j=await api('/portal/chat/users');
    _users=j.data.users||[];
  }catch(e){
    const seen=new Set([PCW_ME]);
    _convs.forEach(c=>(c.participants||[]).forEach(p=>{ if(!seen.has(p.id)){ seen.add(p.id); _users.push(p); } }));
  }
}

/* ── conversation list ───────────────────────────────────────────────────── */
function convName(c){
  if(c.type==='group') return c.name||'Group';
  const o=(c.participants||[]).find(p=>p.id!==PCW_ME);
  return o?o.name:c.name||'Chat';
}
function renderConvList(q=''){
  const el=$('pcwConvList');
  let list=_convs;
  if(q){ const lq=q.toLowerCase(); list=list.filter(c=>convName(c).toLowerCase().includes(lq)); }
  if(!list.length){ el.innerHTML=`<div class="pcw-empty">${q?'No results':'No conversations yet'}</div>`; return; }
  el.innerHTML=list.map(c=>{
    const name=convName(c), grp=c.type==='group';
    const col=aColor(name), ini=aInit(name);
    const unread=c.unread_count||0;
    const preview=strip(c.last_message||'').slice(0,38)||'';
    const time=fShort(c.last_message_at||c.updated_at);
    const active=c.id===_cid?'pcw-active':'';
    const otherId=!grp?((c.participants||[]).find(p=>p.id!==PCW_ME)||{}).id:null;
    const online=otherId&&_online.has(otherId);
    return `<div class="pcw-conv-item ${active}" data-cid="${c.id}" onclick="pcwOpenConv(${c.id})">
      <div class="pcw-av-wrap">
        <div class="pcw-av ${grp?'pcw-av-g':''}" style="background:${col}">${ini}</div>
        ${online?'<span class="pcw-online-dot"></span>':''}
      </div>
      <div class="pcw-conv-meta">
        <div class="pcw-conv-name">${esc(name)}</div>
        <div class="pcw-conv-preview">${esc(preview)||'<em style="opacity:.35">No messages yet</em>'}</div>
      </div>
      <div class="pcw-conv-r">
        <span class="pcw-conv-time">${time}</span>
        ${unread?`<span class="pcw-unread-badge">${unread>99?'99+':unread}</span>`:''}
      </div>
    </div>`;
  }).join('');
}
window.pcwFilterConvs=q=>renderConvList(q);

/* ── open conversation ───────────────────────────────────────────────────── */
window.pcwOpenConv=async function(cid){
  _cid=cid;
  document.querySelectorAll('.pcw-conv-item').forEach(el=>el.classList.toggle('pcw-active',el.dataset.cid==cid));
  $('pcwPh').style.display='none';
  $('pcwThread').classList.add('pcw-show');
  if($('pcwWidget').offsetWidth<600){ $('pcwSb').style.display='none'; $('pcwBack').style.display='flex'; }
  const conv=_convs.find(c=>c.id===cid);
  if(conv) setThreadHeader(conv);
  // join socket room
  if(typeof portalSocket!=='undefined') portalSocket.emit('portal:conv:join',cid);
  // load messages
  $('pcwMsgs').innerHTML='<div class="pcw-spin">Loading…</div><div class="pcw-drop" id="pcwDrop"><i class="bi bi-cloud-upload-fill"></i><span>Drop files to send</span></div>';
  bindDrop(); bindScroll();
  await loadMsgs(cid,null,true);
  pcwCancelReply();
  setTimeout(()=>$('pcwInput').focus(),80);
};

function setThreadHeader(c){
  const name=convName(c), grp=c.type==='group';
  const col=aColor(name);
  const avWrap=$('pcwThAv').parentElement;
  avWrap.querySelectorAll('.pcw-online-dot').forEach(d=>d.remove());
  const av=$('pcwThAv');
  av.style.background=col; av.textContent=aInit(name);
  av.style.borderRadius=grp?'8px':'50%';
  const o=grp?null:(c.participants||[]).find(p=>p.id!==PCW_ME);
  const online=!grp&&o&&_online.has(o.id);
  if(online){ const d=document.createElement('span'); d.className='pcw-online-dot'; avWrap.appendChild(d); }
  $('pcwThName').textContent=name;
  if(grp){ $('pcwThSub').textContent=(c.participants||[]).length+' members'; }
  else{
    const role=(o?(o.role_name||'').replace('CLIENT_',''):'');
    $('pcwThSub').innerHTML=online?`<span style="color:#10b981">● Online</span>${role?' · '+role:''}`:role;
  }
}
window.pcwShowSb=()=>{ $('pcwSb').style.display=''; $('pcwBack').style.display='none'; };

/* ── messages loading ────────────────────────────────────────────────────── */
async function loadMsgs(cid,beforeId=null,fresh=false){
  try{
    let url=`/portal/chat/conversations/${cid}/messages`;
    if(beforeId) url+=`?before=${beforeId}`;
    const j=await api(url);
    const msgs=j.data.messages||[];
    _hasMore[cid]=msgs.length>=50;
    const el=$('pcwMsgs');
    if(fresh){
      el.innerHTML='<div class="pcw-drop" id="pcwDrop"><i class="bi bi-cloud-upload-fill"></i><span>Drop files to send</span></div>';
      bindDrop();
      if(_hasMore[cid]) el.insertAdjacentHTML('afterbegin','<div class="pcw-load-more" onclick="pcwLoadMore()">Load earlier messages</div>');
      renderMsgs(msgs,el);
      el.scrollTop=el.scrollHeight;
    }else{
      const prevH=el.scrollHeight, firstMsg=el.querySelector('.pcw-row');
      renderMsgsBefore(msgs,el,firstMsg);
      el.scrollTop=el.scrollHeight-prevH;
      if(!_hasMore[cid]){ const lm=el.querySelector('.pcw-load-more'); if(lm) lm.remove(); }
    }
    api(`/portal/chat/conversations/${cid}/read`,{method:'POST',headers:{'Content-Type':'application/json'}});
    const conv=_convs.find(c=>c.id===cid);
    if(conv){ conv.unread_count=0; renderConvList($('pcwSearch').value); updateBadge(); }
  }catch(e){ console.error('pcw msgs',e); }
}
window.pcwLoadMore=async function(){
  if(_loading||!_cid) return;
  const first=$('pcwMsgs').querySelector('.pcw-row'); if(!first) return;
  _loading=true; await loadMsgs(_cid,first.dataset.mid,false); _loading=false;
};

/* ── render ──────────────────────────────────────────────────────────────── */
function renderMsgs(msgs,container){
  let lastDate=null,lastSid=null,lastTs=null;
  const frag=document.createDocumentFragment();
  msgs.forEach(m=>{
    const ds=fDate(m.created_at);
    if(ds!==lastDate){ const d=document.createElement('div'); d.className='pcw-date-div'; d.innerHTML=`<span>${ds}</span>`; frag.appendChild(d); lastDate=ds; lastSid=null; lastTs=null; }
    const ts=new Date(m.created_at);
    const grp=lastSid===m.sender_id&&lastTs&&(ts-lastTs)<120000;
    const el=document.createElement('div'); el.innerHTML=msgHtml(m,grp); frag.appendChild(el.firstElementChild);
    lastSid=m.sender_id; lastTs=ts;
  });
  container.appendChild(frag);
}
function renderMsgsBefore(msgs,container,beforeEl){
  if(!msgs.length) return;
  let lastDate=null,lastSid=null,lastTs=null;
  const frag=document.createDocumentFragment();
  msgs.forEach(m=>{
    const ds=fDate(m.created_at);
    if(ds!==lastDate){ const d=document.createElement('div'); d.className='pcw-date-div'; d.innerHTML=`<span>${ds}</span>`; frag.appendChild(d); lastDate=ds; lastSid=null; lastTs=null; }
    const ts=new Date(m.created_at);
    const grp=lastSid===m.sender_id&&lastTs&&(ts-lastTs)<120000;
    const el=document.createElement('div'); el.innerHTML=msgHtml(m,grp); frag.appendChild(el.firstElementChild);
    lastSid=m.sender_id; lastTs=ts;
  });
  if(beforeEl) container.insertBefore(frag,beforeEl);
  else container.insertBefore(frag,container.querySelector('.pcw-drop'));
}

function msgHtml(m,grp){
  const mine=m.sender_id===PCW_ME;
  const col=aColor(m.sender_name||'?');
  const editedTag=m.is_edited?'<span class="pcw-edited-tag"> · edited</span>':'';

  // body
  let body='';
  if(m.is_deleted){ body='<span class="pcw-deleted">Message deleted</span>'; }
  else if(m.type==='file'&&m.attachment){ body=attachHtml(m); }
  else { body=renderContent(m.content||''); }

  // read tick (own messages)
  const tick=mine?(m.is_read?'<i class="bi bi-check2-all pcw-tick-read"></i>':'<i class="bi bi-check2 pcw-tick-sent"></i>'):'';

  return `<div class="pcw-row ${mine?'pcw-mine':''} ${grp?'pcw-grp':''}" data-mid="${m.id}">
    <div class="pcw-row-av" style="background:${col}">${aInit(m.sender_name||'?')}</div>
    <div class="pcw-row-body">
      <div class="pcw-row-sender">${esc(m.sender_name||'')}</div>
      <div class="pcw-bubble" data-mid="${m.id}" data-orig="${esc(m.content||'')}">
        ${body}${editedTag}
        <div class="pcw-acts">
          <button class="pcw-act" onclick="pcwReply(${m.id},'${esc(m.sender_name||'')}','${esc((m.content||'').slice(0,60).replace(/'/g,"\\'"))}')" title="Reply"><i class="bi bi-reply-fill"></i></button>
          ${mine&&!m.is_deleted&&m.type!=='file'?`<button class="pcw-act" onclick="pcwEditMsg(${m.id})" title="Edit"><i class="bi bi-pencil"></i></button>`:''}
          ${mine&&!m.is_deleted?`<button class="pcw-act danger" onclick="pcwDelMsg(${m.id})" title="Delete"><i class="bi bi-trash3"></i></button>`:''}
        </div>
      </div>
      <div class="pcw-row-foot">${fTime(m.created_at)} ${tick}</div>
    </div>
  </div>`;
}

function attachHtml(m){
  const a=m.attachment;
  const mime=a.mime_type||'', name=a.file_name||'File';
  const url=`/portal/chat/attachment/${m.id}`;
  const cap=m.content?renderContent(m.content)+'<br>':'';
  if(mime.startsWith('image/')){
    return `${cap}<img class="pcw-img" src="${url}" alt="${esc(name)}" onclick="window.open('${url}','_blank')" loading="lazy">`;
  }
  return `${cap}<a class="pcw-file" href="${url}" target="_blank" rel="noopener">
    <i class="${fIcon(mime)} pcw-file-icon"></i>
    <div class="pcw-file-info">
      <div class="pcw-file-name">${esc(name)}</div>
      ${a.file_size?`<div class="pcw-file-size">${fSize(a.file_size)}</div>`:''}
    </div>
  </a>`;
}

function renderContent(text){
  let out=esc(text);
  out=out.replace(/(https?:\/\/[^\s<>"&]+)/g,'<a href="$1" target="_blank" rel="noopener">$1</a>');
  out=out.replace(/@([\w][^\s@]{0,29})/g,'<span class="pcw-mention">@$1</span>');
  out=out.replace(/\n/g,'<br>');
  return out;
}

function appendMsg(m){
  const el=$('pcwMsgs');
  const tmp=document.createElement('div');
  tmp.innerHTML=msgHtml(m,false);
  el.appendChild(tmp.firstElementChild);
  el.scrollTop=el.scrollHeight;
}

/* ── send ────────────────────────────────────────────────────────────────── */
window.pcwSend=async function(){
  if(!_cid) return;
  const inp=$('pcwInput');
  const text=inp.innerText.trim();
  if(!text&&!_pending.length) return;
  inp.innerHTML=''; closeMention();

  for(const f of _pending){
    const isLast=_pending.indexOf(f)===_pending.length-1;
    await uploadFile(f,(isLast&&text)?text:null);
    if(isLast&&text){ clearPending(); return; }
  }
  clearPending();

  if(text){
    const url=_replyTo?`/portal/chat/conversations/${_cid}/messages`:`/portal/chat/conversations/${_cid}/messages`;
    const body={content:text};
    pcwCancelReply();
    try{
      const j=await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      if(j.data&&j.data.message){ appendMsg(j.data.message); updateConvPreview(_cid,j.data.message); }
    }catch(e){ console.error('pcw send',e); }
  }
};

/* ── file upload ─────────────────────────────────────────────────────────── */
window.pcwFileSelected=e=>{ _pending.push(...Array.from(e.target.files)); renderPending(); e.target.value=''; };
function renderPending(){
  const el=$('pcwPendFiles');
  if(!_pending.length){ el.classList.remove('pcw-show'); el.innerHTML=''; return; }
  el.classList.add('pcw-show');
  el.innerHTML=_pending.map((f,i)=>`<div class="pcw-pend-file"><i class="${fIcon(f.type)}"></i><span>${esc(f.name)}</span><button class="pcw-pend-rm" onclick="pcwRmPend(${i})"><i class="bi bi-x"></i></button></div>`).join('');
}
function clearPending(){ _pending=[]; renderPending(); }
window.pcwRmPend=i=>{ _pending.splice(i,1); renderPending(); };
async function uploadFile(file,caption){
  const fd=new FormData(); fd.append('file',file);
  if(caption) fd.append('content',caption);
  try{
    const j=await api(`/portal/chat/conversations/${_cid}/file`,{method:'POST',headers:{},body:fd});
    if(j.data&&j.data.message){ appendMsg(j.data.message); updateConvPreview(_cid,j.data.message); }
  }catch(e){ console.error('pcw upload',e); }
}

/* ── drag & drop ─────────────────────────────────────────────────────────── */
function bindDrop(){
  const el=$('pcwMsgs'), dz=$('pcwDrop'); if(!el||!dz) return;
  el.addEventListener('dragenter',e=>{ e.preventDefault(); _dragN++; if(_cid) dz.classList.add('pcw-dropping'); });
  el.addEventListener('dragleave',()=>{ _dragN--; if(_dragN<=0){ _dragN=0; $('pcwDrop')&&$('pcwDrop').classList.remove('pcw-dropping'); } });
  el.addEventListener('dragover',e=>e.preventDefault());
  el.addEventListener('drop',e=>{
    e.preventDefault(); _dragN=0; $('pcwDrop')&&$('pcwDrop').classList.remove('pcw-dropping');
    if(!_cid) return;
    _pending.push(...Array.from(e.dataTransfer.files)); renderPending();
  });
}

/* ── paste images ────────────────────────────────────────────────────────── */
window.pcwPaste=e=>{
  const items=e.clipboardData&&e.clipboardData.items; if(!items) return;
  for(const it of items){
    if(it.kind==='file'&&it.type.startsWith('image/')){ e.preventDefault(); const f=it.getAsFile(); if(f){ _pending.push(f); renderPending(); } }
  }
};

/* ── reply ───────────────────────────────────────────────────────────────── */
window.pcwReply=(id,sender,preview)=>{
  _replyTo={id,sender};
  $('pcwReplyBar').classList.add('pcw-show');
  $('pcwReplyText').innerHTML=`<strong>${esc(sender)}</strong> — ${esc(preview)}`;
  $('pcwInput').focus();
};
window.pcwCancelReply=()=>{ _replyTo=null; $('pcwReplyBar').classList.remove('pcw-show'); };

/* ── edit message ────────────────────────────────────────────────────────── */
window.pcwEditMsg=(msgId)=>{
  if(_editMsgId) pcwCancelEdit();
  const bubble=document.querySelector(`.pcw-bubble[data-mid="${msgId}"]`);
  if(!bubble||bubble.classList.contains('pcw-editing')) return;
  _editMsgId=msgId; _editOrig=bubble.dataset.orig||'';
  _editActsHtml=bubble.querySelector('.pcw-acts')?.outerHTML||'';
  bubble.classList.add('pcw-editing');
  bubble.innerHTML=`<textarea class="pcw-edit-ta" onkeydown="pcwEditKey(event)"></textarea>
    <div class="pcw-edit-btns">
      <button class="pcw-edit-save" onclick="pcwSaveEdit()">Save</button>
      <button class="pcw-edit-cancel" onclick="pcwCancelEdit()">Cancel</button>
    </div>${_editActsHtml}`;
  const ta=bubble.querySelector('.pcw-edit-ta');
  ta.value=_editOrig; ta.style.height=Math.min(ta.scrollHeight,100)+'px';
  ta.focus(); ta.selectionStart=ta.selectionEnd=ta.value.length;
};
window.pcwEditKey=e=>{
  if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); pcwSaveEdit(); }
  if(e.key==='Escape') pcwCancelEdit();
};
window.pcwSaveEdit=async()=>{
  if(!_editMsgId) return;
  const bubble=document.querySelector(`.pcw-bubble[data-mid="${_editMsgId}"]`); if(!bubble) return;
  const ta=bubble.querySelector('.pcw-edit-ta');
  const newText=ta?.value.trim();
  if(!newText||newText===_editOrig){ pcwCancelEdit(); return; }
  const mid=_editMsgId, origText=_editOrig, actsHtml=_editActsHtml;
  _editMsgId=null; _editOrig=''; _editActsHtml='';
  bubble.classList.remove('pcw-editing');
  try{
    const j=await api(`/portal/chat/messages/${mid}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({content:newText})});
    if(j.data||j.success){ bubble.dataset.orig=newText; bubble.innerHTML=renderContent(newText)+'<span class="pcw-edited-tag"> · edited</span>'+actsHtml; }
    else { bubble.dataset.orig=origText; bubble.innerHTML=renderContent(origText)+actsHtml; }
  }catch(e){ bubble.dataset.orig=origText; bubble.innerHTML=renderContent(origText)+actsHtml; }
};
window.pcwCancelEdit=()=>{
  if(!_editMsgId) return;
  const bubble=document.querySelector(`.pcw-bubble[data-mid="${_editMsgId}"]`);
  if(bubble){ bubble.classList.remove('pcw-editing'); bubble.innerHTML=renderContent(_editOrig)+_editActsHtml; }
  _editMsgId=null; _editOrig=''; _editActsHtml='';
};

/* ── delete message ──────────────────────────────────────────────────────── */
window.pcwDelMsg=async(msgId)=>{
  if(!confirm('Delete this message?')) return;
  try{
    await api(`/portal/chat/messages/${msgId}`,{method:'DELETE'});
    const b=document.querySelector(`.pcw-bubble[data-mid="${msgId}"]`);
    if(b){ const actsHtml=b.querySelector('.pcw-acts')?.outerHTML||''; b.innerHTML='<span class="pcw-deleted">Message deleted</span>'+actsHtml; }
  }catch(e){}
};

/* ── @mention (group chats only) ─────────────────────────────────────────── */
window.pcwInputChange=()=>{ handleMention(); pcwTyping(); };
function handleMention(){
  const conv=_convs.find(c=>c.id===_cid);
  if(!conv||conv.type!=='group'){ closeMention(); return; }
  const sel=window.getSelection(); if(!sel.rangeCount) return;
  const rng=sel.getRangeAt(0), node=rng.startContainer;
  if(node.nodeType!==Node.TEXT_NODE){ closeMention(); return; }
  const txt=node.textContent, pos=rng.startOffset, before=txt.slice(0,pos);
  const atIdx=before.lastIndexOf('@');
  if(atIdx!==-1&&(atIdx===0||/\s/.test(before[atIdx-1]))){
    const q=before.slice(atIdx+1);
    if(!q.includes(' ')&&q.length<=20){ showMentionDd(q); return; }
  }
  closeMention();
}
function showMentionDd(q){
  const dd=$('pcwMentionDd');
  const list=_users.filter(u=>u.name.toLowerCase().includes(q.toLowerCase())).slice(0,7);
  if(!list.length){ closeMention(); return; }
  _mentionIdx=Math.min(_mentionIdx,list.length-1);
  dd.innerHTML=list.map((u,i)=>`<div class="pcw-mitem ${i===_mentionIdx?'pcw-msel':''}" onmousedown="pcwPickMention('${esc(u.name)}')" data-i="${i}">
    <div class="pcw-av" style="background:${aColor(u.name)};width:22px;height:22px;font-size:.52rem">${aInit(u.name)}</div>
    <div><div>${esc(u.name)}</div><div class="pcw-mitem-role">${esc((u.role_name||'').replace('CLIENT_',''))}</div></div>
  </div>`).join('');
  dd.classList.add('pcw-show');
}
window.pcwPickMention=name=>{
  const sel=window.getSelection(); if(!sel.rangeCount) return;
  const rng=sel.getRangeAt(0), node=rng.startContainer;
  if(node.nodeType!==Node.TEXT_NODE){ closeMention(); return; }
  const txt=node.textContent, pos=rng.startOffset, before=txt.slice(0,pos);
  const atIdx=before.lastIndexOf('@');
  if(atIdx!==-1){ node.textContent=txt.slice(0,atIdx)+'@'+name+' '+txt.slice(pos); const nr=document.createRange(); nr.setStart(node,atIdx+name.length+2); nr.collapse(true); sel.removeAllRanges(); sel.addRange(nr); }
  closeMention();
};
function closeMention(){ _mentionOn=false; _mentionIdx=0; $('pcwMentionDd').classList.remove('pcw-show'); }
window.pcwKeydown=e=>{
  if(_mentionOn){
    const items=$('pcwMentionDd').querySelectorAll('.pcw-mitem');
    if(e.key==='ArrowDown'){ e.preventDefault(); _mentionIdx=Math.min(_mentionIdx+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('pcw-msel',i===_mentionIdx)); return; }
    if(e.key==='ArrowUp'){ e.preventDefault(); _mentionIdx=Math.max(_mentionIdx-1,0); items.forEach((el,i)=>el.classList.toggle('pcw-msel',i===_mentionIdx)); return; }
    if(e.key==='Enter'||e.key==='Tab'){ e.preventDefault(); const a=$('pcwMentionDd').querySelector('.pcw-msel'); if(a) a.dispatchEvent(new MouseEvent('mousedown')); return; }
    if(e.key==='Escape'){ closeMention(); return; }
  }
  if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); pcwSend(); }
};

/* ── scroll-to-bottom ────────────────────────────────────────────────────── */
function bindScroll(){
  const el=$('pcwMsgs'); if(!el) return;
  el.addEventListener('scroll',()=>{
    const btn=$('pcwScrollBtn'); if(!btn) return;
    btn.style.display=(el.scrollHeight-el.scrollTop-el.clientHeight<60)?'none':'flex';
  },{passive:true});
}
window.pcwScrollBottom=()=>{ const el=$('pcwMsgs'); if(el) el.scrollTo({top:el.scrollHeight,behavior:'smooth'}); const b=$('pcwScrollBtn'); if(b) b.style.display='none'; };

/* ── typing indicator ────────────────────────────────────────────────────── */
window.pcwTyping=()=>{
  if(!_cid||typeof portalSocket==='undefined') return;
  portalSocket.emit('portal:typing',{conversation_id:_cid});
};
function showTyping(name){
  const el=$('pcwMsgs');
  let t=el.querySelector('.pcw-typing');
  if(!t){ t=document.createElement('div'); t.className='pcw-typing'; t.innerHTML=`<div class="pcw-dot"></div><div class="pcw-dot"></div><div class="pcw-dot"></div><span style="margin-left:4px">${esc(name)} is typing</span>`; el.appendChild(t); el.scrollTop=el.scrollHeight; }
  clearTimeout(t._t); t._t=setTimeout(()=>t.remove(),3500);
}

/* ── notification sound ──────────────────────────────────────────────────── */
function playSound(){
  if(!_soundOn) return;
  try{
    if(!_audioCtx) _audioCtx=new(window.AudioContext||window.webkitAudioContext)();
    if(_audioCtx.state==='suspended') _audioCtx.resume();
    const osc=_audioCtx.createOscillator(), gain=_audioCtx.createGain();
    osc.connect(gain); gain.connect(_audioCtx.destination);
    osc.type='sine';
    osc.frequency.setValueAtTime(880,_audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(440,_audioCtx.currentTime+0.15);
    gain.gain.setValueAtTime(0.14,_audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001,_audioCtx.currentTime+0.32);
    osc.start(_audioCtx.currentTime); osc.stop(_audioCtx.currentTime+0.32);
  }catch(_){}
}
window.pcwToggleSound=()=>{
  _soundOn=!_soundOn;
  localStorage.setItem('pcw-sound',_soundOn?'1':'0');
  const icon=$('pcwSoundIcon'); if(icon) icon.className=_soundOn?'bi bi-volume-up-fill':'bi bi-volume-mute-fill';
  const btn=$('pcwSoundBtn'); if(btn){ btn.style.color=_soundOn?'':'#4b5563'; btn.title=_soundOn?'Mute notification sound':'Unmute notification sound'; }
};
(()=>{ const icon=$('pcwSoundIcon'); if(icon&&!_soundOn) icon.className='bi bi-volume-mute-fill'; const btn=$('pcwSoundBtn'); if(btn&&!_soundOn){ btn.style.color='#4b5563'; btn.title='Unmute notification sound'; } })();

/* ── socket listeners ────────────────────────────────────────────────────── */
if(typeof portalSocket!=='undefined'){

  // New message on personal room (fires for all conversations)
  portalSocket.on('portal:notify',(msg)=>{
    const cid=msg.conversation_id;
    updateConvPreview(cid,msg,true);
    updateBadge();
    if(_cid===cid&&_open&&!_min){
      appendMsg(msg);
      api(`/portal/chat/conversations/${cid}/read`,{method:'POST',headers:{'Content-Type':'application/json'}});
    } else {
      playSound();
    }
  });

  // Message in an open conversation room
  portalSocket.on('portal:message',(msg)=>{
    if(msg.conversation_id!==_cid||!_open||_min) return;
    // Avoid double-render if portal:notify already handled it
    const exists=$('pcwMsgs').querySelector(`[data-mid="${msg.id}"]`);
    if(!exists) appendMsg(msg);
  });

  // Live edit
  portalSocket.on('portal:message:edit',(data)=>{
    const m=data.message||data;
    if(_editMsgId===m.id) return;
    const bubble=document.querySelector(`.pcw-bubble[data-mid="${m.id}"]`); if(!bubble) return;
    bubble.dataset.orig=m.content||'';
    const actsHtml=bubble.querySelector('.pcw-acts')?.outerHTML||'';
    bubble.innerHTML=renderContent(m.content||'')+'<span class="pcw-edited-tag"> · edited</span>'+actsHtml;
  });

  // Live delete
  portalSocket.on('portal:message:delete',(data)=>{
    const msgId=data.message_id||data.id;
    const bubble=document.querySelector(`.pcw-bubble[data-mid="${msgId}"]`); if(!bubble) return;
    const actsHtml=bubble.querySelector('.pcw-acts')?.outerHTML||'';
    bubble.innerHTML='<span class="pcw-deleted">Message deleted</span>'+actsHtml;
  });

  // Typing
  portalSocket.on('portal:typing',(d)=>{
    if(d.conversation_id!==_cid||d.user_id===PCW_ME) return;
    showTyping(d.user_name||'Someone');
  });

  // Presence
  portalSocket.on('portal:presence',(d)=>{
    if(d.status==='online') _online.add(d.user_id); else _online.delete(d.user_id);
    renderConvList($('pcwSearch').value);
    if(_cid){ const conv=_convs.find(c=>c.id===_cid); if(conv&&conv.type==='direct'){ const o=(conv.participants||[]).find(p=>p.id!==PCW_ME); if(o&&o.id===d.user_id) setThreadHeader(conv); } }
  });
}

/* ── update conv preview ─────────────────────────────────────────────────── */
function updateConvPreview(cid,msg,incUnread=false){
  const c=_convs.find(x=>x.id===cid);
  if(c){ c.last_message=msg.content||(msg.type==='file'?'[File]':''); c.last_message_at=msg.created_at; if(incUnread&&cid!==_cid) c.unread_count=(c.unread_count||0)+1; const idx=_convs.indexOf(c); if(idx>0){ _convs.splice(idx,1); _convs.unshift(c); } renderConvList($('pcwSearch').value); }
  else { loadConvs(); }
}

function updateBadge(){
  const total=_convs.reduce((s,c)=>s+(c.unread_count||0),0);
  const b1=$('pcwFabBadge'), b2=$('pcwHdrBadge');
  [b1,b2].forEach(b=>{ if(!b) return; b.textContent=total>99?'99+':total; b.style.display=total?'':'none'; });
}

/* ── new chat modal ──────────────────────────────────────────────────────── */
window.pcwNewChat=async()=>{
  if(!_users.length) await loadUsers();
  renderUserList();
  $('pcwOverlay').classList.add('pcw-show');
  $('pcwModal').classList.add('pcw-show');
  setTimeout(()=>$('pcwUSearch').focus(),80);
};
window.pcwCloseModal=()=>{ $('pcwOverlay').classList.remove('pcw-show'); $('pcwModal').classList.remove('pcw-show'); };
function renderUserList(q=''){
  const el=$('pcwUList');
  let list=_users;
  if(q){ const lq=q.toLowerCase(); list=list.filter(u=>u.name.toLowerCase().includes(lq)); }
  if(!list.length){ el.innerHTML='<div class="pcw-empty">No users found</div>'; return; }
  el.innerHTML=list.map(u=>`<div class="pcw-uitem" onclick="pcwStartChat(${u.id})">
    <div class="pcw-av" style="background:${aColor(u.name)};width:32px;height:32px;font-size:.64rem">${aInit(u.name)}</div>
    <div><div class="pcw-uitem-name">${esc(u.name)}</div><div class="pcw-uitem-role">${esc((u.role_name||'').replace('CLIENT_',''))}</div></div>
  </div>`).join('');
}
window.pcwFilterUsers=q=>renderUserList(q);
window.pcwStartChat=async uid=>{
  pcwCloseModal();
  try{
    const j=await api('/portal/chat/conversations',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'direct',participant_ids:[uid]})});
    if(j.data&&j.data.conversation_id){ await loadConvs(); pcwOpenConv(j.data.conversation_id); }
  }catch(e){ console.error('pcw start',e); }
};

/* ── init: load unread count for fab badge ───────────────────────────────── */
(async()=>{
  try{
    const j=await api('/portal/chat/unread-count');
    const n=j.data&&j.data.count?j.data.count:0;
    const b=$('pcwFabBadge'); if(b&&n){ b.textContent=n>99?'99+':n; b.style.display=''; }
  }catch(e){}
})();

})();
</script>
