<style>
@keyframes pwsFadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
.pws-wrap { max-width:900px; margin:0 auto; animation:pwsFadeIn 0.2s ease; padding-bottom:40px; }

/* ── Header ───────────────────────────────────────────────── */
.pws-header { margin-bottom:24px; }
.pws-pill {
  display:inline-flex; align-items:center; gap:5px;
  background:rgba(99,102,241,0.1); border:1px solid rgba(99,102,241,0.25);
  color:#6366f1; border-radius:20px; padding:3px 10px;
  font-size:0.68rem; font-weight:700; letter-spacing:0.3px; margin-bottom:6px;
}
.pws-title { font-size:1.3rem; font-weight:700; color:var(--portal-text,#e2e8f0); }
.pws-sub   { font-size:0.8rem; color:var(--portal-muted,#64748b); margin-top:3px; }

/* ── Filter bar ───────────────────────────────────────────── */
.pws-filter-bar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px; }
.pws-filter-btn {
  padding:5px 14px; border-radius:20px; font-size:0.75rem; font-weight:600; cursor:pointer;
  border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05); color:rgba(255,255,255,0.5);
  transition:all 0.15s;
}
.pws-filter-btn.active { background:rgba(99,102,241,0.15); border-color:rgba(99,102,241,0.4); color:#6366f1; }

/* ── Project cards ────────────────────────────────────────── */
.pws-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; }
.pws-card {
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08);
  border-radius:14px; padding:18px; cursor:pointer; transition:all 0.2s;
}
.pws-card:hover { border-color:rgba(99,102,241,0.4); background:rgba(99,102,241,0.05); transform:translateY(-1px); }
.pws-card.open  { border-color:#6366f1; background:rgba(99,102,241,0.08); }
.pws-card-top { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:6px; }
.pws-card-title { font-weight:700; font-size:0.9rem; color:#e2e8f0; }
.pws-status {
  font-size:0.6rem; font-weight:700; padding:2px 8px; border-radius:5px;
  text-transform:uppercase; letter-spacing:0.3px; flex-shrink:0;
}
.pws-s-planning  { background:rgba(100,116,139,0.2); color:#94a3b8; }
.pws-s-active    { background:rgba(16,185,129,0.15);  color:#10b981; }
.pws-s-on_hold   { background:rgba(245,158,11,0.15);  color:#f59e0b; }
.pws-s-completed { background:rgba(99,102,241,0.15);  color:#a5b4fc; }
.pws-card-dev { font-size:0.72rem; color:rgba(255,255,255,0.35); margin-bottom:10px; }
.pws-prog-row { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
.pws-prog-bar { flex:1; height:5px; border-radius:3px; background:rgba(255,255,255,0.08); overflow:hidden; }
.pws-prog-fill{ height:100%; border-radius:3px; background:#6366f1; transition:width 0.4s; }
.pws-prog-pct { font-size:0.7rem; color:#6366f1; font-weight:700; min-width:30px; text-align:right; }
.pws-tech-row { display:flex; flex-wrap:wrap; gap:5px; }
.pws-tech-chip { font-size:0.62rem; padding:2px 7px; border-radius:4px; background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.4); border:1px solid rgba(255,255,255,0.08); }

/* ── Task drawer ──────────────────────────────────────────── */
.pws-drawer {
  position:fixed; right:0; top:0; bottom:0; width:420px; max-width:92vw;
  background:#1a1f2e; border-left:1px solid rgba(255,255,255,0.08);
  z-index:200; display:flex; flex-direction:column;
  transform:translateX(100%); transition:transform 0.25s ease;
}
.pws-drawer.visible { transform:translateX(0); }
.pws-drawer-head {
  padding:18px 20px 0; border-bottom:1px solid rgba(255,255,255,0.08); flex-shrink:0;
}
.pws-drawer-head-row {
  display:flex; align-items:flex-start; gap:10px; margin-bottom:12px;
}
.pws-drawer-close {
  background:none; border:none; color:rgba(255,255,255,0.4); cursor:pointer; font-size:1.1rem;
  padding:2px; line-height:1; flex-shrink:0; transition:color 0.15s;
}
.pws-drawer-close:hover { color:#fff; }
.pws-drawer-title { font-weight:700; font-size:1rem; color:#e2e8f0; line-height:1.3; }
.pws-drawer-dev   { font-size:0.72rem; color:rgba(255,255,255,0.35); margin-top:3px; }

/* ── Drawer tab bar ───────────────────────────────────────── */
.pws-dtab-bar { display:flex; gap:0; }
.pws-dtab {
  padding:8px 14px; font-size:0.73rem; font-weight:600; cursor:pointer;
  color:rgba(255,255,255,0.35); border-bottom:2px solid transparent;
  transition:all 0.15s; white-space:nowrap;
}
.pws-dtab:hover { color:rgba(255,255,255,0.65); }
.pws-dtab.active { color:#6366f1; border-bottom-color:#6366f1; }

.pws-drawer-body { flex:1; overflow-y:auto; padding:16px 20px; display:flex; flex-direction:column; gap:14px; }

/* ── Drawer overview content ──────────────────────────────── */
.pws-summary-row { display:flex; gap:10px; }
.pws-summary-tile {
  flex:1; padding:10px 12px; border-radius:10px;
  background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.06);
}
.pws-summary-val  { font-size:1.3rem; font-weight:700; color:#6366f1; font-family:monospace; }
.pws-summary-lbl  { font-size:0.65rem; color:rgba(255,255,255,0.35); text-transform:uppercase; letter-spacing:0.3px; margin-top:2px; }
.pws-desc { font-size:0.8rem; color:rgba(255,255,255,0.5); line-height:1.55; }
.pws-section-label { font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; color:rgba(255,255,255,0.3); margin-bottom:8px; }
.pws-task-row {
  display:flex; align-items:center; gap:8px; padding:8px 10px;
  border-radius:8px; border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.03);
  margin-bottom:5px;
}
.pws-task-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
.pws-task-text { font-size:0.8rem; color:#cbd5e1; flex:1; }
.pws-task-text.done { text-decoration:line-through; color:rgba(255,255,255,0.3); }
.pws-task-status { font-size:0.62rem; color:rgba(255,255,255,0.3); white-space:nowrap; }

/* ── Updates tab ──────────────────────────────────────────── */
.pws-update-item {
  display:flex; gap:10px; padding-bottom:14px;
  border-bottom:1px solid rgba(255,255,255,0.05);
}
.pws-update-item:last-child { border-bottom:none; padding-bottom:0; }
.pws-update-avatar {
  width:30px; height:30px; border-radius:50%; background:rgba(99,102,241,0.2);
  color:#a5b4fc; font-size:0.65rem; font-weight:700; display:flex; align-items:center;
  justify-content:center; flex-shrink:0; text-transform:uppercase;
}
.pws-update-meta { font-size:0.68rem; color:rgba(255,255,255,0.35); margin-bottom:4px; }
.pws-update-body { font-size:0.8rem; color:rgba(255,255,255,0.65); line-height:1.5; white-space:pre-wrap; word-break:break-word; }

/* ── Releases tab ─────────────────────────────────────────── */
.pws-release-item {
  padding:12px 14px; border-radius:10px;
  border:1px solid rgba(255,255,255,0.06); background:rgba(255,255,255,0.03);
}
.pws-release-top { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
.pws-release-version { font-weight:700; font-size:0.88rem; color:#e2e8f0; font-family:monospace; }
.pws-release-env {
  font-size:0.6rem; font-weight:700; padding:2px 7px; border-radius:4px;
  text-transform:uppercase; letter-spacing:0.3px;
}
.pws-env-development { background:rgba(100,116,139,0.2); color:#94a3b8; }
.pws-env-staging     { background:rgba(245,158,11,0.15);  color:#f59e0b; }
.pws-env-production  { background:rgba(16,185,129,0.15);  color:#10b981; }
.pws-release-meta { font-size:0.68rem; color:rgba(255,255,255,0.35); margin-bottom:6px; }
.pws-release-notes { font-size:0.78rem; color:rgba(255,255,255,0.5); line-height:1.5; }

/* Loading / empty */
.pws-spinner-wrap { display:flex; justify-content:center; padding:40px 0; }
.pws-spinner { width:26px; height:26px; border-radius:50%; border:3px solid rgba(255,255,255,0.1); border-top-color:#6366f1; animation:pwsSpin 0.7s linear infinite; }
@keyframes pwsSpin { to { transform:rotate(360deg); } }
.pws-empty { text-align:center; padding:60px 20px; color:rgba(255,255,255,0.3); }
.pws-empty i { font-size:2.5rem; opacity:0.3; display:block; margin-bottom:10px; }
.pws-tab-empty { text-align:center; padding:30px 10px; color:rgba(255,255,255,0.3); font-size:0.8rem; }

/* ── Main section tabs (Projects / Thoughts) ──────────────────── */
.pws-main-tab-bar { display:flex; gap:6px; margin-bottom:16px; }
.pws-main-tab {
  padding:6px 16px; border-radius:20px; font-size:0.75rem; font-weight:600; cursor:pointer;
  border:1px solid rgba(255,255,255,0.1); background:rgba(255,255,255,0.05); color:rgba(255,255,255,0.45);
  transition:all 0.15s;
}
.pws-main-tab:hover { color:rgba(255,255,255,0.75); }
.pws-main-tab.active { background:rgba(99,102,241,0.15); border-color:rgba(99,102,241,0.4); color:#6366f1; }

/* ── Thoughts section ─────────────────────────────────────────── */
.pws-thought-wrap { max-width:900px; margin:0 auto; padding-bottom:40px; }
.pws-thought-form {
  background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08);
  border-radius:14px; padding:16px 18px; margin-bottom:20px;
}
.pws-thought-form-label { font-size:0.7rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; color:rgba(255,255,255,0.35); margin-bottom:10px; }
.pws-thought-input {
  width:100%; padding:8px 11px; border-radius:9px; border:1px solid rgba(255,255,255,0.1);
  background:rgba(255,255,255,0.05); color:#e2e8f0; font-size:0.85rem; margin-bottom:8px;
  box-sizing:border-box; font-family:inherit;
}
.pws-thought-input:focus { outline:none; border-color:rgba(99,102,241,0.5); }
.pws-thought-textarea {
  width:100%; padding:8px 11px; border-radius:9px; border:1px solid rgba(255,255,255,0.1);
  background:rgba(255,255,255,0.05); color:#e2e8f0; font-size:0.82rem; resize:vertical;
  font-family:inherit; margin-bottom:8px; box-sizing:border-box; min-height:80px;
}
.pws-thought-textarea:focus { outline:none; border-color:rgba(99,102,241,0.5); }
.pws-thought-form-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
.pws-attach-btn {
  display:inline-flex; align-items:center; gap:4px; font-size:0.72rem; font-weight:600;
  color:rgba(255,255,255,0.45); border:1px solid rgba(255,255,255,0.1); border-radius:7px;
  padding:4px 10px; cursor:pointer; transition:all 0.15s;
}
.pws-attach-btn:hover { color:rgba(255,255,255,0.75); border-color:rgba(255,255,255,0.2); }
.pws-attach-label { font-size:0.7rem; color:rgba(99,102,241,0.8); flex:1; min-width:0; }
.pws-thought-post-btn {
  padding:6px 15px; border-radius:8px; font-size:0.75rem; font-weight:600; cursor:pointer;
  background:#6366f1; border:none; color:#fff; transition:background 0.15s; margin-left:auto;
}
.pws-thought-post-btn:hover { background:#4f46e5; }

.pws-thought-card {
  background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.07);
  border-radius:12px; padding:14px 16px; margin-bottom:10px; cursor:pointer; transition:all 0.2s;
}
.pws-thought-card:hover { border-color:rgba(99,102,241,0.3); background:rgba(99,102,241,0.04); transform:translateY(-1px); }
.pws-thought-card.open  { border-color:#6366f1; background:rgba(99,102,241,0.07); }
.pws-thought-card-top   { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:4px; }
.pws-thought-title       { font-weight:700; font-size:0.88rem; color:#e2e8f0; line-height:1.3; }
.pws-thought-meta        { font-size:0.67rem; color:rgba(255,255,255,0.3); display:flex; gap:10px; margin-top:3px; }
.pws-att-chip {
  display:inline-flex; align-items:center; gap:4px; font-size:0.7rem; font-weight:500;
  color:rgba(255,255,255,0.55); border:1px solid rgba(255,255,255,0.1); border-radius:6px;
  padding:2px 8px; text-decoration:none; transition:all 0.15s;
}
.pws-att-chip:hover { color:#fff; border-color:rgba(255,255,255,0.3); }
.pws-comment-area textarea {
  width:100%; padding:7px 10px; border-radius:8px; border:1px solid rgba(255,255,255,0.1);
  background:rgba(255,255,255,0.05); color:#e2e8f0; font-size:0.8rem; font-family:inherit;
  resize:vertical; min-height:58px; box-sizing:border-box;
}
.pws-comment-area textarea:focus { outline:none; border-color:rgba(99,102,241,0.4); }
</style>

<!-- Main section tab bar -->
<div class="pws-main-tab-bar">
  <button class="pws-main-tab active" id="pwsTabProjects" onclick="pwsSwitchMain('projects')"><i class="bi bi-folder2-open" style="margin-right:4px"></i>Projects</button>
  <button class="pws-main-tab" id="pwsTabThoughts" onclick="pwsSwitchMain('thoughts')"><i class="bi bi-lightbulb-fill" style="margin-right:4px"></i>Thoughts</button>
</div>

<div class="pws-wrap" id="pwsSectProjects">

  <div class="pws-header">
    <div class="pws-pill"><i class="bi bi-code-slash"></i> Dev Workspace</div>
    <div class="pws-title">Development Projects</div>
    <div class="pws-sub">Live progress from the development team — click any project to see details</div>
  </div>

  <div class="pws-filter-bar" id="pwsFilters">
    <button class="pws-filter-btn active" data-status="" onclick="pwsFilter(this,'')">All</button>
    <button class="pws-filter-btn" data-status="active"    onclick="pwsFilter(this,'active')">Active</button>
    <button class="pws-filter-btn" data-status="planning"  onclick="pwsFilter(this,'planning')">Planning</button>
    <button class="pws-filter-btn" data-status="on_hold"   onclick="pwsFilter(this,'on_hold')">On Hold</button>
    <button class="pws-filter-btn" data-status="completed" onclick="pwsFilter(this,'completed')">Completed</button>
  </div>

  <div id="pwsGrid">
    <div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>
  </div>

</div>

<!-- Thoughts section -->
<div id="pwsSectThoughts" style="display:none">
  <div class="pws-thought-wrap">

    <div class="pws-header">
      <div class="pws-pill"><i class="bi bi-lightbulb-fill"></i> Thoughts</div>
      <div class="pws-title">Share a Thought</div>
      <div class="pws-sub">Post ideas, concerns, or feedback for the development team to read and discuss</div>
    </div>

    <!-- Post form -->
    <div class="pws-thought-form">
      <div class="pws-thought-form-label"><i class="bi bi-pencil-square" style="margin-right:4px"></i>New Thought</div>
      <input  type="text"    class="pws-thought-input"    id="pwsThoughtTitle" placeholder="Title / subject...">
      <textarea              class="pws-thought-textarea" id="pwsThoughtBody"  placeholder="Share your thoughts, ideas, or concerns with the dev team..."></textarea>
      <div class="pws-thought-form-row">
        <label for="pwsThoughtFiles" class="pws-attach-btn"><i class="bi bi-paperclip"></i> Attach files (up to 5)</label>
        <input type="file" id="pwsThoughtFiles" multiple style="display:none" onchange="pwsUpdateFileLabel(this,'pwsThoughtFileLabel')">
        <span class="pws-attach-label" id="pwsThoughtFileLabel"></span>
        <button class="pws-thought-post-btn" onclick="pwsPostThought()"><i class="bi bi-send"></i> Post</button>
      </div>
    </div>

    <!-- Thought list -->
    <div id="pwsThoughtListEl">
      <div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>
    </div>

  </div>
</div>

<!-- Thoughts detail drawer (separate from project drawer) -->
<div class="pws-drawer" id="pwsThoughtDrawer">
  <div class="pws-drawer-head">
    <div class="pws-drawer-head-row">
      <div style="flex:1;min-width:0">
        <div class="pws-drawer-title" id="pwsTDrawerTitle">—</div>
        <div class="pws-drawer-dev"   id="pwsTDrawerMeta"></div>
      </div>
      <button class="pws-drawer-close" onclick="pwsCloseThoughtDrawer()"><i class="bi bi-x-lg"></i></button>
    </div>
  </div>
  <div class="pws-drawer-body" id="pwsTDrawerBody">
    <div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>
  </div>
</div>

<!-- Drawer -->
<div class="pws-drawer" id="pwsDrawer">
  <div class="pws-drawer-head">
    <div class="pws-drawer-head-row">
      <div style="flex:1;min-width:0">
        <div class="pws-drawer-title" id="pwsDrawerTitle">—</div>
        <div class="pws-drawer-dev" id="pwsDrawerDev"></div>
      </div>
      <button class="pws-drawer-close" onclick="pwsCloseDrawer()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="pws-dtab-bar" id="pwsDtabBar">
      <div class="pws-dtab active" data-tab="overview" onclick="pwsSwitchTab('overview')"><i class="bi bi-grid-1x2" style="margin-right:4px"></i>Overview</div>
      <div class="pws-dtab" data-tab="updates"  onclick="pwsSwitchTab('updates')"><i class="bi bi-megaphone" style="margin-right:4px"></i>Updates</div>
      <div class="pws-dtab" data-tab="releases" onclick="pwsSwitchTab('releases')"><i class="bi bi-rocket-takeoff" style="margin-right:4px"></i>Releases</div>
    </div>
  </div>
  <div class="pws-drawer-body" id="pwsDrawerBody">
    <div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>
  </div>
</div>

<script>
(function () {
  var _projects    = [];
  var _filter      = '';
  var _activeCard  = null;
  var _activeProject = null;
  var _activeTab   = 'overview';
  var _tabCache    = {};  // { projectId: { overview: html, updates: html, releases: html } }

  var STATUS_LABELS = { planning:'Planning', active:'Active', on_hold:'On Hold', completed:'Completed' };
  var TASK_STATUS_COLORS = { todo:'#475569', in_progress:'#f59e0b', done:'#10b981' };
  var TASK_STATUS_LABELS = { todo:'To Do', in_progress:'In Progress', done:'Done' };
  var ENV_LABELS = { development:'Development', staging:'Staging', production:'Production' };

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function fmtDate(str) {
    if (!str) return '—';
    var d = new Date(str);
    return d.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });
  }

  function initials(name) {
    return (name||'?').split(' ').slice(0,2).map(function(w){return w[0];}).join('').toUpperCase();
  }

  function load() {
    fetch('/portal/workspace/projects')
      .then(function(r){return r.json();})
      .then(function(res){
        _projects = res.success ? res.data : [];
        renderGrid();
      })
      .catch(function(){
        document.getElementById('pwsGrid').innerHTML = '<div class="pws-empty">Failed to load projects</div>';
      });
  }

  function renderGrid() {
    var list = _filter ? _projects.filter(function(p){return p.status===_filter;}) : _projects;
    if (!list.length) {
      document.getElementById('pwsGrid').innerHTML = '<div class="pws-empty"><i class="bi bi-folder"></i>No projects to show</div>';
      return;
    }
    document.getElementById('pwsGrid').innerHTML =
      '<div class="pws-grid">'
      + list.map(function(p) {
          var techs = (p.tech_stack||'').split(',').filter(Boolean).map(function(t){
            return '<span class="pws-tech-chip">'+esc(t.trim())+'</span>';
          }).join('');
          return '<div class="pws-card'+(p.id===_activeCard?' open':'')+'" onclick="pwsOpenProject('+p.id+')">'
            +'<div class="pws-card-top">'
            +'<div class="pws-card-title">'+esc(p.title)+'</div>'
            +'<span class="pws-status pws-s-'+p.status+'">'+esc(STATUS_LABELS[p.status])+'</span>'
            +'</div>'
            +'<div class="pws-card-dev"><i class="bi bi-person-fill" style="margin-right:3px"></i>'+esc(p.developer_name)+'</div>'
            +'<div class="pws-prog-row">'
            +'<div class="pws-prog-bar"><div class="pws-prog-fill" style="width:'+p.progress+'%"></div></div>'
            +'<span class="pws-prog-pct">'+p.progress+'%</span>'
            +'</div>'
            +(techs ? '<div class="pws-tech-row">'+techs+'</div>' : '')
            +'</div>';
        }).join('')
      + '</div>';
  }

  window.pwsFilter = function(btn, status) {
    _filter = status;
    document.querySelectorAll('.pws-filter-btn').forEach(function(b){b.classList.remove('active');});
    btn.classList.add('active');
    renderGrid();
  };

  function buildOverviewHtml(p) {
    var doneCount  = (p.tasks||[]).filter(function(t){return t.status==='done';}).length;
    var totalCount = (p.tasks||[]).length;

    var taskRows = (p.tasks||[]).map(function(t){
      return '<div class="pws-task-row">'
        +'<div class="pws-task-dot" style="background:'+TASK_STATUS_COLORS[t.status]+'"></div>'
        +'<span class="pws-task-text'+(t.status==='done'?' done':'')+'">'+esc(t.title)+'</span>'
        +'<span class="pws-task-status">'+TASK_STATUS_LABELS[t.status]+'</span>'
        +'</div>';
    }).join('') || '<div style="font-size:0.75rem;color:rgba(255,255,255,0.3);padding:8px 0">No tasks added yet</div>';

    return '<div class="pws-summary-row">'
      +'<div class="pws-summary-tile"><div class="pws-summary-val">'+p.progress+'%</div><div class="pws-summary-lbl">Complete</div></div>'
      +'<div class="pws-summary-tile"><div class="pws-summary-val">'+doneCount+'/'+totalCount+'</div><div class="pws-summary-lbl">Tasks Done</div></div>'
      +'<div class="pws-summary-tile"><div class="pws-summary-val" style="color:#a5b4fc">'+esc(STATUS_LABELS[p.status])+'</div><div class="pws-summary-lbl">Status</div></div>'
      +'</div>'
      +(p.description ? '<div class="pws-desc">'+esc(p.description)+'</div>' : '')
      +(p.tech_stack ? '<div><div class="pws-section-label">Tech Stack</div><div style="display:flex;flex-wrap:wrap;gap:5px">'
        +p.tech_stack.split(',').filter(Boolean).map(function(t){return '<span class="pws-tech-chip" style="font-size:0.72rem;padding:3px 9px">'+esc(t.trim())+'</span>';}).join('')
        +'</div></div>' : '')
      +'<div><div class="pws-section-label">Sub-Tasks ('+doneCount+' of '+totalCount+' done)</div>'+taskRows+'</div>';
  }

  function buildUpdatesHtml(rows) {
    if (!rows || !rows.length) {
      return '<div class="pws-tab-empty"><i class="bi bi-megaphone" style="font-size:1.8rem;display:block;margin-bottom:8px;opacity:0.3"></i>No updates posted yet</div>';
    }
    return rows.map(function(u){
      return '<div class="pws-update-item">'
        +'<div class="pws-update-avatar">'+initials(u.author_name)+'</div>'
        +'<div style="flex:1;min-width:0">'
        +'<div class="pws-update-meta">'+esc(u.author_name)+' &middot; '+fmtDate(u.created_at)+'</div>'
        +'<div class="pws-update-body">'+esc(u.body)+'</div>'
        +'</div></div>';
    }).join('');
  }

  function buildReleasesHtml(rows) {
    if (!rows || !rows.length) {
      return '<div class="pws-tab-empty"><i class="bi bi-rocket-takeoff" style="font-size:1.8rem;display:block;margin-bottom:8px;opacity:0.3"></i>No releases logged yet</div>';
    }
    return rows.map(function(r){
      return '<div class="pws-release-item">'
        +'<div class="pws-release-top">'
        +'<span class="pws-release-version">'+esc(r.version)+'</span>'
        +'<span class="pws-release-env pws-env-'+r.environment+'">'+esc(ENV_LABELS[r.environment]||r.environment)+'</span>'
        +'</div>'
        +'<div class="pws-release-meta">Released by '+esc(r.released_by_name)+' &middot; '+fmtDate(r.released_at)+'</div>'
        +(r.notes ? '<div class="pws-release-notes">'+esc(r.notes)+'</div>' : '')
        +'</div>';
    }).join('');
  }

  function showTab(tab) {
    _activeTab = tab;
    document.querySelectorAll('.pws-dtab').forEach(function(el){
      el.classList.toggle('active', el.dataset.tab === tab);
    });
    var cache = _tabCache[_activeCard] || {};
    if (cache[tab] !== undefined) {
      document.getElementById('pwsDrawerBody').innerHTML = cache[tab];
      return;
    }
    document.getElementById('pwsDrawerBody').innerHTML = '<div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>';

    var endpoint = tab === 'updates'
      ? '/portal/workspace/projects/'+_activeCard+'/updates'
      : '/portal/workspace/projects/'+_activeCard+'/releases';

    fetch(endpoint)
      .then(function(r){return r.json();})
      .then(function(res){
        var html = tab === 'updates'
          ? buildUpdatesHtml(res.success ? res.data : [])
          : buildReleasesHtml(res.success ? res.data : []);
        if (!_tabCache[_activeCard]) _tabCache[_activeCard] = {};
        _tabCache[_activeCard][tab] = html;
        if (_activeTab === tab && _activeCard) {
          document.getElementById('pwsDrawerBody').innerHTML = html;
        }
      })
      .catch(function(){
        document.getElementById('pwsDrawerBody').innerHTML = '<div class="pws-tab-empty">Failed to load</div>';
      });
  }

  window.pwsSwitchTab = function(tab) {
    if (!_activeCard) return;
    if (tab === 'overview') {
      _activeTab = 'overview';
      document.querySelectorAll('.pws-dtab').forEach(function(el){
        el.classList.toggle('active', el.dataset.tab === 'overview');
      });
      var cache = _tabCache[_activeCard] || {};
      document.getElementById('pwsDrawerBody').innerHTML = cache.overview || '<div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>';
    } else {
      showTab(tab);
    }
  };

  window.pwsOpenProject = function(id) {
    _activeCard  = id;
    _activeTab   = 'overview';
    _activeProject = null;
    renderGrid();

    document.getElementById('pwsDrawer').classList.add('visible');
    document.getElementById('pwsDrawerTitle').textContent = '—';
    document.getElementById('pwsDrawerDev').textContent = '';
    document.getElementById('pwsDrawerBody').innerHTML = '<div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>';
    document.querySelectorAll('.pws-dtab').forEach(function(el){
      el.classList.toggle('active', el.dataset.tab === 'overview');
    });

    fetch('/portal/workspace/projects/'+id)
      .then(function(r){return r.json();})
      .then(function(res){
        if (!res.success) {
          document.getElementById('pwsDrawerBody').innerHTML = '<div class="pws-empty">Failed to load</div>';
          return;
        }
        var p = res.data;
        _activeProject = p;
        document.getElementById('pwsDrawerTitle').textContent = p.title;
        document.getElementById('pwsDrawerDev').innerHTML = '<i class="bi bi-person-fill" style="margin-right:3px"></i>' + esc(p.developer_name);

        var overviewHtml = buildOverviewHtml(p);
        if (!_tabCache[id]) _tabCache[id] = {};
        _tabCache[id].overview = overviewHtml;
        if (_activeTab === 'overview' && _activeCard === id) {
          document.getElementById('pwsDrawerBody').innerHTML = overviewHtml;
        }
      })
      .catch(function(){
        document.getElementById('pwsDrawerBody').innerHTML = '<div class="pws-empty">Failed to load</div>';
      });
  };

  window.pwsCloseDrawer = function() {
    _activeCard    = null;
    _activeProject = null;
    _activeTab     = 'overview';
    document.getElementById('pwsDrawer').classList.remove('visible');
    renderGrid();
  };

  // ── Thoughts ──────────────────────────────────────────────────────────
  var _mainSection   = 'projects';
  var _thoughts      = [];
  var _activeThought = null;
  var _portalUserId  = <%- JSON.stringify(user.id) %>;

  window.pwsSwitchMain = function(section) {
    _mainSection = section;
    document.getElementById('pwsSectProjects').style.display  = section === 'projects' ? '' : 'none';
    document.getElementById('pwsSectThoughts').style.display  = section === 'thoughts' ? '' : 'none';
    document.getElementById('pwsTabProjects').classList.toggle('active', section === 'projects');
    document.getElementById('pwsTabThoughts').classList.toggle('active', section === 'thoughts');
    // close open drawers when switching
    document.getElementById('pwsDrawer').classList.remove('visible');
    document.getElementById('pwsThoughtDrawer').classList.remove('visible');
    _activeCard    = null;
    _activeThought = null;
    renderGrid();
    if (section === 'thoughts') pwsLoadThoughts();
  };

  window.pwsUpdateFileLabel = function(input, labelId) {
    var el = document.getElementById(labelId);
    if (!el) return;
    el.textContent = input.files.length ? input.files.length + ' file' + (input.files.length > 1 ? 's' : '') + ' selected' : '';
  };

  window.pwsLoadThoughts = function() {
    var el = document.getElementById('pwsThoughtListEl');
    if (!el) return;
    el.innerHTML = '<div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>';
    fetch('/portal/workspace/thoughts')
      .then(function(r) { return r.json(); })
      .then(function(res) {
        _thoughts = res.success ? res.data : [];
        renderThoughtList();
      })
      .catch(function() {
        el.innerHTML = '<div class="pws-empty"><i class="bi bi-exclamation-circle"></i>Failed to load thoughts</div>';
      });
  };

  function renderThoughtList() {
    var el = document.getElementById('pwsThoughtListEl');
    if (!el) return;
    if (!_thoughts.length) {
      el.innerHTML = '<div class="pws-empty"><i class="bi bi-lightbulb"></i>No thoughts shared yet — be the first to post</div>';
      return;
    }
    el.innerHTML = _thoughts.map(function(t) {
      var fc = parseInt(t.file_count)    || 0;
      var cc = parseInt(t.comment_count) || 0;
      return '<div class="pws-thought-card' + (t.id === _activeThought ? ' open' : '') + '" onclick="pwsOpenThought(' + t.id + ')">'
        + '<div class="pws-thought-card-top">'
        + '<div class="pws-thought-title">' + esc(t.title) + '</div>'
        + '</div>'
        + '<div class="pws-thought-meta">'
        + '<span><i class="bi bi-calendar3" style="margin-right:2px"></i>' + fmtDate(t.created_at) + '</span>'
        + (fc ? '<span><i class="bi bi-paperclip" style="margin-right:2px"></i>' + fc + ' file' + (fc > 1 ? 's' : '') + '</span>' : '')
        + (cc ? '<span><i class="bi bi-chat-left-text" style="margin-right:2px"></i>' + cc + ' comment' + (cc > 1 ? 's' : '') + '</span>' : '')
        + '</div>'
        + '</div>';
    }).join('');
  }

  window.pwsOpenThought = function(id) {
    _activeThought = id;
    renderThoughtList();
    var drawer = document.getElementById('pwsThoughtDrawer');
    drawer.classList.add('visible');
    document.getElementById('pwsTDrawerTitle').textContent = '—';
    document.getElementById('pwsTDrawerMeta').textContent  = '';
    document.getElementById('pwsTDrawerBody').innerHTML    = '<div class="pws-spinner-wrap"><div class="pws-spinner"></div></div>';

    fetch('/portal/workspace/thoughts/' + id)
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.success) { document.getElementById('pwsTDrawerBody').innerHTML = '<div class="pws-empty">Failed to load</div>'; return; }
        var t = res.data;
        document.getElementById('pwsTDrawerTitle').textContent = t.title;
        document.getElementById('pwsTDrawerMeta').innerHTML = '<i class="bi bi-lightbulb-fill" style="color:#6366f1;margin-right:4px"></i>' + fmtDate(t.created_at);
        document.getElementById('pwsTDrawerBody').innerHTML = buildThoughtBodyHtml(t);
      })
      .catch(function() { document.getElementById('pwsTDrawerBody').innerHTML = '<div class="pws-empty">Failed to load</div>'; });
  };

  window.pwsCloseThoughtDrawer = function() {
    _activeThought = null;
    document.getElementById('pwsThoughtDrawer').classList.remove('visible');
    renderThoughtList();
  };

  function buildThoughtBodyHtml(t) {
    var filesHtml = '';
    if (t.files && t.files.length) {
      filesHtml = '<div class="pws-section-label" style="margin:10px 0 6px">Attachments</div>'
        + '<div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px">'
        + t.files.map(function(f) {
            return '<a class="pws-att-chip" href="/portal/workspace/thoughts/files/' + f.id + '" target="_blank"><i class="bi bi-file-earmark"></i>' + esc(f.file_name) + '</a>';
          }).join('')
        + '</div>';
    }
    var commentsHtml = '';
    if (t.comments && t.comments.length) {
      commentsHtml = t.comments.map(function(c) {
        var cFiles = '';
        if (c.files && c.files.length) {
          cFiles = '<div style="display:flex;flex-wrap:wrap;gap:4px;margin-top:5px">'
            + c.files.map(function(f) { return '<a class="pws-att-chip" href="/portal/workspace/thoughts/comment-files/' + f.id + '" target="_blank"><i class="bi bi-file-earmark"></i>' + esc(f.file_name) + '</a>'; }).join('')
            + '</div>';
        }
        var canDel = (c.author_id === _portalUserId);
        return '<div class="pws-update-item">'
          + '<div class="pws-update-avatar">' + initials(c.author_name) + '</div>'
          + '<div style="flex:1;min-width:0">'
          + '<div class="pws-update-meta">' + esc(c.author_name) + ' &middot; ' + fmtDate(c.created_at)
          + (canDel ? ' <button onclick="pwsDeleteThoughtComment(' + t.id + ',' + c.id + ')" style="background:none;border:none;color:rgba(239,68,68,.6);cursor:pointer;font-size:.68rem;padding:0 0 0 6px" title="Delete"><i class="bi bi-trash"></i></button>' : '')
          + '</div>'
          + '<div class="pws-update-body">' + esc(c.body) + '</div>'
          + cFiles
          + '</div></div>';
      }).join('');
    } else {
      commentsHtml = '<div class="pws-tab-empty" style="padding:12px 0">No comments yet</div>';
    }

    var isOwner = (t.author_id === _portalUserId);
    return '<div class="pws-update-body" style="font-size:.82rem;color:rgba(255,255,255,.65);line-height:1.6;white-space:pre-wrap;word-break:break-word;margin-bottom:10px">' + esc(t.body) + '</div>'
      + filesHtml
      + '<div class="pws-section-label" style="margin-bottom:8px">Comments</div>'
      + '<div class="ws-timeline">' + commentsHtml + '</div>'
      + '<div class="pws-comment-area" style="margin-top:10px;border-top:1px solid rgba(255,255,255,.06);padding-top:12px">'
      + '<textarea id="pwsTcBody" placeholder="Add a comment..."></textarea>'
      + '<div class="pws-thought-form-row" style="margin-top:5px">'
      + '<label for="pwsTcFiles" class="pws-attach-btn"><i class="bi bi-paperclip"></i> Attach</label>'
      + '<input type="file" id="pwsTcFiles" multiple style="display:none" onchange="pwsUpdateFileLabel(this,\'pwsTcFileLabel\')">'
      + '<span class="pws-attach-label" id="pwsTcFileLabel"></span>'
      + '<button class="pws-thought-post-btn" style="padding:5px 12px;font-size:.72rem" onclick="pwsPostThoughtComment(' + t.id + ')"><i class="bi bi-chat-left-text"></i> Post</button>'
      + '</div></div>'
      + (isOwner ? '<div style="margin-top:14px;text-align:right"><button onclick="pwsDeleteThought(' + t.id + ')" style="background:none;border:1px solid rgba(239,68,68,.3);border-radius:6px;color:#ef4444;padding:4px 11px;font-size:.7rem;cursor:pointer;transition:all .15s"><i class="bi bi-trash"></i> Delete thought</button></div>' : '');
  }

  window.pwsPostThought = function() {
    var title = document.getElementById('pwsThoughtTitle').value.trim();
    var body  = document.getElementById('pwsThoughtBody').value.trim();
    if (!title) { document.getElementById('pwsThoughtTitle').focus(); return; }
    if (!body)  { document.getElementById('pwsThoughtBody').focus(); return; }
    var files = document.getElementById('pwsThoughtFiles').files;
    var fd = new FormData();
    fd.append('title', title);
    fd.append('body', body);
    for (var i = 0; i < files.length; i++) fd.append('files', files[i]);

    fetch('/portal/workspace/thoughts', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.success) { alert(res.message || 'Failed to post'); return; }
        document.getElementById('pwsThoughtTitle').value = '';
        document.getElementById('pwsThoughtBody').value  = '';
        document.getElementById('pwsThoughtFiles').value = '';
        document.getElementById('pwsThoughtFileLabel').textContent = '';
        _thoughts = res.data;
        renderThoughtList();
      })
      .catch(function() { alert('Failed to post thought'); });
  };

  window.pwsPostThoughtComment = function(thoughtId) {
    var body  = document.getElementById('pwsTcBody').value.trim();
    if (!body) { document.getElementById('pwsTcBody').focus(); return; }
    var files = document.getElementById('pwsTcFiles').files;
    var fd = new FormData();
    fd.append('body', body);
    for (var i = 0; i < files.length; i++) fd.append('files', files[i]);

    fetch('/portal/workspace/thoughts/' + thoughtId + '/comments', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.success) { alert(res.message || 'Failed'); return; }
        document.getElementById('pwsTDrawerBody').innerHTML = buildThoughtBodyHtml(res.data);
        pwsLoadThoughts();
      });
  };

  window.pwsDeleteThought = function(id) {
    if (!confirm('Delete this thought and all its comments?')) return;
    fetch('/portal/workspace/thoughts/' + id, { method: 'DELETE' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.success) { alert(res.message || 'Failed'); return; }
        pwsCloseThoughtDrawer();
        pwsLoadThoughts();
      });
  };

  window.pwsDeleteThoughtComment = function(thoughtId, commentId) {
    if (!confirm('Delete this comment?')) return;
    fetch('/portal/workspace/thoughts/comments/' + commentId, { method: 'DELETE' })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (!res.success) return;
        // refresh drawer
        fetch('/portal/workspace/thoughts/' + thoughtId)
          .then(function(r2) { return r2.json(); })
          .then(function(res2) {
            if (res2.success) document.getElementById('pwsTDrawerBody').innerHTML = buildThoughtBodyHtml(res2.data);
            pwsLoadThoughts();
          });
      });
  };

  load();
})();
</script>
