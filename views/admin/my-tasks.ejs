    <!-- Recurring section -->
    <div class="admt-cr-section" id="admtCrRecurSection" style="display:none">
      <div class="admt-cr-section-title"><i class="bi bi-arrow-repeat"></i> Recurrence</div>
      <div class="admt-cr-grid-3">
        <div>
          <label class="admt-cr-label">Pattern *</label>
          <select class="admt-cr-select" id="admtCrPattern" onchange="admtCrHandlePattern()">
            <option value="daily">Every Day</option>
            <option value="weekly" selected>Weekly</option>
            <option value="monthly">Monthly</option>
          </select>
        </div>
        <div>
          <label class="admt-cr-label">Deadline Time</label>
          <input type="time" class="admt-cr-input" id="admtCrDeadlineTime">
        </div>
        <div>
          <label class="admt-cr-label">End Date</label>
          <input type="date" class="admt-cr-input" id="admtCrEndDate">
        </div>
