      <div id="admtCrWeeklyDays">
        <label class="admt-cr-label">Days of Week *</label>
        <div class="admt-cr-day-row">
          <button type="button" class="admt-cr-day" data-day="0">Sun</button>
          <button type="button" class="admt-cr-day" data-day="1">Mon</button>
          <button type="button" class="admt-cr-day" data-day="2">Tue</button>
          <button type="button" class="admt-cr-day" data-day="3">Wed</button>
          <button type="button" class="admt-cr-day" data-day="4">Thu</button>
          <button type="button" class="admt-cr-day" data-day="5">Fri</button>
          <button type="button" class="admt-cr-day" data-day="6">Sat</button>
        </div>
      </div>
      <div id="admtCrMonthlyDates" style="display:none">
        <label class="admt-cr-label">Dates of Month *</label>
