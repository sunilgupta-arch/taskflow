  <div class="admt-cr-foot">
    <button class="admt-cr-foot-btn" onclick="admtCloseCreate()">Cancel</button>
    <button class="admt-cr-foot-btn primary" id="admtCrSubmit" onclick="admtSubmitCreate()">
      <i class="bi bi-plus-lg"></i> Create Task
    </button>
  </div>
</div>

<!-- Table -->
<div class="admt-table-wrap">
  <table class="admt-table">
    <thead>
      <tr>
        <th style="width:35%">Task</th>
        <th style="width:10%">Type</th>
        <th style="width:12%">Deadline / Due</th>
        <th style="width:9%">Priority</th>
        <th style="width:12%">Status</th>
        <th style="width:22%">Action</th>
      </tr>
    </thead>
    <tbody id="admtBody">
      <tr><td colspan="6">
        <div class="admt-loading"><div class="admt-spinner"></div> Loading…</div>
      </td></tr>
    </tbody>
  </table>
</div>

<script>
(function () {
  var _today       = '<%- today %>';
  var _userId      = <%- currentUser.id %>;
  var currentSchedule = 'today';
  var currentDate     = _today;
  var typeFilter      = '';
  var allTasks        = [];

  /* ── helpers ─────────────────────────────────────────────────── */
  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function fmtTime(t) {
    if (!t) return '—';
    var p = t.split(':'); var h = parseInt(p[0]); var m = p[1];
    return (h % 12 || 12) + ':' + m + ' ' + (h >= 12 ? 'PM' : 'AM');
  }

  function fmtDate(d) {
    if (!d) return '—';
    var s = String(d).split('T')[0];
    return new Date(s + 'T12:00:00').toLocaleDateString('en-GB', { day:'2-digit', month:'short' });
  }

  function fmtDuration(mins) {
    if (!mins) return '';
    var h = Math.floor(mins / 60), m = mins % 60;
    return h ? h + 'h ' + (m ? m + 'm' : '') : m + 'm';
  }

  function patternLabel(t) {
    if (t.pattern === 'daily')   return 'Daily';
    if (t.pattern === 'monthly') return 'Monthly';
    if (t.pattern === 'weekly' && t.recurrence_days) {
      var names = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
      return t.recurrence_days.split(',').map(function(d){ return names[parseInt(d.trim())]; }).join(', ');
    }
    return 'Weekly';
  }

  /* ── stats ───────────────────────────────────────────────────── */
  function updateStats(tasks) {
    var done = 0, prog = 0, pend = 0;
    tasks.forEach(function(t) {
      if (t.status === 'done' || t.status === 'completed') done++;
      else if (t.status === 'in_progress') prog++;
      else pend++;
    });
    document.getElementById('admtStTotal').textContent    = tasks.length;
    document.getElementById('admtStDone').textContent     = done;
    document.getElementById('admtStProgress').textContent = prog;
    document.getElementById('admtStPending').textContent  = pend;
  }

  /* ── filter ──────────────────────────────────────────────────── */
  function getFiltered() {
    if (!typeFilter) return allTasks;
    return allTasks.filter(function(t){ return t.type === typeFilter; });
  }

  /* ── render ──────────────────────────────────────────────────── */
  function render() {
    var rows  = getFiltered();
    var tbody = document.getElementById('admtBody');
    document.getElementById('admtCount').textContent = rows.length + ' task' + (rows.length !== 1 ? 's' : '');
    updateStats(rows);

    if (!rows.length) {
      tbody.innerHTML =
        '<tr><td colspan="6"><div class="admt-empty">' +
        '<i class="bi bi-' + (currentSchedule === 'today' ? 'calendar-check' : 'inbox') + '"></i>' +
        '<div class="admt-empty-title">' + (currentSchedule === 'today' ? 'Nothing assigned for this day' : 'No tasks assigned to you') + '</div>' +
        '<div style="font-size:0.78rem;color:var(--adm-muted)">Ask an admin to assign tasks to you</div>' +
        '</div></td></tr>';
      return;
    }

    var html = '';
    rows.forEach(function(t) {
      var rowClass = 'rs-' + esc(t.status);

      /* type badge */
      var typeHtml = t.type === 'recurring'
        ? '<span class="admt-badge b-recurring"><i class="bi bi-arrow-repeat"></i> ' + esc(patternLabel(t)) + '</span>'
        : '<span class="admt-badge b-once">One-time</span>';

      /* deadline/due */
      var dueHtml;
      if (t.type === 'recurring') {
        dueHtml = t.deadline_time
          ? '<span style="font-family:var(--adm-mono);font-size:0.8rem;">' + esc(fmtTime(t.deadline_time)) + '</span>'
          : '<span style="color:var(--adm-muted)">—</span>';
      } else {
        var isOverdue = t.due_date && String(t.due_date).split('T')[0] < new Date().toISOString().split('T')[0] && t.status !== 'completed';
        dueHtml = t.due_date
          ? '<span style="' + (isOverdue ? 'color:#ef4444' : 'color:var(--adm-text-2)') + ';font-size:0.82rem;">' +
            esc(fmtDate(t.due_date)) + (isOverdue ? '<div style="font-size:0.6rem;color:#ef4444">Overdue</div>' : '') + '</span>'
          : '<span style="color:var(--adm-muted)">—</span>';
      }

      /* priority */
      var pri      = t.priority || 'medium';
      var priLabel = pri.charAt(0).toUpperCase() + pri.slice(1);
      var priHtml  = '<div class="admt-pri p-' + esc(pri) + '"><span class="admt-pri-dot"></span>' + esc(priLabel) + '</div>';

      /* status */
      var statusLabel = { done:'Done', in_progress:'In Progress', pending:'Pending', active:'Active', completed:'Completed' }[t.status] || t.status;
      var statusHtml  = '<span class="admt-status s-' + esc(t.status) + '">' + esc(statusLabel) + '</span>';
      if (t.status === 'in_progress' && t.started_at) {
        statusHtml += '<div class="admt-timer"><i class="bi bi-play-fill"></i> ' + esc(new Date(t.started_at).toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit',hour12:true})) + '</div>';
      }
      if ((t.status === 'done' || t.status === 'completed') && t.duration_minutes) {
        statusHtml += '<div class="admt-duration"><i class="bi bi-clock"></i> ' + esc(fmtDuration(t.duration_minutes)) + '</div>';
      }

      /* action buttons */
      var actionHtml = '';
      if (currentSchedule === 'today') {
        if (t.type === 'recurring') {
          if (t.status === 'pending') {
            actionHtml = '<button class="admt-btn btn-start" onclick="startSession(' + t.id + ')"><i class="bi bi-play-fill"></i> Start</button>';
          } else if (t.status === 'in_progress') {
            actionHtml = '<button class="admt-btn btn-complete" onclick="completeSession(' + t.id + ')"><i class="bi bi-check-lg"></i> Complete</button>';
          } else {
            actionHtml = '<button class="admt-btn" disabled><i class="bi bi-check-circle-fill" style="color:#10b981"></i> Done</button>';
          }
        } else {
          if (t.status === 'pending') {
            actionHtml =
              '<button class="admt-btn btn-start" onclick="startTask(' + t.id + ')"><i class="bi bi-play-fill"></i> Start</button>' +
              '<button class="admt-btn btn-complete" onclick="completeTask(' + t.id + ')"><i class="bi bi-check-lg"></i> Done</button>';
          } else if (t.status === 'in_progress') {
            actionHtml = '<button class="admt-btn btn-complete" onclick="completeTask(' + t.id + ')"><i class="bi bi-check-lg"></i> Complete</button>';
          } else {
            actionHtml = '<button class="admt-btn" disabled><i class="bi bi-check-circle-fill" style="color:#10b981"></i> Done</button>';
          }
        }
      } else {
        /* all mode — just link to task detail */
        actionHtml = '<a href="/tasks/' + t.id + '" class="admt-btn btn-view"><i class="bi bi-box-arrow-up-right"></i> View</a>';
      }

      /* task sub-line */
      var sub = t.type === 'recurring' ? patternLabel(t) : '';

      html +=
        '<tr class="' + rowClass + '">' +
          '<td>' +
            '<div class="admt-task-title admt-task-title-link" onclick="admtOpenDetail(' + JSON.stringify(t).replace(/</g,'\\u003c').replace(/"/g,'&quot;') + ')">' + esc(t.title) + '</div>' +
            (sub ? '<div class="admt-task-sub"><i class="bi bi-arrow-repeat"></i> ' + esc(sub) + '</div>' : '') +
          '</td>' +
          '<td>' + typeHtml + '</td>' +
          '<td>' + dueHtml + '</td>' +
          '<td>' + priHtml + '</td>' +
          '<td>' + statusHtml + '</td>' +
          '<td><div class="admt-actions">' + actionHtml + '</div></td>' +
        '</tr>';
    });
    tbody.innerHTML = html;
  }

  /* ── fetch data ──────────────────────────────────────────────── */
  function loadData() {
    var tbody = document.getElementById('admtBody');
    tbody.innerHTML = '<tr><td colspan="6"><div class="admt-loading"><div class="admt-spinner"></div> Loading…</div></td></tr>';
    ['admtStTotal','admtStDone','admtStProgress','admtStPending'].forEach(function(id){ document.getElementById(id).textContent = '—'; });

    var url = '/admin/my-tasks/data?schedule=' + currentSchedule;
    if (currentSchedule === 'today') url += '&date=' + encodeURIComponent(currentDate);

    fetch(url, { credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(data) {
        if (!data.success) throw new Error(data.message || 'Server error');
        allTasks = data.tasks || [];
        render();
      })
      .catch(function(err) {
        tbody.innerHTML =
          '<tr><td colspan="6"><div class="admt-empty">' +
          '<i class="bi bi-exclamation-triangle"></i>' +
          '<div class="admt-empty-title">Failed to load tasks</div>' +
          '<div style="font-size:0.78rem">' + esc(err.message) + '</div>' +
          '</div></td></tr>';
      });
  }

  /* ── schedule switch ─────────────────────────────────────────── */
  window.switchSchedule = function(s) {
    currentSchedule = s;
    document.getElementById('admtTabToday').classList.toggle('active', s === 'today');
    document.getElementById('admtTabAll').classList.toggle('active', s === 'all');
    document.getElementById('admtDateNav').style.display = s === 'today' ? 'flex' : 'none';
    loadData();
  };

  /* ── date nav ────────────────────────────────────────────────── */
  function shiftDate(d, days) {
    var dt = new Date(d + 'T12:00:00'); dt.setDate(dt.getDate() + days);
    return dt.toISOString().split('T')[0];
  }
  function setDate(d) {
    currentDate = d;
    document.getElementById('admtDate').value = d;
    loadData();
  }
  document.getElementById('admtPrev').addEventListener('click', function(){ setDate(shiftDate(currentDate, -1)); });
  document.getElementById('admtNext').addEventListener('click', function(){ setDate(shiftDate(currentDate, 1)); });
  document.getElementById('admtTodayBtn').addEventListener('click', function(){ setDate(_today); });
  document.getElementById('admtDate').addEventListener('change', function(){ if (this.value) setDate(this.value); });
  document.getElementById('admtTypeFilter').addEventListener('change', function(){ typeFilter = this.value; render(); });

  /* ── task actions ────────────────────────────────────────────── */
  function doAction(url, method, taskId, optimisticStatus) {
    fetch(url, { method: method, credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(data) {
        if (data.success) {
          /* optimistically update local task status, then reload for accurate server data */
          allTasks.forEach(function(t) {
            if (t.id === taskId) t.status = optimisticStatus;
          });
          render();
          /* reload after short delay to get accurate started_at / completed_at / duration */
          setTimeout(loadData, 600);
        } else {
          alert(data.message || 'Action failed');
        }
      })
      .catch(function(){ alert('Network error'); });
  }

  window.startSession   = function(id){ doAction('/tasks/' + id + '/start-session',   'POST', id, 'in_progress'); };
  window.completeSession= function(id){ doAction('/tasks/' + id + '/complete-session','POST', id, 'done'); };
  window.startTask      = function(id){ doAction('/tasks/start/'   + id,              'POST', id, 'in_progress'); };
  window.completeTask   = function(id){ doAction('/tasks/complete/' + id,             'POST', id, 'completed'); };

  /* ── initial load ────────────────────────────────────────────── */
  loadData();
})();
</script>

<!-- ── Task detail drawer ─────────────────────────────────────── -->
<div id="admtOverlay" class="admt-overlay" onclick="admtCloseDetail()"></div>
<div id="admtDrawer" class="admt-drawer">
  <div class="admt-drawer-header">
    <div class="admt-drawer-title"><i class="bi bi-clipboard2-check"></i> <span id="admtDrawerTitle">Task Detail</span></div>
    <button class="admt-drawer-close" onclick="admtCloseDetail()"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="admt-drawer-meta" id="admtDrawerMeta"></div>
  <div class="admt-drawer-actions" id="admtDrawerActions"></div>
  <div class="admt-drawer-body" id="admtDrawerBody">
    <div class="admt-no-comments">Loading…</div>
  </div>
  <div class="admt-comment-input-row">
    <textarea class="admt-comment-textarea" id="admtCommentInput" rows="2" placeholder="Add a comment…"></textarea>
    <button class="admt-comment-send" onclick="admtSendComment()"><i class="bi bi-send-fill"></i></button>
  </div>
</div>

<script>
(function() {
  var _task = null;

  function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function fmtTime(t) {
    if (!t) return '—';
    var p = t.split(':'); var h = parseInt(p[0],10); var m = p[1];
    var ampm = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12;
    return h + ':' + m + ' ' + ampm;
  }

  window.admtOpenDetail = function(task) {
    _task = task;
    document.getElementById('admtDrawerTitle').textContent = task.title;

    /* meta row */
    var priColor = { high:'#ef4444', medium:'#f59e0b', low:'#10b981' }[task.priority] || '#94a3b8';
    var statusLabel = { done:'Done', in_progress:'In Progress', pending:'Pending', active:'Active', completed:'Completed' }[task.status] || task.status;
    var statusColor = { done:'#10b981', in_progress:'#3b82f6', pending:'#f97316', active:'#8b5cf6', completed:'#94a3b8' }[task.status] || '#94a3b8';
    var typeLabel   = task.type === 'recurring' ? (task.pattern ? task.pattern.charAt(0).toUpperCase() + task.pattern.slice(1) : 'Recurring') : 'One-time';
    document.getElementById('admtDrawerMeta').innerHTML =
      '<span style="font-size:0.7rem;font-family:var(--adm-mono);padding:3px 9px;border-radius:20px;border:1px solid var(--adm-border);color:var(--adm-muted)">' + esc(typeLabel) + '</span>' +
      '<span style="font-size:0.7rem;font-family:var(--adm-mono);padding:3px 9px;border-radius:20px;background:rgba(255,255,255,0.04);color:' + priColor + '">' + esc((task.priority||'medium').charAt(0).toUpperCase()+(task.priority||'medium').slice(1)) + '</span>' +
      '<span style="font-size:0.7rem;font-family:var(--adm-mono);padding:3px 9px;border-radius:20px;background:rgba(255,255,255,0.04);color:' + statusColor + '">' + esc(statusLabel) + '</span>' +
      (task.deadline_time ? '<span style="font-size:0.7rem;font-family:var(--adm-mono);color:var(--adm-muted)"><i class="bi bi-clock" style="margin-right:3px"></i>' + esc(fmtTime(task.deadline_time)) + '</span>' : '');

    /* action buttons */
    var actHtml = '';
    if (task.type === 'recurring') {
      if (task.status === 'pending')      actHtml = '<button class="admt-btn btn-start"    onclick="startSession(' + task.id + ');admtRefreshActions(this.closest(\'.admt-drawer\'))"><i class="bi bi-play-fill"></i> Start</button>';
      else if (task.status === 'in_progress') actHtml = '<button class="admt-btn btn-complete" onclick="completeSession(' + task.id + ');admtCloseDetail()"><i class="bi bi-check-lg"></i> Complete</button>';
    } else {
      if (task.status === 'pending')      actHtml = '<button class="admt-btn btn-start" onclick="startTask(' + task.id + ')"><i class="bi bi-play-fill"></i> Start</button><button class="admt-btn btn-complete" onclick="completeTask(' + task.id + ');admtCloseDetail()"><i class="bi bi-check-lg"></i> Done</button>';
      else if (task.status === 'in_progress') actHtml = '<button class="admt-btn btn-complete" onclick="completeTask(' + task.id + ');admtCloseDetail()"><i class="bi bi-check-lg"></i> Complete</button>';
    }
    var actEl = document.getElementById('admtDrawerActions');
    actEl.innerHTML   = actHtml;
    actEl.style.display = actHtml ? 'flex' : 'none';

    /* show drawer */
    document.getElementById('admtOverlay').style.display = 'block';
    document.getElementById('admtDrawer').classList.add('open');
    document.getElementById('admtCommentInput').value = '';
    admtLoadComments();
  };

  window.admtCloseDetail = function() {
    document.getElementById('admtOverlay').style.display = 'none';
    document.getElementById('admtDrawer').classList.remove('open');
    _task = null;
  };

  function admtLoadComments() {
    if (!_task) return;
    document.getElementById('admtDrawerBody').innerHTML = '<div class="admt-no-comments">Loading comments…</div>';
    fetch('/tasks/' + _task.id + '/comments', { credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(res) {
        var comments = (res.data && res.data.comments) || [];
        var html = '<div class="admt-drawer-comments-title"><i class="bi bi-chat-left-text" style="margin-right:4px"></i>Comments (' + comments.length + ')</div>';
        if (!comments.length) {
          html += '<div class="admt-no-comments">No comments yet. Be the first to add one.</div>';
        } else {
          comments.forEach(function(c) {
            html += '<div class="admt-comment">' +
              '<div class="admt-comment-avatar">' + esc((c.user_name||'?').charAt(0).toUpperCase()) + '</div>' +
              '<div style="flex:1;min-width:0">' +
                '<div class="admt-comment-meta">' + esc(c.user_name) + ' &bull; ' + esc(new Date(c.created_at).toLocaleString('en-US',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})) + '</div>' +
                '<div class="admt-comment-body">' + esc(c.comment) + '</div>' +
              '</div>' +
            '</div>';
          });
        }
        document.getElementById('admtDrawerBody').innerHTML = html;
        document.getElementById('admtDrawerBody').scrollTop = 99999;
      })
      .catch(function() {
        document.getElementById('admtDrawerBody').innerHTML = '<div class="admt-no-comments">Failed to load comments.</div>';
      });
  }

  window.admtSendComment = function() {
    if (!_task) return;
    var input = document.getElementById('admtCommentInput');
    var body  = input.value.trim();
    if (!body) return;
    input.disabled = true;
    fetch('/tasks/' + _task.id + '/comments', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ comment: body })
    })
      .then(function(r){ return r.json(); })
      .then(function(res) {
        input.disabled = false;
        if (res.success) { input.value = ''; admtLoadComments(); }
        else alert(res.message || 'Failed to post comment');
      })
      .catch(function() { input.disabled = false; alert('Network error'); });
  };

  /* allow Enter to submit (Shift+Enter for newline) */
  document.getElementById('admtCommentInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); admtSendComment(); }
  });
})();
</script>

<script>
/* ── DPR Generator ─────────────────────────────────────────────── */
(function() {
  function fmtDuration(mins) {
    if (!mins || mins <= 0) return '';
    var h = Math.floor(mins / 60), m = mins % 60;
    if (h === 0) return m + 'm';
    return h + 'h' + (m > 0 ? ' ' + m + 'm' : '');
  }
  function fmtTime(dtStr) {
    if (!dtStr) return '';
    return new Date(dtStr).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
  }
  function fmtDate(dateStr) {
    return new Date(dateStr + 'T12:00:00').toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function buildDprBody(data) {
    var done    = data.tasks.filter(function(t) { return t.status === 'done'; });
    var inProg  = data.tasks.filter(function(t) { return t.status === 'in_progress'; });
    var pending = data.tasks.filter(function(t) { return t.status === 'pending'; });
    var sep  = '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━';
    var thin = '────────────────────────────────────────────────';
    var n    = '\n';

    var b = '';
    b += 'Dear Sir,' + n + n;
    b += 'Please find below my Daily Progress Report for ' + fmtDate(data.date) + '.' + n + n;
    b += sep + n;
    b += 'DAILY PROGRESS REPORT' + n;
    b += 'Date: ' + fmtDate(data.date) + '   |   Employee: ' + data.userName + n;
    b += sep + n + n;

    b += '✅  COMPLETED (' + done.length + ')' + n + thin + n;
    if (done.length === 0) {
      b += '    —  None' + n;
    } else {
      done.forEach(function(t, i) {
        b += '    ' + (i + 1) + '.  ' + t.title + n;
      });
    }
    b += n;

    b += '🔄  IN PROGRESS (' + inProg.length + ')' + n + thin + n;
    if (inProg.length === 0) {
      b += '    —  None' + n;
    } else {
      inProg.forEach(function(t, i) {
        b += '    ' + (i + 1) + '.  ' + t.title + n;
      });
    }
    b += n;

    b += '⏳  PENDING (' + pending.length + ')' + n + thin + n;
    if (pending.length === 0) {
      b += '    —  None' + n;
    } else {
      pending.forEach(function(t, i) {
        b += '    ' + (i + 1) + '.  ' + t.title + n;
      });
    }
    b += n;

    if (data.queueRequests && data.queueRequests.length > 0) {
      b += '📋  CLIENT REQUESTS HANDLED (' + data.queueRequests.length + ')' + n + thin + n;
      data.queueRequests.forEach(function(q, i) {
        var st = q.status === 'done' ? 'Done' : 'In Progress';
        b += '    ' + (i + 1) + '.  ' + q.title + '  –  ' + st + n;
      });
      b += n;
    }

    b += sep + n;
    b += 'Summary:  ✅ ' + done.length + ' completed   🔄 ' + inProg.length + ' in progress   ⏳ ' + pending.length + ' pending';
    if (data.queueRequests && data.queueRequests.length > 0) {
      b += '   📋 ' + data.queueRequests.length + ' client request(s)';
    }
    b += n + sep + n + n;
    b += 'Regards,' + n + data.userName;
    return b;
  }

  window.admGenerateDpr = async function(dateStr) {
    var btn = document.getElementById('admDprBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Loading…'; }
    try {
      var resp = await fetch('/admin/dpr/data?date=' + encodeURIComponent(dateStr));
      var data = await resp.json();
      if (!data.success) throw new Error(data.message || 'Server error');

      var subject  = 'DPR – ' + fmtDate(data.date) + ' – ' + data.userName;
      var body     = buildDprBody(data);
      var gmailUrl = 'https://mail.google.com/mail/?view=cm&fs=1&to=sunilgupta%40123cfc.com&su=' +
                     encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
      window.open(gmailUrl, '_blank');
    } catch (e) {
      alert('Could not generate DPR. Please try again.');
      console.error('DPR error:', e);
    } finally {
      if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-envelope-text"></i> Generate DPR'; }
    }
  };
})();
</script>

<script>
/* ── Create Task drawer (self-assign) ──────────────────────────── */
(function () {
  window.admtOpenCreate = function () {
    document.getElementById('admtCrTitle').value        = '';
    document.getElementById('admtCrDesc').value         = '';
    document.getElementById('admtCrType').value         = 'once';
    document.getElementById('admtCrPriority').value     = 'medium';
    document.getElementById('admtCrDueDate').value      = '';
    document.getElementById('admtCrPattern').value      = 'weekly';
    document.getElementById('admtCrDeadlineTime').value = '';
    document.getElementById('admtCrEndDate').value      = '';
    document.getElementById('admtCrError').style.display = 'none';
    var sb = document.getElementById('admtCrSubmit');
    sb.disabled = false;
    sb.innerHTML = '<i class="bi bi-plus-lg"></i> Create Task';
    document.querySelectorAll('.admt-cr-day').forEach(function(b){ b.classList.remove('sel'); });
    document.querySelectorAll('.admt-cr-date').forEach(function(b){ b.classList.remove('sel'); });
    /* build monthly pills once */
    var pills = document.getElementById('admtCrDatePills');
    if (pills && !pills.children.length) {
      for (var d = 1; d <= 31; d++) {
        var btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'admt-cr-date'; btn.textContent = d; btn.dataset.date = d;
        btn.addEventListener('click', function(){ this.classList.toggle('sel'); });
        pills.appendChild(btn);
      }
    }
    admtCrHandleType();
    admtCrHandlePattern();
    document.getElementById('admtCrOverlay').classList.add('open');
    document.getElementById('admtCrDrawer').classList.add('open');
    setTimeout(function(){ document.getElementById('admtCrTitle').focus(); }, 280);
  };

  window.admtCloseCreate = function () {
    document.getElementById('admtCrOverlay').classList.remove('open');
    document.getElementById('admtCrDrawer').classList.remove('open');
  };

  window.admtCrHandleType = function () {
    var rec = document.getElementById('admtCrType').value === 'recurring';
    document.getElementById('admtCrOnceMeta').style.display    = rec ? 'none'  : 'block';
    document.getElementById('admtCrRecurSection').style.display = rec ? 'flex'  : 'none';
    if (rec) admtCrHandlePattern();
  };

  window.admtCrHandlePattern = function () {
    var pat = document.getElementById('admtCrPattern').value;
    document.getElementById('admtCrWeeklyDays').style.display   = pat === 'weekly'  ? 'block' : 'none';
    document.getElementById('admtCrMonthlyDates').style.display = pat === 'monthly' ? 'block' : 'none';
  };

  document.querySelectorAll('.admt-cr-day').forEach(function(btn){
    btn.addEventListener('click', function(){ this.classList.toggle('sel'); });
  });

  window.admtSubmitCreate = function () {
    var title  = document.getElementById('admtCrTitle').value.trim();
    var errDiv = document.getElementById('admtCrError');
    errDiv.style.display = 'none';
    if (!title) { errDiv.textContent = 'Title is required.'; errDiv.style.display = 'block'; document.getElementById('admtCrTitle').focus(); return; }

    var type    = document.getElementById('admtCrType').value;
    var pattern = document.getElementById('admtCrPattern').value;

    if (type === 'recurring' && pattern !== 'daily') {
      var selDays = pattern === 'weekly'
        ? Array.from(document.querySelectorAll('.admt-cr-day.sel')).map(function(b){ return b.dataset.day; })
        : Array.from(document.querySelectorAll('.admt-cr-date.sel')).map(function(b){ return b.dataset.date; });
      if (!selDays.length) {
        errDiv.textContent = pattern === 'weekly' ? 'Select at least one day of the week.' : 'Select at least one date of the month.';
        errDiv.style.display = 'block'; return;
      }
    }

    var sb = document.getElementById('admtCrSubmit');
    sb.disabled = true; sb.innerHTML = '<i class="bi bi-hourglass-split"></i> Creating…';

    var payload = {
      title:       title,
      description: document.getElementById('admtCrDesc').value.trim(),
      type:        type,
      priority:    document.getElementById('admtCrPriority').value,
      assigned_to: [<%= user.id %>]
    };

    if (type === 'once') {
      var dd = document.getElementById('admtCrDueDate').value;
      if (dd) payload.due_date = dd;
    } else {
      payload.recurrence_pattern = pattern;
      var dt = document.getElementById('admtCrDeadlineTime').value;
      var ed = document.getElementById('admtCrEndDate').value;
      if (dt) payload.deadline_time = dt;
      if (ed) payload.recurrence_end_date = ed;
      if (pattern !== 'daily') {
        var days = pattern === 'weekly'
          ? Array.from(document.querySelectorAll('.admt-cr-day.sel')).map(function(b){ return b.dataset.day; })
          : Array.from(document.querySelectorAll('.admt-cr-date.sel')).map(function(b){ return b.dataset.date; });
        payload.recurrence_days = days.join(',');
      }
    }

    fetch('/tasks/create', {
      method: 'POST', credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      if (data.success) {
        admtCloseCreate();
        window.location.reload();
      } else {
        errDiv.textContent = data.message || 'Failed to create task.';
        errDiv.style.display = 'block';
        sb.disabled = false; sb.innerHTML = '<i class="bi bi-plus-lg"></i> Create Task';
      }
    })
    .catch(function() {
      errDiv.textContent = 'Network error. Please try again.';
      errDiv.style.display = 'block';
      sb.disabled = false; sb.innerHTML = '<i class="bi bi-plus-lg"></i> Create Task';
    });
  };
})();
</script>
