</div>

<!-- Create task drawer -->
<div class="admt-cr-overlay" id="admtCrOverlay" onclick="admtCloseCreate()"></div>
<div class="admt-cr-drawer" id="admtCrDrawer">
  <div class="admt-cr-head">
    <div class="admt-cr-head-title"><i class="bi bi-plus-circle-fill"></i> New Task</div>
    <button class="admt-cr-close" onclick="admtCloseCreate()"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="admt-cr-body">
    <div class="admt-cr-error" id="admtCrError"></div>

    <div>
      <label class="admt-cr-label">Title *</label>
      <input type="text" class="admt-cr-input" id="admtCrTitle" placeholder="Task title" maxlength="255">
    </div>

    <div>
      <label class="admt-cr-label">Description</label>
      <textarea class="admt-cr-textarea" id="admtCrDesc" placeholder="Optional description…"></textarea>
    </div>

    <div class="admt-cr-grid">
      <div>
        <label class="admt-cr-label">Type *</label>
        <select class="admt-cr-select" id="admtCrType" onchange="admtCrHandleType()">
          <option value="once">One-time</option>
          <option value="recurring">Recurring</option>
        </select>
      </div>
      <div>
        <label class="admt-cr-label">Priority *</label>
        <select class="admt-cr-select" id="admtCrPriority">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
