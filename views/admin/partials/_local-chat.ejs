/* ── Edit message ─────────────────────────────────────────────────────────── */
.lcw-bubble.lcw-editing { background: #1e1e1e; border: 1px solid rgba(0,212,255,.25) !important; }
.lcw-edit-ta {
  width: 100%; box-sizing: border-box;
  background: transparent; border: none; outline: none; resize: none;
  font-size: .75rem; font-weight: 300; font-family: inherit;
  color: #e0e0e0; line-height: 1.5; min-height: 34px; max-height: 100px;
  overflow-y: auto; padding: 0;
}
.lcw-edit-ta::-webkit-scrollbar { width: 2px; }
.lcw-edit-btns { display: flex; gap: 5px; margin-top: 6px; }
.lcw-edit-save, .lcw-edit-cancel {
  font-size: .65rem; font-weight: 400; border-radius: 6px;
  padding: 3px 9px; cursor: pointer; font-family: inherit;
  transition: all .12s;
}
.lcw-edit-save {
  background: rgba(0,212,255,.15); border: 1px solid rgba(0,212,255,.3); color: #00d4ff;
}
.lcw-edit-save:hover { background: rgba(0,212,255,.25); }
.lcw-edit-cancel {
  background: rgba(255,255,255,.05); border: 1px solid #2c2c2c; color: #6b7280;
}
.lcw-edit-cancel:hover { background: rgba(255,255,255,.09); color: #ccc; }
.lcw-edited-tag { font-size: .58rem; font-weight: 300; color: #3d3d3d; margin-left: 4px; }
body.adm-light .lcw-edit-ta { color: #1e293b; }
body.adm-light .lcw-edit-save { background: rgba(0,212,255,.08); }
body.adm-light .lcw-edit-cancel { background: rgba(0,0,0,.04); border-color: #e2e8f0; color: #64748b; }
body.adm-light .lcw-edited-tag { color: #94a3b8; }
</style>

<!-- ── Floating Widget ───────────────────────────────────────────────────── -->
<div class="lcw" id="lcwWidget" style="display:none">

  <!-- Header / drag handle -->
  <div class="lcw-hdr" id="lcwHdr">
    <div class="lcw-hdr-l">
      <i class="bi bi-chat-fill lcw-hdr-icon"></i>
      <span class="lcw-hdr-title">Messages</span>
      <span class="lcw-hdr-badge" id="lcwHdrBadge" style="display:none"></span>
    </div>
    <div class="lcw-hdr-r">
      <button class="lcw-ibtn accent" onclick="lcwNewChat()" title="New conversation"><i class="bi bi-pencil-square"></i></button>
      <button class="lcw-ibtn" id="lcwSoundBtn" onclick="lcwToggleSound()" title="Toggle notification sound"><i class="bi bi-volume-up-fill" id="lcwSoundIcon"></i></button>
      <button class="lcw-ibtn" id="lcwMinBtn" onclick="lcwMinimize()" title="Minimize"><i class="bi bi-dash-lg"></i></button>
      <button class="lcw-ibtn" onclick="lcwClose()" title="Close"><i class="bi bi-x-lg"></i></button>
    </div>
  </div>

  <!-- Body -->
  <div class="lcw-body">

    <!-- Sidebar: conversation list -->
    <div class="lcw-sb" id="lcwSb">
      <div class="lcw-sb-search">
        <i class="bi bi-search lcw-sb-search-icon"></i>
        <input class="lcw-search" id="lcwSearch" placeholder="Search…" autocomplete="off"
               oninput="lcwFilterConvs(this.value)">
      </div>
      <div class="lcw-conv-list" id="lcwConvList">
        <div class="lcw-empty">Loading…</div>
      </div>
    </div>

    <!-- Main: placeholder + thread -->
    <div class="lcw-main">

      <div class="lcw-placeholder" id="lcwPh">
        <i class="bi bi-chat-dots"></i>
        <p>Select a conversation or start a new one</p>
      </div>

      <div class="lcw-thread" id="lcwThread">

        <!-- Thread header -->
        <div class="lcw-thread-hdr">
          <button class="lcw-ibtn lcw-back" id="lcwBack" onclick="lcwShowSb()" title="Back"><i class="bi bi-arrow-left"></i></button>
          <div class="lcw-av-wrap" style="flex-shrink:0">
            <div class="lcw-th-av" id="lcwThAv"></div>
          </div>
          <div class="lcw-th-info">
            <div class="lcw-th-name" id="lcwThName"></div>
            <div class="lcw-th-sub" id="lcwThSub"></div>
          </div>
        </div>

        <!-- Messages -->
        <div style="position:relative;flex:1;min-height:0;display:flex;flex-direction:column;">
          <div class="lcw-msgs" id="lcwMsgs">
            <div class="lcw-spin">Loading…</div>
            <div class="lcw-drop" id="lcwDrop">
              <i class="bi bi-cloud-upload-fill"></i>
              <span>Drop files to send</span>
            </div>
          </div>
          <button class="lcw-scroll-btn" id="lcwScrollBtn" onclick="lcwScrollBottom()" style="display:none" title="Scroll to bottom">
            <i class="bi bi-chevron-double-down"></i>
          </button>
        </div>

        <!-- Reply bar -->
        <div class="lcw-reply-bar" id="lcwReplyBar">
          <i class="bi bi-reply-fill lcw-reply-icon"></i>
          <div class="lcw-reply-text" id="lcwReplyText"></div>
          <button class="lcw-ibtn" onclick="lcwCancelReply()"><i class="bi bi-x"></i></button>
        </div>

        <!-- Pending attachments -->
        <div class="lcw-pend-files" id="lcwPendFiles"></div>

        <!-- Input bar -->
        <div class="lcw-input-bar">
          <label class="lcw-ibtn" title="Attach file" style="cursor:pointer">
            <i class="bi bi-paperclip"></i>
            <input type="file" id="lcwFileIn" style="display:none" multiple onchange="lcwFileSelected(event)">
          </label>
          <div class="lcw-input-wrap">
            <div class="lcw-input" id="lcwInput" contenteditable="true" data-ph="Type a message…"
                 onkeydown="lcwKeydown(event)" oninput="lcwInputChange()" onpaste="lcwPaste(event)"></div>
            <div class="lcw-mention-dd" id="lcwMentionDd"></div>
          </div>
          <button class="lcw-send" onclick="lcwSend()" title="Send  (Enter)"><i class="bi bi-send-fill"></i></button>
        </div>

      </div><!-- /lcwThread -->
    </div><!-- /lcw-main -->
  </div><!-- /lcw-body -->
</div><!-- /lcw -->

<!-- New chat overlay + modal -->
<div class="lcw-overlay" id="lcwOverlay" onclick="lcwCloseModal()"></div>
<div class="lcw-modal" id="lcwModal">
  <div class="lcw-modal-hdr">
    <span>New Message</span>
    <button class="lcw-ibtn" onclick="lcwCloseModal()"><i class="bi bi-x-lg"></i></button>
  </div>
  <input class="lcw-modal-search" id="lcwUSearch" placeholder="Search people…"
         autocomplete="off" oninput="lcwFilterUsers(this.value)">
  <div class="lcw-user-list" id="lcwUList"></div>
</div>

<script>
(function(){
'use strict';

/* ── constants ──────────────────────────────────────────────────────────── */
const ME    = <%= user.id %>;
const EMOJIS = ['👍','❤️','😂','😮','😢','🔥','✅','👀','🎉','💯'];
const COLORS = ['#6366f1','#8b5cf6','#ec4899','#f59e0b','#10b981','#3b82f6','#14b8a6','#f97316'];

/* ── state ──────────────────────────────────────────────────────────────── */
let _open = false, _min = false;
let _cid  = null;           // active conversation id
let _convs = [];            // all conversations
let _users = [];            // chatable users (for @mention + modal)
let _replyTo = null;        // { id, sender, preview }
let _pending = [];          // pending File objects
let _hasMore = {};          // convId -> bool
let _loading = false;
let _mentionQ = '';
let _mentionIdx = 0;
let _mentionOn = false;
let _typTimer  = null;
let _dragN = 0;             // dragenter counter
let _px = null, _py = null; // saved widget position
let _onlineUsers = new Set(); // user IDs currently online
let _editMsgId = null;      // message being edited
let _editOrig = '';         // original text before edit
let _editActsHtml = '';     // saved .lcw-acts HTML during edit
let _soundOn = localStorage.getItem('lcw-sound') !== '0'; // sound on by default
let _audioCtx = null;       // Web Audio API context

/* ── helpers ────────────────────────────────────────────────────────────── */
function esc(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function strip(s) { return (s||'').replace(/<[^>]+>/g,''); }
function avatarColor(name) {
  let h=0; for(let c of (name||'?')) h=((h<<5)-h+c.charCodeAt(0))|0;
  return COLORS[Math.abs(h)%COLORS.length];
}
function initials(name) {
  return (name||'?').split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
}
function fmtShort(dt) {
  if (!dt) return '';
  const d = new Date(dt), now = new Date(), diff = now - d;
  if (diff < 60000) return 'now';
  if (diff < 3600000) return Math.floor(diff/60000)+'m';
  if (diff < 86400000) return d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  const y = new Date(now); y.setDate(y.getDate()-1);
  if (d.toDateString()===y.toDateString()) return 'Yesterday';
  return d.toLocaleDateString([],{month:'short',day:'numeric'});
}
function fmtTime(dt) {
  if (!dt) return '';
  return new Date(dt).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
}
function fmtDate(dt) {
  if (!dt) return '';
  const d=new Date(dt), now=new Date();
  if (d.toDateString()===now.toDateString()) return 'Today';
  const y=new Date(now); y.setDate(y.getDate()-1);
  if (d.toDateString()===y.toDateString()) return 'Yesterday';
  return d.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric'});
}
function fmtSize(b) {
  if (!b) return '';
  if (b<1024) return b+' B';
  if (b<1024*1024) return (b/1024).toFixed(1)+' KB';
  return (b/(1024*1024)).toFixed(1)+' MB';
}
function fileIcon(mime) {
  if (!mime) return 'bi bi-file-earmark';
  if (mime.startsWith('image/')) return 'bi bi-file-image';
  if (mime.startsWith('video/')) return 'bi bi-file-play';
  if (mime.startsWith('audio/')) return 'bi bi-file-music';
  if (mime.includes('pdf')) return 'bi bi-file-pdf';
  if (mime.includes('word')||mime.includes('document')) return 'bi bi-file-word';
  if (mime.includes('sheet')||mime.includes('excel')||mime.includes('csv')) return 'bi bi-file-excel';
  if (mime.includes('zip')||mime.includes('compressed')) return 'bi bi-file-zip';
  return 'bi bi-file-earmark';
}
function api(url, opts={}) {
  opts.headers = Object.assign({'X-Requested-With':'XMLHttpRequest'}, opts.headers||{});
  return fetch(url, opts).then(r=>r.json());
}

/* ── open / close / minimize ─────────────────────────────────────────────── */
window.lcwToggle  = ()=>_open ? lcwClose() : lcwOpen();
window.lcwClose   = ()=>{ _open=false; $('lcwWidget').style.display='none'; $('admChatBtn').classList.remove('lcw-on'); };
window.lcwMinimize= ()=>{
  _min=!_min;
  $('lcwWidget').classList.toggle('lcw-min',_min);
  $('lcwMinBtn').innerHTML = _min ? '<i class="bi bi-chevron-up"></i>' : '<i class="bi bi-dash-lg"></i>';
};
window.lcwOpen = async ()=>{
  _open=true;
  const w=$('lcwWidget');
  w.style.display='flex'; w.style.flexDirection='column';
  $('admChatBtn').classList.add('lcw-on');
  restorePos();
  if (!_convs.length) await loadConvs();
  if (!_users.length) await loadUsers();
};

function $(id)  { return document.getElementById(id); }
function $$(sel){ return document.querySelector(sel); }

/* ── drag to reposition ──────────────────────────────────────────────────── */
function restorePos() {
  const w=$('lcwWidget');
  try {
    const s=localStorage.getItem('lcwPos');
    if (s) { const {x,y}=JSON.parse(s); applyPos(x,y); return; }
  } catch(e){}
  w.style.cssText += ';bottom:70px;right:20px;left:auto;top:auto';
}
function applyPos(x,y) {
  const w=$('lcwWidget');
  const mw=w.offsetWidth||740, mh=48;
  x=Math.max(10,Math.min(x,window.innerWidth-mw-10));
  y=Math.max(10,Math.min(y,window.innerHeight-mh-10));
  w.style.left=x+'px'; w.style.top=y+'px';
  w.style.right='auto'; w.style.bottom='auto';
  _px=x; _py=y;
}
let _drag=false,_ox=0,_oy=0;
$('lcwHdr').addEventListener('mousedown',e=>{
  if (e.target.closest('.lcw-ibtn')) return;
  _drag=true;
  const r=$('lcwWidget').getBoundingClientRect();
  _ox=e.clientX-r.left; _oy=e.clientY-r.top;
  $('lcwWidget').style.transition='none';
  e.preventDefault();
});
document.addEventListener('mousemove',e=>{ if(!_drag) return; applyPos(e.clientX-_ox,e.clientY-_oy); });
document.addEventListener('mouseup', ()=>{
  if(!_drag) return; _drag=false;
  if(_px!==null) localStorage.setItem('lcwPos',JSON.stringify({x:_px,y:_py}));
});

/* ── load conversations ──────────────────────────────────────────────────── */
async function loadConvs() {
  try {
    const j = await api('/chat/conversations');
    _convs = j.data.conversations || [];
    renderConvList();
    updateBadge();
  } catch(e){ console.error('lcw convs',e); }
}

/* ── load users (for @mention + new chat modal) ─────────────────────────── */
async function loadUsers() {
  try {
    const j = await api('/chat/users');
    _users = j.data.users || [];
  } catch(e) {
    // fallback: extract from conversations
    const seen=new Set([ME]);
    _convs.forEach(c=>(c.participants||[]).forEach(p=>{ if(!seen.has(p.id)){ seen.add(p.id); _users.push(p); } }));
  }
}

/* ── conversation list rendering ─────────────────────────────────────────── */
function convName(c) {
  if (c.type==='group') return c.group_name||'Group';
  const o=(c.participants||[]).find(p=>p.id!==ME);
  return o ? o.name : c.group_name||'Chat';
}
function renderConvList(q='') {
  const el=$('lcwConvList');
  let list=_convs;
  if (q) { const lq=q.toLowerCase(); list=list.filter(c=>convName(c).toLowerCase().includes(lq)); }
  if (!list.length) { el.innerHTML=`<div class="lcw-empty">${q?'No results':'No conversations yet'}</div>`; return; }
  el.innerHTML = list.map(c=>{
    const name=convName(c), grp=c.type==='group';
    const col=avatarColor(name), ini=initials(name);
    const unread=c.unread_count||0;
    const preview=strip(c.last_message||'').slice(0,38)||(c.last_message_sender?c.last_message_sender+': ':'')||'';
    const time=fmtShort(c.last_message_at||c.updated_at);
    const active=c.id===_cid?'lcw-active':'';
    const muted=c.is_muted?'lcw-muted':'';
    const otherId=!grp?((c.participants||[]).find(p=>p.id!==ME)||{}).id:null;
    const online=otherId&&_onlineUsers.has(otherId);
    return `<div class="lcw-conv-item ${active} ${muted}" data-cid="${c.id}" onclick="lcwOpenConv(${c.id})">
      <div class="lcw-av-wrap">
        <div class="lcw-av ${grp?'lcw-av-g':''}" style="background:${col}">${ini}</div>
        ${online?'<span class="lcw-online-dot"></span>':''}
      </div>
      <div class="lcw-conv-meta">
        <div class="lcw-conv-name">${esc(name)}</div>
        <div class="lcw-conv-preview">${esc(preview)||'<em style="opacity:.4">No messages yet</em>'}</div>
      </div>
      <div class="lcw-conv-r">
        <span class="lcw-conv-time">${time}</span>
        ${unread&&!c.is_muted?`<span class="lcw-unread-badge">${unread>99?'99+':unread}</span>`:''}
      </div>
    </div>`;
  }).join('');
}
window.lcwFilterConvs = q => renderConvList(q);

/* ── open conversation ───────────────────────────────────────────────────── */
window.lcwOpenConv = async function(cid) {
  _cid = cid;
  document.querySelectorAll('.lcw-conv-item').forEach(el=>el.classList.toggle('lcw-active', el.dataset.cid==cid));
  $('lcwPh').style.display='none';
  $('lcwThread').classList.add('lcw-show');
  // narrow mode: hide sidebar, show back btn
  if ($('lcwWidget').offsetWidth < 600) {
    $('lcwSb').style.display='none';
    $('lcwBack').style.display='flex';
  }
  const conv=_convs.find(c=>c.id===cid);
  if (conv) setThreadHeader(conv);
  // join socket room
  if (typeof admBdrSock!=='undefined'&&admBdrSock) admBdrSock.emit('chat:join', cid);
  // clear + load messages
  $('lcwMsgs').innerHTML='<div class="lcw-spin">Loading…</div><div class="lcw-drop" id="lcwDrop"><i class="bi bi-cloud-upload-fill"></i><span>Drop files to send</span></div>';
  bindDrop();
  bindScroll();
  await loadMsgs(cid, null, true);
  lcwCancelReply();
  setTimeout(()=>$('lcwInput').focus(), 80);
};

function setThreadHeader(c) {
  const name=convName(c), grp=c.type==='group';
  const col=avatarColor(name);
  // Avatar wrapper with optional online dot
  const avWrap=$('lcwThAv').parentElement;
  const o=grp?null:(c.participants||[]).find(p=>p.id!==ME);
  const online=!grp&&o&&_onlineUsers.has(o.id);
  // Remove any existing dot
  avWrap.querySelectorAll('.lcw-online-dot').forEach(d=>d.remove());
  const av=$('lcwThAv');
  av.style.background=col; av.textContent=initials(name);
  av.style.borderRadius=grp?'8px':'50%';
  if (online) {
    const dot=document.createElement('span');
    dot.className='lcw-online-dot';
    avWrap.appendChild(dot);
  }
  $('lcwThName').textContent=name;
  if (grp) {
    $('lcwThSub').textContent=(c.participants||[]).length+' members';
  } else {
    const role=(o?(o.role_name||'').replace('LOCAL_',''):'');
    $('lcwThSub').innerHTML=online
      ? `<span style="color:#10b981">● Online</span>${role?' · '+role:''}`
      : role;
  }
}
window.lcwShowSb = ()=>{ $('lcwSb').style.display=''; $('lcwBack').style.display='none'; };

/* ── load messages ───────────────────────────────────────────────────────── */
async function loadMsgs(cid, beforeId=null, fresh=false) {
  try {
    let url=`/chat/conversations/${cid}/messages`;
    if (beforeId) url+=`?before=${beforeId}`;
    const j = await api(url);
    const msgs = j.data.messages||[];
    _hasMore[cid] = msgs.length>=50;
    const el=$('lcwMsgs');
    if (fresh) {
      el.innerHTML='<div class="lcw-drop" id="lcwDrop"><i class="bi bi-cloud-upload-fill"></i><span>Drop files to send</span></div>';
      bindDrop();
      if (_hasMore[cid]) el.insertAdjacentHTML('afterbegin','<div class="lcw-load-more" onclick="lcwLoadMore()">Load earlier messages</div>');
      renderMsgs(msgs, el, true);
      el.scrollTop=el.scrollHeight;
    } else {
      const prevH=el.scrollHeight;
      const firstMsg=el.querySelector('.lcw-row');
      renderMsgsBefore(msgs, el, firstMsg);
      el.scrollTop=el.scrollHeight-prevH;
      if (!_hasMore[cid]) { const lm=el.querySelector('.lcw-load-more'); if(lm) lm.remove(); }
    }
    // mark read
    api(`/chat/conversations/${cid}/read`,{method:'POST',headers:{'Content-Type':'application/json'}});
    const conv=_convs.find(c=>c.id===cid);
    if(conv){ conv.unread_count=0; renderConvList($('lcwSearch').value); updateBadge(); }
  } catch(e){ console.error('lcw msgs',e); }
}

window.lcwLoadMore = async function() {
  if (_loading||!_cid) return;
  const first=$('lcwMsgs').querySelector('.lcw-row');
  if (!first) return;
  _loading=true;
  await loadMsgs(_cid, first.dataset.mid, false);
  _loading=false;
};

/* ── message rendering ───────────────────────────────────────────────────── */
function renderMsgs(msgs, container, append=true) {
  let lastDate=null, lastSid=null, lastTs=null;
  const frag=document.createDocumentFragment();
  msgs.forEach(m=>{
    const ds=fmtDate(m.created_at);
    if (ds!==lastDate) {
      const d=document.createElement('div'); d.className='lcw-date-div';
      d.innerHTML=`<span>${ds}</span>`; frag.appendChild(d);
      lastDate=ds; lastSid=null; lastTs=null;
    }
    const ts=new Date(m.created_at);
    const grp=lastSid===m.sender_id && lastTs && (ts-lastTs)<120000;
    const el=document.createElement('div');
    el.innerHTML=msgHtml(m, grp); frag.appendChild(el.firstElementChild);
    lastSid=m.sender_id; lastTs=ts;
  });
  container.appendChild(frag);
}

function renderMsgsBefore(msgs, container, beforeEl) {
  if (!msgs.length) return;
  let lastDate=null, lastSid=null, lastTs=null;
  const frag=document.createDocumentFragment();
  msgs.forEach(m=>{
    const ds=fmtDate(m.created_at);
    if(ds!==lastDate){ const d=document.createElement('div'); d.className='lcw-date-div'; d.innerHTML=`<span>${ds}</span>`; frag.appendChild(d); lastDate=ds; lastSid=null; lastTs=null; }
    const ts=new Date(m.created_at);
    const grp=lastSid===m.sender_id&&lastTs&&(ts-lastTs)<120000;
    const el=document.createElement('div'); el.innerHTML=msgHtml(m,grp); frag.appendChild(el.firstElementChild);
    lastSid=m.sender_id; lastTs=ts;
  });
  if (beforeEl) container.insertBefore(frag, beforeEl);
  else container.insertBefore(frag, container.querySelector('.lcw-drop'));
}

function msgHtml(m, grp) {
  const mine=m.sender_id===ME;
  const col=avatarColor(m.sender_name||'?');
  const grpCls=grp?'lcw-grp':'';
  const mineCls=mine?'lcw-mine':'';

  // reply strip
  let replyHtml='';
  if (m.reply_to_id && !m.reply_deleted) {
    replyHtml=`<div class="lcw-reply-strip"><strong>${esc(m.reply_sender_name||'')}</strong> ${esc((m.reply_preview||'').slice(0,70))}</div>`;
  }

  // body
  let body='';
  if (m.is_deleted) {
    body=`<span class="lcw-deleted">Message deleted</span>`;
  } else if (m.attachment_drive_id) {
    body=attachHtml(m);
  } else {
    body=renderContent(m.content||'');
  }

  // reactions
  let reacts='';
  if (m.reactions && Object.keys(m.reactions).length) {
    reacts='<div class="lcw-reacts">'+
      Object.entries(m.reactions).map(([em,users])=>
        `<span class="lcw-react ${(users||[]).includes(ME)?'lcw-reacted':''}"
          onclick="lcwToggleReact(${m.id},'${em}',this)"
          title="${esc((users||[]).join(', '))}">${em} <small>${users.length}</small></span>`
      ).join('')+'</div>';
  }

  // read tick
  const tick = mine ? (m.is_read
    ? '<i class="bi bi-check2-all lcw-tick-read"></i>'
    : '<i class="bi bi-check2 lcw-tick-sent"></i>') : '';

  const editedTag = m.is_edited ? '<span class="lcw-edited-tag"> · edited</span>' : '';
  return `<div class="lcw-row ${mineCls} ${grpCls}" data-mid="${m.id}">
    <div class="lcw-row-av" style="background:${col}">${initials(m.sender_name||'?')}</div>
    <div class="lcw-row-body">
      <div class="lcw-row-sender">${esc(m.sender_name||'')}</div>
      ${replyHtml}
      <div class="lcw-bubble" data-mid="${m.id}" data-orig="${esc(m.content||'')}">
        ${body}${editedTag}
        <div class="lcw-acts">
          <button class="lcw-act" onclick="lcwReply(${m.id},'${esc(m.sender_name||'')}','${esc((m.content||'').slice(0,60).replace(/'/g,"\\'"))}')" title="Reply"><i class="bi bi-reply-fill"></i></button>
          <button class="lcw-act" onclick="lcwEmojiPicker(${m.id},this)" title="React"><i class="bi bi-emoji-smile"></i></button>
          ${mine&&!m.is_deleted&&!m.attachment_drive_id?`<button class="lcw-act" onclick="lcwEditMsg(${m.id})" title="Edit"><i class="bi bi-pencil"></i></button>`:''}
          ${mine&&!m.is_deleted?`<button class="lcw-act danger" onclick="lcwDelMsg(${m.id},this)" title="Delete"><i class="bi bi-trash3"></i></button>`:''}
        </div>
      </div>
      ${reacts}
      <div class="lcw-row-foot">${fmtTime(m.created_at)} ${tick}</div>
    </div>
  </div>`;
}

function attachHtml(m) {
  const mime=m.attachment_mime||'', name=m.attachment_name||'File', link=m.attachment_link||'#';
  const cap=m.content ? renderContent(m.content)+'<br>' : '';
  if (mime.startsWith('image/')) {
    return `${cap}<img class="lcw-img" src="${esc(link)}" alt="${esc(name)}"
      onclick="window.open('${esc(link)}','_blank')" loading="lazy">`;
  }
  return `${cap}<a class="lcw-file" href="${esc(link)}" target="_blank" rel="noopener">
    <i class="${fileIcon(mime)} lcw-file-icon"></i>
    <div class="lcw-file-info">
      <div class="lcw-file-name">${esc(name)}</div>
      ${m.attachment_size?`<div class="lcw-file-size">${fmtSize(m.attachment_size)}</div>`:''}
    </div>
  </a>`;
}

function renderContent(text) {
  let out=esc(text);
  // linkify URLs
  out=out.replace(/(https?:\/\/[^\s<>"&]+)/g,'<a href="$1" target="_blank" rel="noopener">$1</a>');
  // @mentions
  out=out.replace(/@([\w][^\s@]{0,29})/g,'<span class="lcw-mention">@$1</span>');
  // newlines
  out=out.replace(/\n/g,'<br>');
  return out;
}

/* ── send ────────────────────────────────────────────────────────────────── */
window.lcwSend = async function() {
  if (!_cid) return;
  const inp=$('lcwInput');
  const text=inp.innerText.trim();
  if (!text && !_pending.length) return;
  inp.innerHTML=''; closeMention();

  // upload pending files
  for (const f of _pending) {
    const isLast = _pending.indexOf(f)===_pending.length-1;
    await uploadFile(f, (isLast && text) ? text : null);
    if (isLast && text) { clearPending(); return; }
  }
  clearPending();

  // send text
  if (text) {
    const url = _replyTo
      ? `/chat/conversations/${_cid}/reply`
      : `/chat/conversations/${_cid}/messages`;
    const body = _replyTo
      ? {content:text, reply_to_id:_replyTo.id}
      : {content:text};
    const saved=_replyTo;
    lcwCancelReply();
    try {
      const j=await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
      if (j.data&&j.data.message) { appendMsg(j.data.message); updateConvPreview(_cid,j.data.message); }
    } catch(e){ console.error('lcw send',e); }
  }
};

function appendMsg(m) {
  const el=$('lcwMsgs');
  const tmp=document.createElement('div');
  tmp.innerHTML=msgHtml(m,false);
  el.appendChild(tmp.firstElementChild);
  el.scrollTop=el.scrollHeight;
}

/* ── file upload ─────────────────────────────────────────────────────────── */
window.lcwFileSelected = e=>{
  _pending.push(...Array.from(e.target.files));
  renderPending(); e.target.value='';
};
function renderPending() {
  const el=$('lcwPendFiles');
  if (!_pending.length) { el.classList.remove('lcw-show'); el.innerHTML=''; return; }
  el.classList.add('lcw-show');
  el.innerHTML=_pending.map((f,i)=>`<div class="lcw-pend-file">
    <i class="${fileIcon(f.type)}"></i>
    <span>${esc(f.name)}</span>
    <button class="lcw-pend-rm" onclick="lcwRmPend(${i})"><i class="bi bi-x"></i></button>
  </div>`).join('');
}
function clearPending() { _pending=[]; renderPending(); }
window.lcwRmPend = i=>{ _pending.splice(i,1); renderPending(); };
async function uploadFile(file, caption) {
  const fd=new FormData(); fd.append('file',file);
  if (caption) fd.append('content',caption);
  try {
    const j=await api(`/chat/conversations/${_cid}/attach-local`,{
      method:'POST', headers:{}, body:fd
    });
    if (j.data&&j.data.message) { appendMsg(j.data.message); updateConvPreview(_cid,j.data.message); }
  } catch(e){ console.error('lcw upload',e); }
}

/* ── drag & drop ─────────────────────────────────────────────────────────── */
function bindDrop() {
  const el=$('lcwMsgs'), dz=$('lcwDrop');
  if (!el||!dz) return;
  el.addEventListener('dragenter',e=>{ e.preventDefault(); _dragN++; if(_cid) dz.classList.add('lcw-dropping'); });
  el.addEventListener('dragleave',()=>{ _dragN--; if(_dragN<=0){ _dragN=0; dz.classList.remove('lcw-dropping'); } });
  el.addEventListener('dragover', e=>e.preventDefault());
  el.addEventListener('drop', e=>{
    e.preventDefault(); _dragN=0; dz.classList.remove('lcw-dropping');
    if (!_cid) return;
    _pending.push(...Array.from(e.dataTransfer.files));
    renderPending();
  });
}

/* ── paste images ────────────────────────────────────────────────────────── */
window.lcwPaste = e=>{
  const items=e.clipboardData&&e.clipboardData.items;
  if (!items) return;
  for (const it of items) {
    if (it.kind==='file'&&it.type.startsWith('image/')) {
      e.preventDefault();
      const f=it.getAsFile(); if(f){ _pending.push(f); renderPending(); }
    }
  }
};

