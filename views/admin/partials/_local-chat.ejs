/* ── notification sound ──────────────────────────────────────────────────── */
function playSound() {
  if (!_soundOn) return;
  try {
    if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (_audioCtx.state === 'suspended') _audioCtx.resume();
    const osc  = _audioCtx.createOscillator();
    const gain = _audioCtx.createGain();
    osc.connect(gain); gain.connect(_audioCtx.destination);
    osc.type = 'sine';
    osc.frequency.setValueAtTime(880, _audioCtx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(440, _audioCtx.currentTime + 0.15);
    gain.gain.setValueAtTime(0.14, _audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, _audioCtx.currentTime + 0.32);
    osc.start(_audioCtx.currentTime);
    osc.stop(_audioCtx.currentTime + 0.32);
  } catch(_) {}
}
window.lcwToggleSound = ()=>{
  _soundOn = !_soundOn;
  localStorage.setItem('lcw-sound', _soundOn ? '1' : '0');
  const icon = $('lcwSoundIcon');
  if (icon) icon.className = _soundOn ? 'bi bi-volume-up-fill' : 'bi bi-volume-mute-fill';
  const btn = $('lcwSoundBtn');
  if (btn) btn.style.color = _soundOn ? '' : '#4b5563';
  if (btn) btn.title = _soundOn ? 'Mute notification sound' : 'Unmute notification sound';
};
// Init button state on load
(()=>{
  const icon=$('lcwSoundIcon'); if(icon&&!_soundOn) icon.className='bi bi-volume-mute-fill';
  const btn=$('lcwSoundBtn'); if(btn&&!_soundOn){ btn.style.color='#4b5563'; btn.title='Unmute notification sound'; }
})();

/* ── socket listeners ────────────────────────────────────────────────────── */
// admBdrSock is defined later in layout.ejs (line ~2005), after this partial is
// included. Defer listener attachment to DOMContentLoaded so the socket exists.
document.addEventListener('DOMContentLoaded', function() {
  var socket = typeof admBdrSock !== 'undefined' ? admBdrSock : null;
  if (!socket) return;

  socket.on('chat:message', ({conversation_id, message})=>{
    updateConvPreview(conversation_id, message, true);
    updateBadge();
    if (_cid===conversation_id && _open && !_min) {
      appendMsg(message);
      api(`/chat/conversations/${conversation_id}/read`,{method:'POST',headers:{'Content-Type':'application/json'}});
    } else {
      playSound();
    }
  });

  socket.on('chat:typing', d=>{
    if (d.conversation_id!==_cid || d.user_id===ME) return;
    showTyping(d.user_name);
  });

  socket.on('chat:message_edited', ({message:m})=>{
    if (_editMsgId===m.id) return;
    const bubble=document.querySelector(`.lcw-bubble[data-mid="${m.id}"]`);
    if (!bubble) return;
    bubble.dataset.orig=m.content||'';
    const actsHtml=bubble.querySelector('.lcw-acts')?.outerHTML||'';
    bubble.innerHTML=renderContent(m.content||'')+'<span class="lcw-edited-tag"> · edited</span>'+actsHtml;
  });

  socket.on('chat:message_deleted', ({message_id})=>{
    const bubble=document.querySelector(`.lcw-bubble[data-mid="${message_id}"]`);
    if (!bubble) return;
    const actsHtml=bubble.querySelector('.lcw-acts')?.outerHTML||'';
    bubble.innerHTML='<span class="lcw-deleted">Message deleted</span>'+actsHtml;
  });

  socket.on('channel:presence', ({user_id, online})=>{
    if (online) _onlineUsers.add(user_id); else _onlineUsers.delete(user_id);
    renderConvList($('lcwSearch').value);
    if (_cid) {
      const conv=_convs.find(c=>c.id===_cid);
      if (conv&&conv.type==='direct') {
        const other=(conv.participants||[]).find(p=>p.id!==ME);
        if (other&&other.id===user_id) setThreadHeader(conv);
      }
    }
  });
});

/* ── update sidebar preview ──────────────────────────────────────────────── */
function updateConvPreview(cid, msg, incUnread=false) {
  const c=_convs.find(x=>x.id===cid);
  if (c) {
    c.last_message=msg.content||(msg.attachment_name?'[Attachment]':'');
    c.last_message_at=msg.created_at;
    if (incUnread&&cid!==_cid) c.unread_count=(c.unread_count||0)+1;
    const idx=_convs.indexOf(c);
    if (idx>0) { _convs.splice(idx,1); _convs.unshift(c); }
    renderConvList($('lcwSearch').value);
  } else {
    loadConvs(); // new conversation — refresh list
  }
}

/* ── badge ───────────────────────────────────────────────────────────────── */
function updateBadge() {
  const total=_convs.reduce((s,c)=>s+(c.unread_count||0),0);
  const b1=$('lcwTopBadge'), b2=$('lcwHdrBadge');
  [b1,b2].forEach(b=>{ if(!b) return; b.textContent=total>99?'99+':total; b.style.display=total?'':'none'; });
}

/* ── new chat modal ──────────────────────────────────────────────────────── */
window.lcwNewChat = async ()=>{
  if (!_users.length) await loadUsers();
  renderUserList();
  $('lcwOverlay').classList.add('lcw-show');
  $('lcwModal').classList.add('lcw-show');
  setTimeout(()=>$('lcwUSearch').focus(),80);
};
window.lcwCloseModal = ()=>{
  $('lcwOverlay').classList.remove('lcw-show');
  $('lcwModal').classList.remove('lcw-show');
};
function renderUserList(q='') {
  const el=$('lcwUList');
  let list=_users;
  if (q) { const lq=q.toLowerCase(); list=list.filter(u=>u.name.toLowerCase().includes(lq)); }
  if (!list.length) { el.innerHTML='<div class="lcw-empty">No users found</div>'; return; }
  el.innerHTML=list.map(u=>`<div class="lcw-uitem" onclick="lcwStartChat(${u.id})">
    <div class="lcw-av" style="background:${avatarColor(u.name)};width:32px;height:32px;font-size:.64rem">${initials(u.name)}</div>
    <div><div class="lcw-uitem-name">${esc(u.name)}</div><div class="lcw-uitem-role">${esc((u.role_name||'').replace('LOCAL_','').replace('CLIENT_',''))}</div></div>
  </div>`).join('');
}
window.lcwFilterUsers = q=>renderUserList(q);

window.lcwStartChat = async uid=>{
  lcwCloseModal();
  try {
    const j=await api('/chat/conversations',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({participant_ids:[uid]})
    });
    if (j.data&&j.data.conversation_id) {
      await loadConvs();
      lcwOpenConv(j.data.conversation_id);
    }
  } catch(e){ console.error('lcw start',e); }
};

/* ── init: fetch unread count for topbar badge ───────────────────────────── */
(async ()=>{
  try {
    const j=await api('/chat/unread-count');
    const n=j.data&&j.data.count?j.data.count:0;
    const b=$('lcwTopBadge');
    if (b&&n) { b.textContent=n>99?'99+':n; b.style.display=''; }
  } catch(e){}
})();

})();
</script>
