/* ── edit message ─────────────────────────────────────────────────────────── */
window.lcwEditMsg = (msgId)=>{
  if (_editMsgId) lcwCancelEdit(); // close any open edit first
  const bubble=document.querySelector(`.lcw-bubble[data-mid="${msgId}"]`);
  if (!bubble||bubble.classList.contains('lcw-editing')) return;
  _editMsgId=msgId;
  _editOrig=bubble.dataset.orig||'';
  _editActsHtml=bubble.querySelector('.lcw-acts')?.outerHTML||'';
  bubble.classList.add('lcw-editing');
  bubble.innerHTML=`<textarea class="lcw-edit-ta" onkeydown="lcwEditKey(event)"></textarea>
    <div class="lcw-edit-btns">
      <button class="lcw-edit-save" onclick="lcwSaveEdit()">Save</button>
      <button class="lcw-edit-cancel" onclick="lcwCancelEdit()">Cancel</button>
    </div>${_editActsHtml}`;
  const ta=bubble.querySelector('.lcw-edit-ta');
  ta.value=_editOrig;
  ta.style.height='auto';
  ta.style.height=Math.min(ta.scrollHeight,100)+'px';
  ta.focus();
  ta.selectionStart=ta.selectionEnd=ta.value.length;
};
window.lcwEditKey = e=>{
  if (e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); lcwSaveEdit(); }
  if (e.key==='Escape') lcwCancelEdit();
};
window.lcwSaveEdit = async ()=>{
  if (!_editMsgId) return;
  const bubble=document.querySelector(`.lcw-bubble[data-mid="${_editMsgId}"]`);
  if (!bubble) return;
  const ta=bubble.querySelector('.lcw-edit-ta');
  const newText=ta?.value.trim();
  if (!newText){ lcwCancelEdit(); return; }
  if (newText===_editOrig){ lcwCancelEdit(); return; }
  const mid=_editMsgId, origText=_editOrig, actsHtml=_editActsHtml;
  _editMsgId=null; _editOrig=''; _editActsHtml='';
  bubble.classList.remove('lcw-editing');
  try {
    const j=await api(`/chat/messages/${mid}`,{
      method:'PATCH',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({content:newText})
    });
    if (j.data&&j.data.message) {
      bubble.dataset.orig=newText;
      bubble.innerHTML=renderContent(newText)+'<span class="lcw-edited-tag"> · edited</span>'+actsHtml;
    } else {
      bubble.dataset.orig=origText;
      bubble.innerHTML=renderContent(origText)+actsHtml;
    }
  } catch(e){
    console.error('lcw edit',e);
    bubble.dataset.orig=origText;
    bubble.innerHTML=renderContent(origText)+actsHtml;
  }
};
window.lcwCancelEdit = ()=>{
  if (!_editMsgId) return;
  const bubble=document.querySelector(`.lcw-bubble[data-mid="${_editMsgId}"]`);
  if (bubble) {
    bubble.classList.remove('lcw-editing');
    bubble.innerHTML=renderContent(_editOrig)+_editActsHtml;
  }
  _editMsgId=null; _editOrig=''; _editActsHtml='';
};

/* ── @mention ─────────────────────────────────────────────────────────────── */
window.lcwInputChange = ()=>{ handleMention(); lcwTyping(); };
function handleMention() {
  // @mention only makes sense in group chats
  const conv=_convs.find(c=>c.id===_cid);
  if (!conv || conv.type!=='group') { closeMention(); return; }
  const inp=$('lcwInput');
  const sel=window.getSelection();
  if (!sel.rangeCount) return;
  const rng=sel.getRangeAt(0);
  const node=rng.startContainer;
  if (node.nodeType!==Node.TEXT_NODE) { closeMention(); return; }
  const txt=node.textContent, pos=rng.startOffset;
  const before=txt.slice(0,pos);
  const atIdx=before.lastIndexOf('@');
  if (atIdx!==-1 && (atIdx===0||/\s/.test(before[atIdx-1]))) {
    const q=before.slice(atIdx+1);
    if (!q.includes(' ')&&q.length<=20) {
      _mentionQ=q; _mentionOn=true;
      showMentionDd(q); return;
    }
  }
  closeMention();
}
function showMentionDd(q) {
  const dd=$('lcwMentionDd');
  const list=_users.filter(u=>u.name.toLowerCase().includes(q.toLowerCase())).slice(0,7);
  if (!list.length) { closeMention(); return; }
  _mentionIdx=Math.min(_mentionIdx,list.length-1);
  dd.innerHTML=list.map((u,i)=>`<div class="lcw-mitem ${i===_mentionIdx?'lcw-msel':''}" onmousedown="lcwPickMention('${esc(u.name)}')" data-i="${i}">
    <div class="lcw-av" style="background:${avatarColor(u.name)};width:22px;height:22px;font-size:.52rem">${initials(u.name)}</div>
    <div><div>${esc(u.name)}</div><div class="lcw-mitem-role">${esc((u.role_name||'').replace('LOCAL_','').replace('CLIENT_',''))}</div></div>
  </div>`).join('');
  dd.classList.add('lcw-show');
}
window.lcwPickMention = name=>{
  const inp=$('lcwInput');
  const sel=window.getSelection(); if(!sel.rangeCount) return;
  const rng=sel.getRangeAt(0), node=rng.startContainer;
  if (node.nodeType!==Node.TEXT_NODE) { closeMention(); return; }
  const txt=node.textContent, pos=rng.startOffset, before=txt.slice(0,pos);
  const atIdx=before.lastIndexOf('@');
  if (atIdx!==-1) {
    node.textContent=txt.slice(0,atIdx)+'@'+name+' '+txt.slice(pos);
    const nr=document.createRange();
    nr.setStart(node,atIdx+name.length+2); nr.collapse(true);
    sel.removeAllRanges(); sel.addRange(nr);
  }
  closeMention();
};
function closeMention() { _mentionOn=false; _mentionIdx=0; $('lcwMentionDd').classList.remove('lcw-show'); }

window.lcwKeydown = e=>{
  if (_mentionOn) {
    const dd=$('lcwMentionDd'), items=dd.querySelectorAll('.lcw-mitem');
    if (e.key==='ArrowDown') { e.preventDefault(); _mentionIdx=Math.min(_mentionIdx+1,items.length-1); items.forEach((el,i)=>el.classList.toggle('lcw-msel',i===_mentionIdx)); return; }
    if (e.key==='ArrowUp')   { e.preventDefault(); _mentionIdx=Math.max(_mentionIdx-1,0); items.forEach((el,i)=>el.classList.toggle('lcw-msel',i===_mentionIdx)); return; }
    if (e.key==='Enter'||e.key==='Tab') { e.preventDefault(); const a=dd.querySelector('.lcw-msel'); if(a) a.dispatchEvent(new MouseEvent('mousedown')); return; }
    if (e.key==='Escape') { closeMention(); return; }
  }
  if (e.key==='Enter'&&!e.shiftKey) { e.preventDefault(); lcwSend(); }
};

/* ── typing indicator ────────────────────────────────────────────────────── */
window.lcwTyping = ()=>{
  if (!_cid||typeof admBdrSock==='undefined'||!admBdrSock) return;
  admBdrSock.emit('chat:typing',{conversation_id:_cid});
};
function showTyping(name) {
