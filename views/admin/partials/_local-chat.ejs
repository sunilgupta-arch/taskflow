<%# ── Local Chat Floating Widget ────────────────────────────────────────────── %>
<style>
/* ── Widget shell ─────────────────────────────────────────────────────────── */
.lcw {
  position: fixed;
  bottom: 70px; right: 20px;
  width: 740px; height: 520px;
  display: flex; flex-direction: column;
  background: #1a1a1a;
  border: 1px solid #2c2c2c;
  border-radius: 14px;
  box-shadow: 0 28px 70px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.04);
  z-index: 8500;
  overflow: hidden;
  font-family: 'Inter','Segoe UI',system-ui,sans-serif;
  font-weight: 300;
  transition: height .2s cubic-bezier(.4,0,.2,1);
  user-select: none;
}
.lcw.lcw-min { height: 46px; }
.lcw.lcw-min .lcw-body { display: none; }

/* ── Header (drag handle) ─────────────────────────────────────────────────── */
.lcw-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 10px; height: 46px;
  background: #161616; border-bottom: 1px solid #2c2c2c;
  border-radius: 14px 14px 0 0;
  cursor: grab; flex-shrink: 0;
}
.lcw-hdr:active { cursor: grabbing; }
.lcw-hdr-l { display: flex; align-items: center; gap: 8px; }
.lcw-hdr-icon { color: #00d4ff; font-size: .8rem; }
.lcw-hdr-title { font-size: .74rem; font-weight: 500; color: #e0e0e0; letter-spacing: .2px; }
.lcw-hdr-badge {
  background: #ef4444; color: #fff;
  font-size: .58rem; font-weight: 700;
  border-radius: 10px; padding: 1px 6px;
  min-width: 18px; text-align: center;
}
.lcw-hdr-r { display: flex; align-items: center; gap: 2px; }

/* ── Generic icon button ──────────────────────────────────────────────────── */
.lcw-ibtn {
  background: none; border: none; cursor: pointer;
  width: 28px; height: 28px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center;
  color: #555; font-size: .76rem;
  transition: background .12s, color .12s;
}
.lcw-ibtn:hover { background: rgba(255,255,255,.07); color: #e0e0e0; }
.lcw-ibtn.accent { color: #00d4ff; }

/* ── Body ─────────────────────────────────────────────────────────────────── */
.lcw-body { display: flex; flex: 1; overflow: hidden; min-height: 0; }

/* ── Sidebar ──────────────────────────────────────────────────────────────── */
.lcw-sb {
  width: 240px; min-width: 240px;
  border-right: 1px solid #2c2c2c;
  display: flex; flex-direction: column;
  background: #141414;
}
.lcw-sb-search {
  padding: 9px 10px; border-bottom: 1px solid #2c2c2c;
  position: relative; flex-shrink: 0;
}
.lcw-sb-search-icon {
  position: absolute; left: 19px; top: 50%; transform: translateY(-50%);
  color: #444; font-size: .68rem; pointer-events: none;
}
.lcw-search {
  width: 100%; box-sizing: border-box;
  background: #1e1e1e; border: 1px solid #2c2c2c; border-radius: 8px;
  padding: 6px 10px 6px 28px;
  font-size: .73rem; font-weight: 300; font-family: inherit;
  color: #ddd; outline: none;
  transition: border-color .15s;
}
.lcw-search:focus { border-color: rgba(0,212,255,.35); }
.lcw-search::placeholder { color: #3d3d3d; }

.lcw-conv-list { flex: 1; overflow-y: auto; }
.lcw-conv-list::-webkit-scrollbar { width: 3px; }
.lcw-conv-list::-webkit-scrollbar-thumb { background: #2c2c2c; border-radius: 2px; }

.lcw-conv-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; cursor: pointer;
  border-bottom: 1px solid rgba(255,255,255,.025);
  transition: background .1s;
  border-left: 2px solid transparent;
}
.lcw-conv-item:hover { background: rgba(255,255,255,.035); }
.lcw-conv-item.lcw-active { background: rgba(0,212,255,.05); border-left-color: #00d4ff; }
.lcw-conv-item.lcw-muted { opacity: .5; }

.lcw-av {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .7rem; color: #fff; flex-shrink: 0;
}
.lcw-av-g { border-radius: 9px; }

.lcw-conv-meta { flex: 1; min-width: 0; }
.lcw-conv-name {
  font-size: .76rem; font-weight: 400; color: #ccc;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lcw-conv-preview {
  font-size: .66rem; font-weight: 300; color: #555; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lcw-conv-r { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.lcw-conv-time { font-size: .6rem; font-weight: 300; color: #3d3d3d; }
.lcw-unread-badge {
  background: #00d4ff; color: #000;
  font-size: .58rem; font-weight: 700;
  border-radius: 10px; padding: 1px 6px; min-width: 18px; text-align: center;
}

.lcw-empty { padding: 24px 14px; text-align: center; color: #3d3d3d; font-size: .72rem; }

/* ── Main area ────────────────────────────────────────────────────────────── */
.lcw-main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #1a1a1a; }

.lcw-placeholder {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 10px;
}
.lcw-placeholder i { font-size: 2.2rem; color: #252525; }
.lcw-placeholder p { font-size: .74rem; font-weight: 300; color: #3a3a3a; margin: 0; }

/* ── Thread ───────────────────────────────────────────────────────────────── */
.lcw-thread { display: none; flex-direction: column; flex: 1; min-height: 0; }
.lcw-thread.lcw-show { display: flex; }

.lcw-thread-hdr {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; border-bottom: 1px solid #2c2c2c;
  background: #141414; flex-shrink: 0;
}
.lcw-back { display: none; }
.lcw-th-av {
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .63rem; color: #fff; flex-shrink: 0;
}
.lcw-th-info { flex: 1; min-width: 0; }
.lcw-th-name { font-size: .77rem; font-weight: 500; color: #e0e0e0; }
.lcw-th-sub { font-size: .63rem; font-weight: 300; color: #555; margin-top: 1px; }

/* ── Messages area ────────────────────────────────────────────────────────── */
.lcw-msgs {
  flex: 1; overflow-y: auto; padding: 10px 12px;
  display: flex; flex-direction: column; gap: 1px;
  position: relative;
}
.lcw-msgs::-webkit-scrollbar { width: 3px; }
.lcw-msgs::-webkit-scrollbar-thumb { background: #2c2c2c; border-radius: 2px; }

.lcw-load-more {
  align-self: center; font-size: .65rem; font-weight: 300; color: #00d4ff;
  cursor: pointer; padding: 3px 14px;
  border: 1px solid #2c2c2c; border-radius: 20px;
  background: #1e1e1e; margin-bottom: 6px; transition: border-color .15s;
}
.lcw-load-more:hover { border-color: #00d4ff; }

.lcw-date-div {
  text-align: center; margin: 6px 0 2px; position: relative;
}
.lcw-date-div span {
  background: #1a1a1a; position: relative; z-index: 1;
  color: #3d3d3d; font-size: .6rem; font-weight: 300; padding: 0 10px;
}
.lcw-date-div::before {
  content: ''; position: absolute; top: 50%; left: 0; right: 0;
  height: 1px; background: #262626;
}

/* Message row */
.lcw-row { display: flex; gap: 7px; padding: 2px 0; }
.lcw-row.lcw-mine { flex-direction: row-reverse; }
.lcw-row.lcw-grp { padding-top: 1px; }
.lcw-row.lcw-grp .lcw-row-av { visibility: hidden; }

.lcw-row-av {
  width: 26px; height: 26px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: .56rem; color: #fff; flex-shrink: 0; margin-top: 3px;
}
.lcw-row-body { max-width: 74%; display: flex; flex-direction: column; }
.lcw-mine .lcw-row-body { align-items: flex-end; }

.lcw-row-sender {
  font-size: .61rem; font-weight: 400; color: #555; margin-bottom: 2px; padding: 0 3px;
}
.lcw-grp .lcw-row-sender { display: none; }

.lcw-reply-strip {
  background: rgba(255,255,255,.04); border-left: 2px solid #555;
  border-radius: 5px; padding: 3px 8px; font-size: .63rem; font-weight: 300;
  color: #555; margin-bottom: 3px; max-width: 100%;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lcw-reply-strip strong { color: #a78bfa; font-weight: 400; }

.lcw-bubble {
  background: #232323; border-radius: 12px;
  padding: 7px 11px;
  font-size: .75rem; font-weight: 300; color: #ccc;
  line-height: 1.55; word-break: break-word;
  position: relative; max-width: 100%;
}
.lcw-mine .lcw-bubble { background: rgba(0,212,255,.1); border: 1px solid rgba(0,212,255,.12); color: #ddd; }
.lcw-bubble a { color: #00d4ff; text-decoration: none; }
.lcw-bubble a:hover { text-decoration: underline; }
.lcw-mention { color: #a78bfa; font-weight: 400; }
.lcw-deleted { color: #3d3d3d; font-size: .7rem; font-style: italic; }

/* Image in bubble */
.lcw-img {
  max-width: 220px; max-height: 160px; border-radius: 8px;
  display: block; margin-top: 5px; cursor: zoom-in; object-fit: cover;
}

/* File attachment in bubble */
.lcw-file {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,.04); border: 1px solid #2c2c2c; border-radius: 9px;
  padding: 8px 10px; margin-top: 5px; text-decoration: none; max-width: 230px;
  transition: border-color .15s;
}
.lcw-file:hover { border-color: #00d4ff; }
.lcw-file-icon { font-size: 1.1rem; color: #555; flex-shrink: 0; }
.lcw-file-info { min-width: 0; }
.lcw-file-name { font-size: .68rem; font-weight: 400; color: #ccc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 170px; }
.lcw-file-size { font-size: .6rem; font-weight: 300; color: #555; margin-top: 1px; }

/* Message actions (hover) */
.lcw-acts {
  position: absolute; top: -16px; right: 6px;
  background: #1e1e1e; border: 1px solid #2c2c2c; border-radius: 9px;
  display: flex; gap: 1px; padding: 2px;
  opacity: 0; pointer-events: none; transition: opacity .12s; z-index: 5;
}
.lcw-bubble:hover .lcw-acts { opacity: 1; pointer-events: auto; }
.lcw-act {
  background: none; border: none; cursor: pointer; color: #555;
  width: 22px; height: 22px; border-radius: 5px;
  display: flex; align-items: center; justify-content: center;
  font-size: .62rem; transition: all .12s;
}
.lcw-act:hover { background: rgba(255,255,255,.07); color: #e0e0e0; }
.lcw-act.danger:hover { color: #ef4444; }

/* Reactions */
.lcw-reacts { display: flex; flex-wrap: wrap; gap: 3px; margin-top: 3px; }
.lcw-react {
  background: rgba(255,255,255,.04); border: 1px solid #2c2c2c; border-radius: 10px;
  padding: 1px 6px; font-size: .7rem; cursor: pointer;
  display: flex; align-items: center; gap: 3px; color: #777;
  transition: background .12s;
}
.lcw-react:hover { background: rgba(255,255,255,.09); }
.lcw-react.lcw-reacted { border-color: rgba(0,212,255,.4); background: rgba(0,212,255,.07); }

/* Timestamp + tick */
.lcw-row-foot {
  display: flex; align-items: center; gap: 4px;
  margin-top: 2px; padding: 0 3px;
  font-size: .59rem; font-weight: 300; color: #3a3a3a;
}
.lcw-mine .lcw-row-foot { justify-content: flex-end; }
.lcw-tick-sent { color: #3d3d3d; font-size: .7rem; }
.lcw-tick-read { color: #00d4ff; font-size: .7rem; }

/* Typing dots */
.lcw-typing {
  display: flex; align-items: center; gap: 5px; padding: 4px 0;
  font-size: .63rem; color: #555; font-weight: 300;
}
.lcw-dot {
  width: 5px; height: 5px; background: #444; border-radius: 50%;
  animation: lcwPulse 1.2s ease-in-out infinite;
}
.lcw-dot:nth-child(2) { animation-delay: .2s; }
.lcw-dot:nth-child(3) { animation-delay: .4s; }
@keyframes lcwPulse {
  0%,60%,100% { transform: scale(1); opacity: .4; }
  30%          { transform: scale(1.5); opacity: 1; }
}

/* Drop zone overlay */
.lcw-drop {
  position: absolute; inset: 0;
  background: rgba(0,212,255,.07); border: 2px dashed #00d4ff;
  border-radius: 10px; display: none;
  flex-direction: column; align-items: center; justify-content: center;
  gap: 10px; color: #00d4ff; font-size: .82rem; font-weight: 400;
  pointer-events: none; z-index: 20;
}
.lcw-drop.lcw-dropping { display: flex; }
.lcw-drop i { font-size: 2rem; }

/* Spinner */
.lcw-spin { padding: 20px; text-align: center; color: #3d3d3d; font-size: .7rem; font-weight: 300; }

/* ── Reply bar ────────────────────────────────────────────────────────────── */
.lcw-reply-bar {
  display: none; align-items: center; gap: 8px;
  padding: 6px 12px; border-top: 1px solid #2c2c2c; background: #141414; flex-shrink: 0;
}
.lcw-reply-bar.lcw-show { display: flex; }
.lcw-reply-icon { color: #a78bfa; font-size: .8rem; flex-shrink: 0; }
.lcw-reply-text {
  flex: 1; font-size: .67rem; font-weight: 300; color: #555;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lcw-reply-text strong { color: #a78bfa; font-weight: 400; }

/* ── Pending files row ────────────────────────────────────────────────────── */
.lcw-pend-files {
  display: none; flex-wrap: wrap; gap: 6px;
  padding: 6px 12px 0; flex-shrink: 0;
}
.lcw-pend-files.lcw-show { display: flex; }
.lcw-pend-file {
  display: flex; align-items: center; gap: 5px;
  background: rgba(255,255,255,.04); border: 1px solid #2c2c2c;
  border-radius: 8px; padding: 4px 8px;
  font-size: .67rem; font-weight: 300; color: #888; max-width: 180px;
}
.lcw-pend-file span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lcw-pend-rm { background: none; border: none; color: #555; cursor: pointer; padding: 0; font-size: .72rem; flex-shrink: 0; }
.lcw-pend-rm:hover { color: #ef4444; }

/* ── Input bar ────────────────────────────────────────────────────────────── */
.lcw-input-bar {
  display: flex; align-items: flex-end; gap: 6px;
  padding: 9px 12px; border-top: 1px solid #2c2c2c;
  background: #141414; flex-shrink: 0;
}
.lcw-input-wrap { flex: 1; position: relative; }
.lcw-input {
  width: 100%; box-sizing: border-box;
  min-height: 34px; max-height: 110px;
  background: #1e1e1e; border: 1px solid #2c2c2c; border-radius: 10px;
  padding: 8px 12px;
  font-size: .75rem; font-weight: 300; font-family: inherit;
  color: #e0e0e0; outline: none; line-height: 1.5;
  overflow-y: auto; white-space: pre-wrap; word-break: break-word;
  transition: border-color .15s;
}
.lcw-input:focus { border-color: rgba(0,212,255,.3); }
.lcw-input:empty::before { content: attr(data-ph); color: #3d3d3d; pointer-events: none; }
.lcw-input::-webkit-scrollbar { width: 3px; }
.lcw-input::-webkit-scrollbar-thumb { background: #2c2c2c; }

/* @mention dropdown */
.lcw-mention-dd {
  position: absolute; bottom: calc(100% + 5px); left: 0; right: 0;
  background: #1c1c1c; border: 1px solid #2c2c2c; border-radius: 10px;
  overflow: hidden; max-height: 170px; overflow-y: auto;
  z-index: 100; box-shadow: 0 10px 28px rgba(0,0,0,.5);
  display: none;
}
.lcw-mention-dd.lcw-show { display: block; }
.lcw-mitem {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; cursor: pointer;
  font-size: .73rem; font-weight: 300; color: #ccc;
  transition: background .1s; border-bottom: 1px solid rgba(255,255,255,.03);
}
.lcw-mitem:last-child { border-bottom: none; }
.lcw-mitem:hover, .lcw-mitem.lcw-msel { background: rgba(0,212,255,.07); }
.lcw-mitem .lcw-av { width: 22px; height: 22px; font-size: .52rem; }
.lcw-mitem-role { font-size: .6rem; color: #444; font-weight: 300; }

/* Send button */
.lcw-send {
  width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
  background: rgba(0,212,255,.13); border: 1px solid rgba(0,212,255,.28);
  color: #00d4ff; cursor: pointer; font-size: .8rem;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s;
}
.lcw-send:hover { background: rgba(0,212,255,.22); }

/* ── New chat modal ───────────────────────────────────────────────────────── */
.lcw-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.5); backdrop-filter: blur(3px);
  z-index: 9100; display: none;
}
.lcw-overlay.lcw-show { display: block; }
.lcw-modal {
  position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 340px; max-height: 500px;
  background: #1a1a1a; border: 1px solid #2c2c2c; border-radius: 14px;
  display: none; flex-direction: column;
  z-index: 9200; box-shadow: 0 28px 70px rgba(0,0,0,.7);
  font-family: inherit; font-weight: 300;
}
.lcw-modal.lcw-show { display: flex; }
.lcw-modal-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px 12px; border-bottom: 1px solid #2c2c2c; flex-shrink: 0;
  font-size: .78rem; font-weight: 500; color: #e0e0e0;
}
.lcw-modal-search {
  margin: 10px; box-sizing: border-box;
  background: #1e1e1e; border: 1px solid #2c2c2c; border-radius: 9px;
  padding: 8px 12px; width: calc(100% - 20px);
  font-size: .74rem; font-weight: 300; font-family: inherit;
  color: #e0e0e0; outline: none; flex-shrink: 0;
  transition: border-color .15s;
}
.lcw-modal-search:focus { border-color: rgba(0,212,255,.4); }
.lcw-modal-search::placeholder { color: #3d3d3d; }
.lcw-user-list { flex: 1; overflow-y: auto; padding: 4px 0; }
.lcw-user-list::-webkit-scrollbar { width: 3px; }
.lcw-user-list::-webkit-scrollbar-thumb { background: #2c2c2c; }
.lcw-uitem {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 14px; cursor: pointer; transition: background .1s;
}
.lcw-uitem:hover { background: rgba(255,255,255,.04); }
.lcw-uitem .lcw-av { width: 32px; height: 32px; font-size: .64rem; }
.lcw-uitem-name { font-size: .76rem; font-weight: 400; color: #ccc; }
.lcw-uitem-role { font-size: .61rem; font-weight: 300; color: #555; margin-top: 1px; }

/* ── Topbar button ────────────────────────────────────────────────────────── */
.lcw-topbtn {
  position: relative; background: none;
  border: 1px solid #2c2c2c; color: #666; border-radius: 8px;
  width: 32px; height: 32px; cursor: pointer; font-size: .82rem;
  display: flex; align-items: center; justify-content: center;
  transition: all .15s;
}
.lcw-topbtn:hover { border-color: #00d4ff; color: #00d4ff; }
.lcw-topbtn.lcw-on { border-color: #00d4ff; color: #00d4ff; background: rgba(0,212,255,.07); }
.lcw-topbtn-badge {
  position: absolute; top: -5px; right: -5px;
  background: #ef4444; color: #fff;
  font-size: .54rem; font-weight: 700;
  border-radius: 10px; padding: 1px 4px; min-width: 14px; text-align: center;
  border: 2px solid #1a1a1a; display: none;
}

/* ── Light theme overrides ────────────────────────────────────────────────── */
body.adm-light .lcw { background: #f8fafc; border-color: #e2e8f0; box-shadow: 0 16px 44px rgba(0,0,0,.14); }
body.adm-light .lcw-hdr { background: #f1f5f9; border-color: #e2e8f0; }
body.adm-light .lcw-hdr-title { color: #1e293b; }
body.adm-light .lcw-sb { background: #f1f5f9; border-color: #e2e8f0; }
body.adm-light .lcw-sb-search { border-color: #e2e8f0; }
body.adm-light .lcw-search { background: #fff; border-color: #e2e8f0; color: #1e293b; }
body.adm-light .lcw-search::placeholder { color: #94a3b8; }
body.adm-light .lcw-search-icon { color: #94a3b8; }
body.adm-light .lcw-conv-item:hover { background: rgba(0,0,0,.03); }
body.adm-light .lcw-conv-item.lcw-active { background: rgba(0,212,255,.05); }
body.adm-light .lcw-conv-name { color: #1e293b; }
body.adm-light .lcw-conv-preview, body.adm-light .lcw-conv-time { color: #64748b; }
body.adm-light .lcw-main { background: #f8fafc; }
body.adm-light .lcw-thread-hdr { background: #f1f5f9; border-color: #e2e8f0; }
body.adm-light .lcw-th-name { color: #1e293b; }
body.adm-light .lcw-th-sub { color: #64748b; }
body.adm-light .lcw-msgs { background: #f8fafc; }
body.adm-light .lcw-date-div span { background: #f8fafc; color: #94a3b8; }
body.adm-light .lcw-date-div::before { background: #e2e8f0; }
body.adm-light .lcw-bubble { background: #fff; border: 1px solid #e2e8f0; color: #334155; }
