  function _renderDrawerPreviews() {
    var strip = document.getElementById('admqDrawerChatPreviews');
    if (!_drawerPendingFiles.length) { strip.innerHTML = ''; return; }
    strip.innerHTML = _drawerPendingFiles.map(function(pf, i) {
