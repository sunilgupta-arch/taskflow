  window.admqDrawerSend = function() {
    var id = _detailId;
    if (!id) return;
    var body = document.getElementById('admqDrawerInput').value.trim();
    if (!body && !_drawerPendingFiles.length) return;
    var btn = document.getElementById('admqDrawerSend');
    btn.disabled = true;
    var fd = new FormData();
    fd.append('body', body);
    _drawerPendingFiles.forEach(function(pf){ fd.append('files', pf.file, pf.name); });
    fetch('/queue/'+id+'/chat', { method:'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(res) {
        if (!res.success) { alert(res.message || 'Failed to send'); return; }
        document.getElementById('admqDrawerInput').value = '';
        document.getElementById('admqDrawerInput').style.height = 'auto';
        _drawerPendingFiles = [];
        _renderDrawerPreviews();
        return fetch('/queue/'+id+'/detail').then(function(r2){ return r2.json(); }).then(function(d) {
          if (d.success) {
            var comments = d.data.comments || [];
            _renderDrawerMessages(comments);
            document.getElementById('admqDrawerChatCount').textContent = comments.length ? '('+comments.length+')' : '';
            loadDate(_date);
          }
        });
      })
      .catch(function(){ alert('Network error'); })
      .finally(function(){ btn.disabled = false; });
  };

  document.getElementById('admqDrawerFileInput').addEventListener('change', function() {
    _addDrawerFiles(this.files); this.value = '';
  });
  document.getElementById('admqDrawerInput').addEventListener('paste', function(e) {
    var items = (e.clipboardData || e.originalEvent.clipboardData).items;
    Array.prototype.forEach.call(items, function(item) {
      if (item.type.startsWith('image/')) {
        e.preventDefault();
        _addDrawerFiles([item.getAsFile()]);
      }
    });
  });
  document.getElementById('admqDrawerInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); admqDrawerSend(); }
  });
  document.getElementById('admqDrawerInput').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 130) + 'px';
  });

  function _admqCollapseDetails() {
    var drawer = document.getElementById('admqDrawer');
    if (drawer.classList.contains('chat-focused')) return;
    drawer.classList.add('chat-focused');
    // Compute full remaining height for chat section
    var headerH = drawer.querySelector('.admq-drawer-header').offsetHeight;
    document.getElementById('admqDrawerChat').style.height = (drawer.offsetHeight - headerH) + 'px';
    document.getElementById('admqDrawerExpandBtn').style.display = 'inline-flex';
  }
  function _admqExpandDetails() {
    var drawer = document.getElementById('admqDrawer');
    drawer.classList.remove('chat-focused');
    document.getElementById('admqDrawerChat').style.height = '380px';
    document.getElementById('admqDrawerExpandBtn').style.display = 'none';
  }
  window.admqDrawerExpandDetail = function() { _admqExpandDetails(); };

  document.getElementById('admqDrawerInput').addEventListener('focus', function() {
    _admqCollapseDetails();
    setTimeout(function() {
      var box = document.getElementById('admqDrawerMessages');
      box.scrollTop = box.scrollHeight;
    }, 300);
  });
  // Re-expand only if input is fully empty and blurred away from entire chat section
  document.getElementById('admqDrawerInput').addEventListener('blur', function() {
    var self = this;
    setTimeout(function() {
      var active = document.activeElement;
      var chat = document.getElementById('admqDrawerChat');
      if (!self.value.trim() && !chat.contains(active)) {
        _admqExpandDetails();
      }
    }, 180);
  });

  window.admqOpenChat = function(instanceId) {
    _chatInstanceId = instanceId;
    _chatPendingFiles = [];
    document.getElementById('admqChatInput').value = '';
    document.getElementById('admqChatPreviews').innerHTML = '';
    document.getElementById('admqChatMessages').innerHTML = '<div class="admqc-empty"><div class="admq-spinner"></div></div>';
    var inst = _loadedInstances.find(function(i){ return i.id === instanceId; });
    var titleEl = document.getElementById('admqChatTitle');
    titleEl.innerHTML = esc(inst ? inst.title : 'Request')+'<small>Correspondence</small>';
    document.getElementById('admqChatModal').style.display = 'flex';
    setTimeout(function(){ document.getElementById('admqChatInput').focus(); }, 80);
    // Load comments
    fetch('/queue/'+instanceId+'/detail').then(function(r){ return r.json(); }).then(function(res) {
      if (res.success) _renderChatMessages(res.data.comments);
    }).catch(function() {
      document.getElementById('admqChatMessages').innerHTML = '<div class="admqc-empty">Failed to load messages.</div>';
    });
  };

  window.admqCloseChat = function() {
    document.getElementById('admqChatModal').style.display = 'none';
    _chatInstanceId = null;
    _chatPendingFiles = [];
  };

  window.admqSendChat = function() {
    var id = _chatInstanceId;
    if (!id) return;
    var body = document.getElementById('admqChatInput').value.trim();
    if (!body && !_chatPendingFiles.length) return;
    var btn = document.getElementById('admqChatSend');
    btn.disabled = true;
    var fd = new FormData();
    fd.append('body', body);
    _chatPendingFiles.forEach(function(pf){ fd.append('files', pf.file, pf.name); });
    fetch('/queue/'+id+'/chat', { method:'POST', body: fd })
      .then(function(r){ return r.json(); })
      .then(function(res) {
        if (!res.success) { alert(res.message || 'Failed to send'); return; }
        document.getElementById('admqChatInput').value = '';
        _chatPendingFiles = [];
        _renderPreviews();
        // Reload comments in modal
        return fetch('/queue/'+id+'/detail').then(function(r2){ return r2.json(); }).then(function(d) {
          if (d.success) { _renderChatMessages(d.data.comments); loadDate(_date); }
        });
      })
      .catch(function(){ alert('Network error'); })
      .finally(function(){ btn.disabled = false; });
  };

  // File picker
  document.getElementById('admqChatFileInput').addEventListener('change', function() {
    _addFiles(this.files);
    this.value = '';
  });

  // Paste image from clipboard
  document.getElementById('admqChatInput').addEventListener('paste', function(e) {
    var items = (e.clipboardData || e.originalEvent.clipboardData).items;
    var hasImage = false;
    Array.prototype.forEach.call(items, function(item) {
      if (item.type.startsWith('image/')) {
        hasImage = true;
        e.preventDefault();
        _addFiles([item.getAsFile()]);
      }
    });
  });

  // Ctrl+Enter to send
  document.getElementById('admqChatInput').addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); admqSendChat(); }
  });

  // Auto-resize textarea
  document.getElementById('admqChatInput').addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 110) + 'px';
  });

  // Close on backdrop click
  document.getElementById('admqChatModal').addEventListener('click', function(e) {
    if (e.target === this) admqCloseChat();
  });

  // ── Detail drawer ────────────────────────────────────────────────────
  window.admqOpenDetail = function(id) {
    _detailId = id;
    document.getElementById('admqOverlay').style.display = '';
    document.getElementById('admqDrawer').classList.add('open');
    document.getElementById('admqDrawerBody').innerHTML = '<div class="admq-loading"><div class="admq-spinner"></div></div>';
    document.getElementById('admqDrawerActions').style.display = 'none';
    fetch('/queue/'+id+'/detail').then(function(r){return r.json();}).then(function(res){
      if (!res.success) { document.getElementById('admqDrawerBody').innerHTML = '<div style="color:var(--adm-muted);padding:16px;font-size:0.85rem">Failed to load detail.</div>'; return; }
      renderDetail(res.data);
    });
  };
  window.admqCloseDetail = function() {
    document.getElementById('admqOverlay').style.display = 'none';
    document.getElementById('admqDrawer').classList.remove('open');
    document.getElementById('admqDrawerChat').style.display = 'none';
    _admqExpandDetails();
    _drawerPendingFiles = [];
    _renderDrawerPreviews();
    _detailId = null;
  };

  function renderDetail(data) {
    var inst=data.instance, history=data.history||[], comments=data.comments||[], attachments=data.attachments||[];
    var past = isPast(_date);

    document.getElementById('admqDrawerTitle').innerHTML = '<i class="bi bi-clipboard2-check"></i>&nbsp;'+esc(inst.title);

    // Action buttons
    var actEl = document.getElementById('admqDrawerActions'), btns = '';
    if (inst.status === 'missed' || (past && inst.status === 'open')) {
      btns = '<button class="admq-drawer-btn pick" onclick="admqPick('+inst.id+')"><i class="bi bi-hand-index"></i> Pick Up (Late)</button>';
    } else if (!past) {
      if (inst.status==='open') {
        btns = '<button class="admq-drawer-btn pick" onclick="admqPick('+inst.id+')"><i class="bi bi-hand-index"></i> Pick Up</button>';
      } else if (inst.status==='picked') {
        if (inst.picked_by===_userId) {
          btns = '<button class="admq-drawer-btn done" onclick="admqDone('+inst.id+')"><i class="bi bi-check-lg"></i> Mark Done</button>'
               + '<button class="admq-drawer-btn release" onclick="admqOpenRelease('+inst.id+')"><i class="bi bi-arrow-counterclockwise"></i> Release</button>';
        } else if (isAdmin()) {
          btns = '<button class="admq-drawer-btn done" onclick="admqDone('+inst.id+')"><i class="bi bi-check-lg"></i> Mark Done</button>';
        }
      }
    } else if (past && inst.status === 'picked') {
      if (inst.picked_by === _userId || isAdmin()) {
        btns = '<button class="admq-drawer-btn done" onclick="admqDone('+inst.id+')"><i class="bi bi-check-lg"></i> Mark Done (Late)</button>'
             + '<button class="admq-drawer-btn release" onclick="admqOpenRelease('+inst.id+')"><i class="bi bi-arrow-counterclockwise"></i> Release</button>';
      }
    }
    if (btns) { actEl.innerHTML = btns; actEl.style.display = ''; } else { actEl.style.display = 'none'; }

    // Info grid
    var html = '<div><div class="admq-section-label">Details</div><div class="admq-info-grid">'
      +'<div class="admq-info-item"><div class="admq-info-key">Status</div><div class="admq-info-val">'+statusHtml(inst.status, inst.completed_late)+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Priority</div><div class="admq-info-val">'+priorityHtml(inst.priority)+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Type</div><div class="admq-info-val">'+esc(inst.task_type||'—')+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Due Time</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.8rem">'+(inst.due_time||'—')+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Client</div><div class="admq-info-val">'+esc(inst.client_org_name||'—')+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Raised By</div><div class="admq-info-val">'+esc(inst.created_by_name||'—')+'</div></div>'
      +'<div class="admq-info-item"><div class="admq-info-key">Submitted</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.78rem">'+fmtTs(inst.created_at)+'</div></div>'
      +(inst.picked_by_name?'<div class="admq-info-item"><div class="admq-info-key">Picked By</div><div class="admq-info-val">'+esc(inst.picked_by_name)+'</div></div>':'')
      +(inst.picked_at?'<div class="admq-info-item"><div class="admq-info-key">Picked At</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.78rem">'+fmtTs(inst.picked_at)+'</div></div>':'')
      +(inst.completed_at?'<div class="admq-info-item"><div class="admq-info-key">Completed At</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.78rem">'+fmtTs(inst.completed_at)+'</div></div>':'')
      +(fmtDuration(inst.picked_at,inst.completed_at)?'<div class="admq-info-item"><div class="admq-info-key">Time Taken</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.82rem;color:#10b981">'+fmtDuration(inst.picked_at,inst.completed_at)+'</div></div>':'')
      +'<div class="admq-info-item"><div class="admq-info-key">Scheduled For</div><div class="admq-info-val" style="font-family:var(--adm-mono);font-size:0.8rem">'+fmtDate(inst.instance_date)+'</div></div>'
      +(inst.rescheduled_from_date
        ? '<div class="admq-info-item" style="grid-column:1/-1"><div class="admq-info-key">Rescheduled From</div><div class="admq-info-val" style="display:flex;align-items:center;gap:8px"><span style="font-family:var(--adm-mono);font-size:0.8rem;color:#8b5cf6">'+fmtDate(inst.rescheduled_from_date)+'</span>'+(inst.rescheduled_by_name?'<span style="font-size:0.78rem;color:var(--adm-muted)">by '+esc(inst.rescheduled_by_name)+'</span>':'')+'</div></div>'
        : '')
      +'</div></div>';

    // Description
    if (inst.description) {
      html += '<div><div class="admq-section-label">Description</div><div class="admq-description">'+esc(inst.description)+'</div></div>';
    }

    // Attachments
    var ADMQ_IMG_EXTS = ['jpg','jpeg','png','gif','webp','bmp','svg','avif'];
    function admqRenderAttachment(a) {
      var ext = (a.file_name||'').split('.').pop().toLowerCase();
      var proxyUrl = '/queue/attachments/' + a.id;
      var viewUrl  = a.drive_view_link || proxyUrl;
      if (ADMQ_IMG_EXTS.indexOf(ext) !== -1) {
        return '<a href="'+proxyUrl+'" target="_blank" style="display:inline-block;margin-bottom:6px;border-radius:10px;overflow:hidden;border:1px solid var(--adm-border,#1a3050);background:var(--adm-surface-2,#132540)">'
          +'<img src="'+proxyUrl+'" style="display:block;max-width:500px;max-height:500px;width:100%;height:auto;object-fit:contain" alt="'+esc(a.file_name)+'" loading="lazy"></a>';
      }
      return '<a class="admq-attach-item" href="'+viewUrl+'" target="_blank"><i class="bi '+fileIcon(a.file_name)+'" style="font-size:1.1rem;flex-shrink:0"></i><span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(a.file_name)+'</span><i class="bi bi-box-arrow-up-right" style="font-size:0.7rem;color:var(--adm-muted)"></i></a>';
    }
    var attItems = attachments.length
      ? attachments.map(admqRenderAttachment).join('')
      : '<div style="font-size:0.78rem;color:var(--adm-muted)">No attachments yet</div>';
    var uploadBtn = !past ? '<input type="file" id="admqFileInput" style="display:none" onchange="admqUpload('+inst.id+')">'
      +'<label class="admq-upload-label" for="admqFileInput"><i class="bi bi-paperclip"></i> Attach file</label>' : '';
    html += '<div><div class="admq-section-label">Attachments</div><div class="admq-attach-list">'+attItems+'</div>'+uploadBtn+'</div>';

    // Release history
    if (history.length) {
      html += '<div><div class="admq-section-label">Release History</div><div class="admq-history-list">'
        +history.map(function(h){ return '<div class="admq-history-item"><div class="admq-history-dot"></div><div><div>Released by <strong>'+esc(h.released_by_name||'')+'</strong>'+(h.reason?' — '+esc(h.reason):'')+'</div><div class="admq-history-time">'+fmtTs(h.released_at)+'</div></div></div>'; }).join('')
        +'</div></div>';
    }

    document.getElementById('admqDrawerBody').innerHTML = html;

    // Populate inline chat section
    _renderDrawerMessages(comments);
    document.getElementById('admqDrawerChatCount').textContent = comments.length ? '(' + comments.length + ')' : '';
    document.getElementById('admqDrawerChat').style.display = '';
  }

  // ── Comment & Upload ─────────────────────────────────────────────────
  window.admqSubmitComment = function(id) {
