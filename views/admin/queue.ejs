// ── Description tooltip ──────────────────────────────────────────────
(function() {
  var tt      = document.getElementById('admqTooltip');
  var timer   = null;
  var DELAY   = 400;

  function tipEsc(s) { var d=document.createElement('div'); d.appendChild(document.createTextNode(s||'')); return d.innerHTML; }
  function show(cell) {
    var desc  = cell.getAttribute('data-tooltip');
    var title = cell.getAttribute('data-tip-title');
    if (!title && !desc) return;
    if (title) {
      tt.innerHTML = '<div style="font-weight:600;font-size:0.82rem;margin-bottom:'+(desc?'5px':'0')+'">'+tipEsc(title)+'</div>'
        + (desc ? '<div style="color:var(--adm-muted,#445e78);font-size:0.77rem;line-height:1.5">'+tipEsc(desc)+'</div>' : '');
    } else {
      tt.textContent = desc;
    }
    var r    = cell.getBoundingClientRect();
    var top  = r.bottom + 8;
    var left = r.left;
    // Keep within viewport horizontally
    if (left + 310 > window.innerWidth) left = window.innerWidth - 318;
    // Flip above row if too close to bottom
    if (top + 120 > window.innerHeight) top = r.top - 8 - tt.offsetHeight;
    tt.style.top  = top + 'px';
    tt.style.left = left + 'px';
    tt.classList.add('visible');
  }

  function hide() {
    clearTimeout(timer);
    tt.classList.remove('visible');
  }

  document.addEventListener('mouseover', function(e) {
    var cell = e.target.closest('td[data-tooltip]');
    if (!cell) { hide(); return; }
    clearTimeout(timer);
    timer = setTimeout(function() { show(cell); }, DELAY);
  });

  document.addEventListener('mouseout', function(e) {
    if (e.target.closest('td[data-tooltip]')) hide();
  });

  // Hide on scroll or drawer open
  document.addEventListener('scroll', hide, true);
})();

// ── Search & Filter offcanvas ─────────────────────────────────────────────
var admqSF = (function() {
  var page = 1, hasMore = false, loading = false, total = 0;
  var optionsLoaded = false;
  var observer = null;

  function esc(s) { var d=document.createElement('div'); d.appendChild(document.createTextNode(s||'')); return d.innerHTML; }

  function fmtDate(d) {
    if (!d) return '—';
    var p = String(d).split('-');
    if (p.length < 3) return d;
    var m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return m[parseInt(p[1])-1]+' '+parseInt(p[2])+', '+p[0];
  }

  function priorityHtml(p) {
    var colors = {high:'#ef4444', urgent:'#ef4444', normal:'#f59e0b', medium:'#f59e0b', low:'#6b7280'};
    var col = colors[p] || '#6b7280';
    return '<span style="display:inline-flex;align-items:center;gap:5px;font-size:0.76rem;color:'+col+'"><span style="width:7px;height:7px;border-radius:50%;background:'+col+'"></span>'+(p||'—')+'</span>';
  }

  function statusHtml(s, late) {
    var map = {
      open:   {lbl:'Open',        col:'#f97316', bg:'rgba(249,115,22,0.1)'},
      picked: {lbl:'In Progress', col:'#3b82f6', bg:'rgba(59,130,246,0.1)'},
      done:   {lbl:'Done',        col:'#10b981', bg:'rgba(16,185,129,0.1)'},
      missed: {lbl:'Missed',      col:'#ef4444', bg:'rgba(239,68,68,0.1)'},
      cancelled:{lbl:'Cancelled', col:'#9ca3af', bg:'rgba(75,85,99,0.1)'},
      rescheduled:{lbl:'Rescheduled',col:'#8b5cf6',bg:'rgba(139,92,246,0.1)'},
      approved:{lbl:'Approved',   col:'#10b981', bg:'rgba(16,185,129,0.1)'},
      rejected:{lbl:'Rejected',   col:'#ef4444', bg:'rgba(239,68,68,0.1)'},
    };
    var info = map[s] || {lbl:s||'—', col:'#888', bg:'rgba(136,136,136,0.1)'};
    if (s === 'done' && late) { info = {lbl:'Delayed Done', col:'#f59e0b', bg:'rgba(245,158,11,0.1)'}; }
    return '<span style="font-size:0.72rem;font-weight:600;padding:2px 9px;border-radius:6px;background:'+info.bg+';color:'+info.col+'">'+info.lbl+'</span>';
  }

  function buildParams(forExport) {
    var client  = document.getElementById('admqSFClient').value;
    var picked  = document.getElementById('admqSFPickedBy').value;
    var q       = document.getElementById('admqSFQuery').value.trim();
    var p = [];
    if (client)  p.push('client_id=' + encodeURIComponent(client));
    if (picked)  p.push('picked_by=' + encodeURIComponent(picked));
    if (q)       p.push('q=' + encodeURIComponent(q));
    if (!forExport) p.push('page=' + page);
    return p.join('&');
  }

  function renderRows(rows) {
    var tbody = document.getElementById('admqSFRows');
    rows.forEach(function(r) {
      var tr = document.createElement('tr');
      tr.style.cssText = 'border-bottom:1px solid var(--adm-border,#383838);cursor:pointer;transition:background .12s';
      tr.onmouseenter = function() { this.style.background = 'var(--adm-surface,#242424)'; };
      tr.onmouseleave = function() { this.style.background = ''; };
      tr.onclick = function() { admqOpenDetail(r.instance_id); };
      var desc = (r.description || '').trim();
      var descHtml = desc ? '<div style="font-size:0.73rem;color:var(--adm-muted,#888);margin-top:2px;max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+esc(desc)+'</div>' : '';
      tr.innerHTML =
        '<td style="padding:10px 12px;font-size:0.8rem;color:var(--adm-text-2,#aaa);white-space:nowrap">'+fmtDate(r.instance_date)+'</td>' +
        '<td style="padding:10px 12px;max-width:320px">' +
          '<div style="font-size:0.82rem;font-weight:500;color:var(--adm-text,#e8e8e8)">'+esc(r.title)+'</div>' +
          descHtml +
        '</td>' +
        '<td style="padding:10px 12px;font-size:0.78rem;color:var(--adm-text-2,#aaa);white-space:nowrap">'+esc(r.created_by_name||'—')+'<div style="font-size:0.68rem;color:var(--adm-muted,#888)">'+esc(r.org_name||'')+'</div></td>' +
        '<td style="padding:10px 12px">'+priorityHtml(r.priority)+'</td>' +
        '<td style="padding:10px 12px">'+statusHtml(r.status, r.completed_late)+'</td>' +
        '<td style="padding:10px 12px;font-size:0.78rem;color:var(--adm-text-2,#aaa);white-space:nowrap">'+(r.picked_by_name ? esc(r.picked_by_name) : '<span style="color:var(--adm-muted,#888)">—</span>')+'</td>' +
        '<td style="padding:10px 12px;font-size:0.75rem;color:var(--adm-muted,#888);font-family:var(--adm-mono)">'+r.comment_count+'</td>';
      tbody.appendChild(tr);
    });
  }

  function loadPage() {
    if (loading || !hasMore) return;
    loading = true;
    document.getElementById('admqSFLoader').style.display = 'block';

    fetch('/queue/search?' + buildParams(false), { headers: {'X-Requested-With':'XMLHttpRequest'} })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        loading = false;
        document.getElementById('admqSFLoader').style.display = 'none';
        if (!data.success) return;
        var result = data.data;
        hasMore = result.hasMore;
        page    = result.page + 1;
        renderRows(result.rows);
        if (!hasMore && observer) { observer.disconnect(); observer = null; }
      })
      .catch(function() {
        loading = false;
        document.getElementById('admqSFLoader').style.display = 'none';
      });
  }

  function setupObserver() {
    if (observer) observer.disconnect();
    observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting) loadPage();
    }, { root: document.getElementById('admqSFScroll'), threshold: 0.1 });
    observer.observe(document.getElementById('admqSFSentinel'));
  }

  function doSearch(resetPage) {
    if (resetPage) {
      page = 1; hasMore = true;
      document.getElementById('admqSFRows').innerHTML = '';
      document.getElementById('admqSFTable').style.display = 'none';
      document.getElementById('admqSFEmpty').style.display = 'none';
      document.getElementById('admqSFMeta').textContent = '';
      document.getElementById('admqSFExportBtn').style.display = 'none';
    }

    loading = true;
    document.getElementById('admqSFLoader').style.display = 'block';

    fetch('/queue/search?' + buildParams(false), { headers: {'X-Requested-With':'XMLHttpRequest'} })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        loading = false;
        document.getElementById('admqSFLoader').style.display = 'none';
        if (!data.success) return;
        var result = data.data;
        total   = result.total;
        hasMore = result.hasMore;
        page    = result.page + 1;

        document.getElementById('admqSFMeta').textContent = total + ' result' + (total === 1 ? '' : 's') + ' found';

        if (result.rows.length === 0 && result.page === 1) {
          document.getElementById('admqSFEmpty').style.display = 'block';
          document.getElementById('admqSFTable').style.display = 'none';
          document.getElementById('admqSFExportBtn').style.display = 'none';
        } else {
          document.getElementById('admqSFTable').style.display = 'table';
          document.getElementById('admqSFEmpty').style.display = 'none';
          document.getElementById('admqSFExportBtn').style.display = 'flex';
          renderRows(result.rows);
          if (hasMore) setupObserver();
        }
      })
      .catch(function() {
        loading = false;
        document.getElementById('admqSFLoader').style.display = 'none';
      });
  }

  function loadOptions() {
    if (optionsLoaded) return;
    fetch('/queue/filter-options', { headers: {'X-Requested-With':'XMLHttpRequest'} })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.success) return;
        optionsLoaded = true;
        var cSel = document.getElementById('admqSFClient');
        var pSel = document.getElementById('admqSFPickedBy');
        (data.data.clients || []).forEach(function(c) {
          var o = document.createElement('option');
          o.value = c.id; o.textContent = c.name + (c.org_name ? ' ('+c.org_name+')' : '');
          cSel.appendChild(o);
        });
        (data.data.localUsers || []).forEach(function(u) {
          var o = document.createElement('option');
          o.value = u.id; o.textContent = u.name;
          pSel.appendChild(o);
        });
      });
  }

  // Enter key on search input triggers apply
  (function attachQueryKeydown() {
    var qInput = document.getElementById('admqSFQuery');
    if (qInput) {
      qInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { admqSF.apply(); } });
    } else {
      document.addEventListener('DOMContentLoaded', attachQueryKeydown);
    }
  })();

  return {
    open: function() {
      document.getElementById('admqSFOverlay').style.display = 'block';
      document.getElementById('admqSFPanel').style.display   = 'flex';
      document.body.style.overflow = 'hidden';
      loadOptions();
    },
    close: function() {
      document.getElementById('admqSFOverlay').style.display = 'none';
      document.getElementById('admqSFPanel').style.display   = 'none';
      document.body.style.overflow = '';
    },
    apply: function() {
      if (observer) { observer.disconnect(); observer = null; }
      doSearch(true);
    },
    reset: function() {
      document.getElementById('admqSFClient').value   = '';
      document.getElementById('admqSFPickedBy').value = '';
      document.getElementById('admqSFQuery').value    = '';
      document.getElementById('admqSFRows').innerHTML = '';
      document.getElementById('admqSFTable').style.display = 'none';
      document.getElementById('admqSFEmpty').style.display = 'none';
      document.getElementById('admqSFMeta').textContent = '';
      document.getElementById('admqSFExportBtn').style.display = 'none';
      if (observer) { observer.disconnect(); observer = null; }
      page = 1; hasMore = false; total = 0;
    },
    export: function(e) {
      e.preventDefault();
      window.location.href = '/queue/export?' + buildParams(true);
    }
  };
})();
</script>
