  window.admqSocketCallback = function() { loadDate(_date); };

  // ── Portal client online presence (called by layout.ejs) ────────────
  window.admqOnPresence = function(data) {
    if (data.status === 'online') _onlineClients.add(data.user_id);
    else _onlineClients.delete(data.user_id);
    document.querySelectorAll('[data-online-uid="'+data.user_id+'"]').forEach(function(el) {
      el.className = data.status === 'online' ? 'admq-online-dot' : '';
