<style>
/* Date nav */
.admq-date-nav { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.admq-nav-btn {
  height: 38px; padding: 0 16px; border-radius: 9px;
  border: 1px solid var(--adm-border); background: var(--adm-surface);
  color: var(--adm-text-2); cursor: pointer; font-size: 0.88rem;
  display: inline-flex; align-items: center; gap: 6px;
  transition: all 0.15s; font-family: var(--adm-font);
}
.admq-nav-btn:hover { border-color: var(--adm-accent); color: var(--adm-accent); background: var(--adm-surface-2); }
.admq-date-input {
  height: 38px; padding: 0 12px; border-radius: 9px;
  border: 1px solid var(--adm-border); background: var(--adm-surface-2);
  color: var(--adm-text); font-size: 0.8rem;
  font-family: var(--adm-mono); cursor: pointer;
}
.admq-date-input:focus { outline: none; border-color: var(--adm-accent); }

/* Stats bar */
.admq-stats {
  display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
}
.admq-stat {
  display: flex; align-items: center; gap: 6px;
  padding: 5px 12px; border-radius: 8px;
  border: 1px solid var(--adm-border); background: var(--adm-surface);
  font-size: 0.75rem; font-weight: 500; color: var(--adm-text-2);
  cursor: pointer; user-select: none; transition: opacity 0.15s, box-shadow 0.15s;
}
.admq-stat.active { box-shadow: 0 0 0 2px currentColor; }
.admq-stats.has-filter .admq-stat:not(.active) { opacity: 0.4; }
.admq-stat-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.admq-stat-count { font-family: var(--adm-mono); font-weight: 700; font-size: 0.92rem; }
.admq-stat.s-open   { border-color: rgba(249,115,22,0.3); background: rgba(249,115,22,0.06); color: #f97316; }
.admq-stat.s-picked { border-color: rgba(59,130,246,0.3);  background: rgba(59,130,246,0.06);  color: #3b82f6; }
.admq-stat.s-done   { border-color: rgba(16,185,129,0.3);  background: rgba(16,185,129,0.06);  color: #10b981; }
.admq-stat.s-missed     { border-color: rgba(239,68,68,0.3);   background: rgba(239,68,68,0.06);   color: #ef4444; }
.admq-stat.s-cancelled  { border-color: rgba(75,85,99,0.3);    background: rgba(75,85,99,0.06);    color: #9ca3af; }
.admq-past-notice {
  display: flex; align-items: center; gap: 6px;
  padding: 8px 14px; border-radius: 10px;
  border: 1px solid rgba(100,116,139,0.3);
  font-size: 0.75rem; color: var(--adm-muted);
}

/* Empty / loading */
.admq-empty {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 60px 20px; color: var(--adm-muted); text-align: center;
}
.admq-empty i { font-size: 2.5rem; margin-bottom: 10px; opacity: 0.3; }
.admq-empty-title { font-size: 0.9rem; font-weight: 600; margin-bottom: 4px; color: var(--adm-text-2); }
.admq-empty-sub { font-size: 0.78rem; }
.admq-loading { display: flex; align-items: center; justify-content: center; padding: 60px; }

/* Table */
.admq-table-wrap {
  background: var(--adm-surface); border: 1px solid var(--adm-border);
  border-radius: 14px; overflow-x: auto; overflow-y: hidden;
}
.admq-table-wrap::-webkit-scrollbar { height: 6px; }
.admq-table-wrap::-webkit-scrollbar-track { background: transparent; }
.admq-table-wrap::-webkit-scrollbar-thumb { background: var(--adm-border); border-radius: 3px; }
.admq-table-wrap::-webkit-scrollbar-thumb:hover { background: var(--adm-muted); }
.admq-table { width: 100%; border-collapse: collapse; min-width: 860px; }
.admq-table thead th {
  font-family: var(--adm-mono); font-size: 0.68rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.6px;
  color: var(--adm-muted); padding: 10px 14px;
  border-bottom: 1px solid var(--adm-border);
  text-align: left; white-space: nowrap;
  background: var(--adm-surface-2);
}
.admq-section-hdr {
  display:flex; align-items:center; gap:8px;
  padding:8px 16px; font-size:0.7rem;
  border-radius:10px; border:1px solid transparent;
}
.admq-section-hdr-overdue {
  background:rgba(245,158,11,0.07);
  border-color:rgba(245,158,11,0.22);
  color:#f59e0b;
}
.admq-section-hdr-today {
  background:var(--adm-surface-2);
  border-color:var(--adm-border);
  color:var(--adm-text-2);
  margin-top:18px;
}
.admq-section-hdr-title {
  font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
}
.admq-section-hdr-count {
  display:inline-flex; align-items:center; justify-content:center;
  padding:1px 8px; border-radius:20px; font-weight:700; font-size:0.66rem;
}
.admq-overdue-count { background:rgba(245,158,11,0.18); color:#f59e0b; }
.admq-today-count   { background:rgba(255,255,255,0.08); color:var(--adm-text-2); }
[data-bs-theme="light"] .admq-today-count { background:rgba(0,0,0,0.06); }
.admq-section-hdr-sub {
  margin-left:2px; font-size:0.64rem; color:var(--adm-muted);
}
.admq-table tbody tr {
  border-bottom: 1px solid var(--adm-border);
  transition: background 0.12s; cursor: pointer;
}
.admq-table tbody tr:last-child { border-bottom: none; }
.admq-table tbody tr:hover { background: var(--adm-surface-2); }
.admq-table tbody td { padding: 10px 14px; font-size: 0.88rem; color: var(--adm-text); vertical-align: middle; font-weight: 400; }

/* Row left-border color by status */
.admq-table tbody tr td:first-child { border-left: 3px solid transparent; }
.admq-table tbody tr.row-open   td:first-child { border-left-color: #f97316; }
.admq-table tbody tr.row-picked td:first-child { border-left-color: #3b82f6; }
.admq-table tbody tr.row-done   td:first-child { border-left-color: #10b981; }
.admq-table tbody tr.row-missed   td:first-child { border-left-color: #ef4444; }
.admq-table tbody tr.row-overdue  td:first-child { border-left-color: #ef4444; }
.admq-table tbody tr.row-yesterday { background: rgba(239,68,68,0.07); }
.admq-table tbody tr.row-yesterday:hover { background: rgba(239,68,68,0.13); }
.admq-table tbody tr.row-yesterday td:first-child { border-left-color: #ef4444; }
.admq-table tbody tr.row-cancelled td:first-child { border-left-color: #4b5563; }
.admq-table tbody tr.row-cancelled { opacity: 0.45; }
.admq-table tbody tr.row-approved     td:first-child { border-left-color: #10b981; }
.admq-table tbody tr.row-rejected     td:first-child { border-left-color: #f43f5e; }
.admq-table tbody tr.row-rescheduled  td:first-child { border-left-color: #8b5cf6; }
.admq-table tbody tr.row-rescheduled  { opacity: 0.6; }
.admq-cancelled-toggle { padding: 10px 16px; font-size: 0.78rem; color: var(--adm-muted); cursor: pointer; border-top: 1px solid var(--adm-border); display: flex; align-items: center; gap: 6px; transition: color 0.15s; user-select: none; }
.admq-cancelled-toggle:hover { color: var(--adm-text-2); }

/* Cell helpers */
.admq-title-cell { color: var(--adm-text); font-weight: 500; max-width: 240px; }
.admq-title-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; max-width: 240px; }
.admq-org        { font-size: 0.72rem; color: var(--adm-muted); margin-top: 2px; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
.admq-more-link  { color: var(--adm-accent); text-decoration: none; font-size: 0.72rem; }
.admq-more-link:hover { text-decoration: underline; }
.admq-tooltip {
  position: fixed; z-index: 9999;
  background: var(--adm-surface-2);
  border: 1px solid var(--adm-border-2);
  border-radius: 10px;
  padding: 10px 14px;
  max-width: 300px;
  font-size: 0.8rem;
  line-height: 1.55;
  color: var(--adm-text);
  box-shadow: 0 6px 24px rgba(0,0,0,0.22);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.15s;
  white-space: pre-wrap;
  word-break: break-word;
}
.admq-tooltip.visible { opacity: 1; }
.admq-overdue-chip {
  display: inline-block; font-size: 0.58rem; font-weight: 700;
  font-family: var(--adm-mono); text-transform: uppercase;
  padding: 1px 6px; border-radius: 6px;
  background: rgba(239,68,68,0.12); color: #ef4444;
  border: 1px solid rgba(239,68,68,0.3); margin-left: 5px; vertical-align: middle;
}
.admq-yesterday-chip {
  display: inline-block; font-size: 0.58rem; font-weight: 700;
  font-family: var(--adm-mono); text-transform: uppercase;
  padding: 1px 6px; border-radius: 6px;
  background: rgba(239,68,68,0.18); color: #ef4444;
  border: 1px solid rgba(239,68,68,0.4); margin-left: 5px; vertical-align: middle;
  letter-spacing: 0.3px;
}
.admq-rescheduled-chip {
  display: inline-block; font-size: 0.58rem; font-weight: 700;
  font-family: var(--adm-mono); text-transform: uppercase;
  padding: 1px 6px; border-radius: 6px;
  background: rgba(139,92,246,0.12); color: #8b5cf6;
  border: 1px solid rgba(139,92,246,0.3); margin-left: 5px; vertical-align: middle;
}
.admq-rec-icon { font-size: 0.75rem; color: var(--adm-muted); margin-right: 2px; }

/* Status badge */
.admq-status {
  display: inline-flex; align-items: center;
  padding: 3px 9px; border-radius: 20px;
  font-size: 0.67rem; font-weight: 600; font-family: var(--adm-mono);
  text-transform: uppercase; letter-spacing: 0.3px; white-space: nowrap;
}
.admq-status.s-open     { background: rgba(249,115,22,0.12); color: #f97316; }
.admq-status.s-picked   { background: rgba(59,130,246,0.12);  color: #3b82f6; }
.admq-status.s-done     { background: rgba(16,185,129,0.12);  color: #10b981; }
.admq-status.s-missed   { background: rgba(239,68,68,0.12);   color: #ef4444; }
.admq-status.s-cancelled  { background: rgba(100,116,139,0.12); color: #94a3b8; }
.admq-status.s-done-late  { background: rgba(168,85,247,0.12);  color: #a855f7; }
.admq-status.s-approved     { background: rgba(16,185,129,0.12);  color: #10b981; }
.admq-status.s-rejected     { background: rgba(244,63,94,0.12);   color: #f43f5e; }
.admq-status.s-rescheduled  { background: rgba(139,92,246,0.12);  color: #8b5cf6; }

/* Client online dot */
.admq-online-dot {
  width: 7px; height: 7px; border-radius: 50%; background: #22c55e; flex-shrink: 0;
  box-shadow: 0 0 0 2px rgba(34,197,94,0.25);
  display: inline-block;
}

/* Priority */
.admq-priority { display: inline-flex; align-items: center; gap: 5px; font-size: 0.75rem; font-weight: 500; }
.admq-priority-dot { width: 7px; height: 7px; border-radius: 50%; }
.p-high   .admq-priority-dot { background: #ef4444; }
.p-medium .admq-priority-dot { background: #f97316; }
.p-low    .admq-priority-dot { background: #10b981; }

/* Action buttons in table */
.admq-actions { display: flex; gap: 5px; white-space: nowrap; }
.admq-btn {
  height: 28px; padding: 0 8px; border-radius: 7px;
  border: 1px solid var(--adm-border); background: transparent;
  color: var(--adm-text-2); cursor: pointer; font-size: 0.72rem; font-weight: 600;
  display: inline-flex; align-items: center; gap: 4px; transition: all 0.15s;
  font-family: var(--adm-font); min-width: 28px; justify-content: center;
}
.admq-btn.pick    { border-color: rgba(249,115,22,0.4); color: #f97316; }
.admq-btn.pick:hover    { background: rgba(249,115,22,0.1); }
.admq-btn.done    { border-color: rgba(16,185,129,0.4);  color: #10b981; }
.admq-btn.done:hover    { background: rgba(16,185,129,0.1); }
.admq-btn.release { border-color: rgba(59,130,246,0.4);  color: #3b82f6; }
.admq-btn.release:hover { background: rgba(59,130,246,0.1); }
.admq-btn.comment { border-color: rgba(139,92,246,0.4); color: #8b5cf6; }
.admq-btn.comment:hover { background: rgba(139,92,246,0.1); }
.admq-comment-cell { max-width: 200px; }
.admq-comment-snip { font-size: 0.75rem; color: var(--adm-muted); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 190px; }

/* ── Detail drawer (appended to body by JS) ───────────────── */
.admq-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.45);
  z-index: 1040; backdrop-filter: blur(2px); display: none;
}
.admq-drawer {
  position: fixed; top: 50%; left: 50%;
  width: 780px; max-width: 96vw; height: 90vh; max-height: 880px;
  background: var(--adm-bg, #1a1a1a); border: 1px solid var(--adm-border, #383838);
  border-radius: 18px; box-shadow: 0 28px 80px rgba(0,0,0,0.65); z-index: 1041;
  display: flex; flex-direction: column; overflow: hidden;
  transform: translate(-50%, -50%) scale(0.96);
  opacity: 0; pointer-events: none;
  transition: transform 0.22s cubic-bezier(0.4,0,0.2,1), opacity 0.22s ease;
}
.admq-drawer.open {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1; pointer-events: auto;
}
.admq-drawer-header {
  padding: 16px 20px; border-bottom: 1px solid var(--adm-border, #383838);
  display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  background: var(--adm-surface, #242424); border-radius: 18px 18px 0 0;
}
.admq-drawer-title {
  font-weight: 600; font-size: 0.92rem; color: var(--adm-text, #e8e8e8);
  display: flex; align-items: center; gap: 8px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 640px;
}
.admq-close-btn {
  background: none; border: none; color: var(--adm-muted, #445e78);
  cursor: pointer; font-size: 1rem; padding: 2px; line-height: 1; flex-shrink: 0;
  transition: color 0.15s;
}
.admq-close-btn:hover { color: var(--adm-text, #dceaf8); }
.admq-drawer-body {
  flex: 1; overflow-y: auto; padding: 20px 24px;
  display: flex; flex-direction: column; gap: 18px;
  background: var(--adm-bg, #1a1a1a);
}
.admq-drawer-actions {
  display: flex; gap: 8px; padding: 12px 20px;
  border-top: 1px solid var(--adm-border, #383838);
  flex-shrink: 0; background: var(--adm-surface, #242424);
}
.admq-drawer-btn {
  flex: 1; height: 36px; border-radius: 9px;
  border: 1px solid var(--adm-border, #1a3050); background: transparent;
  color: var(--adm-text-2, #a8c0d8); cursor: pointer; font-size: 0.8rem; font-weight: 600;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  transition: all 0.15s; font-family: var(--adm-font, 'DM Sans', sans-serif);
}
.admq-drawer-btn.pick    { border-color: rgba(249,115,22,0.4); color: #f97316; }
.admq-drawer-btn.pick:hover    { background: rgba(249,115,22,0.1); }
.admq-drawer-btn.done    { border-color: rgba(16,185,129,0.4);  color: #10b981; }
.admq-drawer-btn.done:hover    { background: rgba(16,185,129,0.1); }
.admq-drawer-btn.release { border-color: rgba(59,130,246,0.4);  color: #3b82f6; }
.admq-drawer-btn.release:hover { background: rgba(59,130,246,0.1); }

/* Detail sections */
.admq-section-label {
  font-size: 0.6rem; font-family: var(--adm-mono, monospace); font-weight: 700;
  text-transform: uppercase; letter-spacing: 1px; color: var(--adm-muted, #445e78);
  padding-bottom: 8px; border-bottom: 1px solid var(--adm-border, #1a3050); margin-bottom: 2px;
}
.admq-info-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.admq-info-item { display: flex; flex-direction: column; gap: 3px; }
.admq-info-key { font-size: 0.65rem; color: var(--adm-muted, #445e78); font-family: var(--adm-mono); text-transform: uppercase; letter-spacing: 0.5px; }
.admq-info-val { font-size: 0.82rem; font-weight: 500; color: var(--adm-text, #dceaf8); }
.admq-description {
  font-size: 0.82rem; line-height: 1.6; color: var(--adm-text-2, #a8c0d8);
  background: var(--adm-surface-2, #132540); border: 1px solid var(--adm-border, #1a3050);
  border-radius: 10px; padding: 10px 12px; white-space: pre-wrap; word-break: break-word;
}
.admq-attach-list { display: flex; flex-direction: column; gap: 6px; }
.admq-attach-item {
  display: flex; align-items: center; gap: 10px; padding: 8px 12px;
  background: var(--adm-surface-2, #132540); border: 1px solid var(--adm-border, #1a3050);
  border-radius: 9px; text-decoration: none; color: var(--adm-text-2, #a8c0d8);
  font-size: 0.78rem; transition: border-color 0.15s;
}
.admq-attach-item:hover { border-color: var(--adm-accent, #00d4ff); text-decoration: none; color: var(--adm-text, #dceaf8); }
.admq-upload-label {
  display: inline-flex; align-items: center; gap: 6px;
  height: 30px; padding: 0 12px; border-radius: 7px;
  border: 1px dashed var(--adm-border, #1a3050); color: var(--adm-muted, #445e78);
  font-size: 0.75rem; cursor: pointer; transition: all 0.15s; margin-top: 4px;
}
.admq-upload-label:hover { border-color: var(--adm-accent, #00d4ff); color: var(--adm-accent, #00d4ff); }
.admq-history-list { display: flex; flex-direction: column; gap: 8px; }
.admq-history-item { display: flex; gap: 8px; align-items: flex-start; font-size: 0.78rem; color: var(--adm-text-2, #a8c0d8); }
.admq-history-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--adm-muted, #445e78); margin-top: 5px; flex-shrink: 0; }
.admq-history-time { font-size: 0.68rem; color: var(--adm-muted, #445e78); margin-top: 2px; }
.admq-comments-list { display: flex; flex-direction: column; gap: 12px; }
.admq-comment { display: flex; gap: 10px; }
.admq-comment-avatar {
  width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.7rem; font-weight: 700; color: #fff; font-family: var(--adm-mono);
}
.admq-comment-meta { font-size: 0.65rem; color: var(--adm-muted, #445e78); margin-bottom: 3px; }
.admq-comment-body { font-size: 0.8rem; color: var(--adm-text-2, #a8c0d8); line-height: 1.5; white-space: pre-wrap; }
.admq-comment-input-row { display: flex; gap: 8px; align-items: flex-end; margin-top: 6px; }
.admq-comment-textarea {
  flex: 1; resize: none; border-radius: 9px; padding: 8px 10px; min-height: 58px;
  background: var(--adm-surface-2, #132540); border: 1px solid var(--adm-border, #1a3050);
  color: var(--adm-text, #dceaf8); font-family: var(--adm-font, sans-serif); font-size: 0.82rem;
}
.admq-comment-textarea:focus { outline: none; border-color: var(--adm-accent, #00d4ff); }
.admq-comment-send {
  width: 36px; height: 36px; border-radius: 9px; flex-shrink: 0;
  border: none; background: #2563eb; color: #fff; cursor: pointer;
  display: flex; align-items: center; justify-content: center; font-size: 0.85rem;
}

/* ── Release modal (appended to body by JS) ───────────────── */
.admq-modal-backdrop {
  position: fixed; inset: 0; background: rgba(0,0,0,0.6);
  z-index: 1050; display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.admq-modal {
  background: var(--adm-surface, #0e1d30); border: 1px solid var(--adm-border, #1a3050);
  border-radius: 16px; padding: 24px; width: 420px; max-width: 92vw;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.admq-modal-title { font-family: var(--adm-mono); font-size: 1rem; font-weight: 700; color: var(--adm-text, #dceaf8); margin-bottom: 5px; }
.admq-modal-sub   { font-size: 0.78rem; color: var(--adm-muted, #445e78); margin-bottom: 16px; line-height: 1.5; }
.admq-modal-textarea {
  width: 100%; resize: vertical; min-height: 80px; border-radius: 10px;
  padding: 10px 12px; background: var(--adm-surface-2, #132540);
  border: 1px solid var(--adm-border, #1a3050); color: var(--adm-text, #dceaf8);
  font-family: var(--adm-font, sans-serif); font-size: 0.85rem; box-sizing: border-box;
}
.admq-modal-textarea:focus { outline: none; border-color: var(--adm-accent, #00d4ff); }
.admq-modal-footer { display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px; }
.admq-modal-cancel {
  height: 36px; padding: 0 16px; border-radius: 9px;
  border: 1px solid var(--adm-border, #1a3050); background: transparent;
  color: var(--adm-text-2, #a8c0d8); cursor: pointer; font-size: 0.82rem;
  font-family: var(--adm-font, sans-serif);
}
.admq-modal-confirm {
  height: 36px; padding: 0 16px; border-radius: 9px; border: none;
  background: #3b82f6; color: #fff; cursor: pointer;
  font-size: 0.82rem; font-weight: 600; font-family: var(--adm-font, sans-serif);
}
.admq-modal-cancel:hover  { border-color: var(--adm-border-2, #1e3860); color: var(--adm-text, #dceaf8); }
.admq-modal-confirm:hover { background: #2563eb; }

/* ── Drawer inline chat ──────────────────────────────────────────── */
/* body collapses when input is focused */
.admq-drawer-body {
  transition: max-height 0.28s cubic-bezier(0.4,0,0.2,1),
              padding 0.28s cubic-bezier(0.4,0,0.2,1),
              opacity 0.2s ease;
  max-height: 9999px;
}
.admq-drawer.chat-focused .admq-drawer-body {
  max-height: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important;
  overflow: hidden !important; opacity: 0;
}
.admq-drawer-actions {
  transition: max-height 0.28s cubic-bezier(0.4,0,0.2,1), padding 0.28s cubic-bezier(0.4,0,0.2,1);
  max-height: 200px; overflow: hidden;
}
.admq-drawer.chat-focused .admq-drawer-actions {
  max-height: 0 !important; padding-top: 0 !important; padding-bottom: 0 !important;
}
#admqDrawerChat {
  flex-shrink:0; border-top:1px solid var(--adm-border,#383838);
  background:var(--adm-surface,#242424); display:flex; flex-direction:column;
  height:380px; min-height:0; border-radius:0 0 18px 18px;
  transition: height 0.28s cubic-bezier(0.4,0,0.2,1);
}
#admqDrawerChatLabel {
  font-size:0.6rem; font-family:var(--adm-mono,monospace); font-weight:700;
  text-transform:uppercase; letter-spacing:1px; color:var(--adm-muted,#888);
  padding:9px 20px 7px; flex-shrink:0;
  display:flex; align-items:center; gap:7px; border-bottom:1px solid var(--adm-border,#383838);
}
#admqDrawerChatLabel span { color:var(--adm-accent,#00d4ff); font-size:0.75rem; font-weight:600; letter-spacing:0; }
#admqDrawerMessages {
  flex:1; overflow-y:auto; padding:12px 20px;
  display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth;
}
#admqDrawerMessages::-webkit-scrollbar { width:3px; }
#admqDrawerMessages::-webkit-scrollbar-thumb { background:var(--adm-border,#383838); border-radius:3px; }
#admqDrawerChatPreviews {
  display:flex; flex-wrap:wrap; gap:6px; padding:4px 14px 0; min-height:0;
}
#admqDrawerCompose {
  padding:8px 14px 12px; border-top:1px solid var(--adm-border,#383838);
  background:var(--adm-bg,#1a1a1a); flex-shrink:0; border-radius:0 0 18px 18px;
}
.admq-compose-box {
  position:relative;
  background:var(--adm-surface,#2a2a2a);
  border:1px solid var(--adm-border,#383838);
  border-radius:16px;
  padding:12px 52px 12px 14px;
  transition:border-color .15s;
}
.admq-compose-box:focus-within { border-color:var(--adm-accent,#00d4ff); }
#admqDrawerInput {
  width:100%; min-height:56px; max-height:130px;
  resize:none; border:none; background:transparent;
  color:var(--adm-text,#e8e8e8); font-family:var(--adm-font,sans-serif);
  font-size:0.85rem; line-height:1.55; padding:0; overflow-y:auto;
  box-sizing:border-box; display:block;
}
#admqDrawerInput:focus { outline:none; }
#admqDrawerInput::placeholder { color:var(--adm-muted,#666); }
.admq-compose-actions {
  position:absolute; bottom:10px; right:10px;
  display:flex; flex-direction:column; gap:5px; align-items:center;
}
.admq-compose-attach {
  width:30px; height:30px; border-radius:8px;
  border:1px solid var(--adm-border,#383838); background:transparent;
  color:var(--adm-muted,#888); cursor:pointer; font-size:0.9rem;
  display:flex; align-items:center; justify-content:center; transition:color .15s,border-color .15s;
}
.admq-compose-attach:hover { color:var(--adm-text,#e8e8e8); border-color:var(--adm-text-2,#aaa); }
.admq-compose-send {
  width:30px; height:30px; border-radius:50%; border:none;
  background:var(--adm-accent,#00d4ff); color:#000; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  font-size:0.85rem; font-weight:700; transition:opacity .15s;
}
.admq-compose-send:hover { opacity:0.85; }
.admq-compose-send:disabled { opacity:.35; cursor:not-allowed; }

/* ── Chat Modal ───────────────────────────────────────────────────── */
#admqChatModal {
  position:fixed; inset:0; z-index:1060; display:none;
  align-items:center; justify-content:center;
  background:rgba(0,0,0,0.65); backdrop-filter:blur(5px);
}
#admqChatBox {
  background:var(--adm-surface); border:1px solid var(--adm-border);
  border-radius:18px; width:680px; max-width:96vw;
  height:82vh; max-height:700px; display:flex; flex-direction:column;
  box-shadow:0 24px 72px rgba(0,0,0,0.55); overflow:hidden;
}
#admqChatHeader {
  display:flex; align-items:center; gap:10px;
  padding:14px 18px; border-bottom:1px solid var(--adm-border);
  background:var(--adm-surface-2); flex-shrink:0;
}
#admqChatTitle {
  flex:1; font-size:0.88rem; font-weight:700;
  color:var(--adm-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
#admqChatTitle small {
  display:block; font-size:0.65rem; font-weight:400;
  color:var(--adm-muted); letter-spacing:.5px; margin-top:1px;
}
#admqChatClose {
  width:32px; height:32px; border-radius:8px; border:none;
  background:transparent; color:var(--adm-muted); cursor:pointer;
  font-size:1rem; display:flex; align-items:center; justify-content:center;
  transition:background .15s, color .15s;
}
#admqChatClose:hover { background:var(--adm-border); color:var(--adm-text); }
#admqChatMessages {
  flex:1; overflow-y:auto; padding:16px 18px;
  display:flex; flex-direction:column; gap:10px;
  scroll-behavior:smooth;
}
#admqChatMessages::-webkit-scrollbar { width:4px; }
#admqChatMessages::-webkit-scrollbar-thumb { background:var(--adm-border-2); border-radius:4px; }
.admqc-bubble-wrap {
  display:flex; gap:8px; align-items:flex-end; max-width:78%;
}
.admqc-bubble-wrap.mine { align-self:flex-end; flex-direction:row-reverse; }
.admqc-bubble-wrap.theirs { align-self:flex-start; }
.admqc-avatar {
  width:28px; height:28px; border-radius:50%; flex-shrink:0;
  display:flex; align-items:center; justify-content:center;
  font-size:0.7rem; font-weight:700; color:#fff;
}
.admqc-bubble {
  padding:9px 13px; border-radius:14px; font-size:0.83rem;
  line-height:1.5; color:var(--adm-text); max-width:100%;
  word-break:break-word; white-space:pre-wrap;
}
.mine .admqc-bubble {
  background:rgba(16,185,129,0.18); border:1px solid rgba(16,185,129,0.28);
  border-bottom-right-radius:4px;
}
.theirs .admqc-bubble {
  background:var(--adm-surface-2); border:1px solid var(--adm-border);
  border-bottom-left-radius:4px;
}
.admqc-meta {
  font-size:0.6rem; color:var(--adm-muted); margin-top:3px;
  white-space:nowrap;
}
.mine  .admqc-meta { text-align:right; }
.theirs .admqc-meta { text-align:left; }
.admqc-file-chips { display:flex; flex-wrap:wrap; gap:5px; margin-top:6px; }
.admqc-chip {
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 8px; border-radius:8px; font-size:0.72rem; cursor:pointer;
  text-decoration:none; color:var(--adm-text);
  border:1px solid var(--adm-border); background:var(--adm-surface);
  transition:border-color .15s;
}
.admqc-chip:hover { border-color:var(--adm-accent); color:var(--adm-accent); }
.admqc-img-thumb {
  max-width:220px; max-height:160px; border-radius:8px; display:block;
  margin-top:6px; cursor:pointer; border:1px solid var(--adm-border);
  object-fit:cover;
}
.admqc-empty {
  flex:1; display:flex; flex-direction:column; align-items:center;
  justify-content:center; color:var(--adm-muted); gap:8px; font-size:0.82rem;
}
#admqChatFooter {
  border-top:1px solid var(--adm-border);
  background:var(--adm-surface-2); flex-shrink:0;
}
#admqChatPreviews {
  display:flex; flex-wrap:wrap; gap:6px;
  padding:8px 14px 0; min-height:0;
}
.admqc-preview-item {
  position:relative; display:inline-flex; align-items:center; gap:5px;
  padding:4px 8px; border-radius:8px; font-size:0.72rem;
  background:var(--adm-surface); border:1px solid var(--adm-border);
  color:var(--adm-text-2);
}
.admqc-preview-img { width:36px; height:36px; object-fit:cover; border-radius:5px; }
.admqc-preview-rm {
  position:absolute; top:-5px; right:-5px;
  width:16px; height:16px; border-radius:50%;
  background:#ef4444; border:none; color:#fff;
  font-size:0.6rem; cursor:pointer; display:flex;
  align-items:center; justify-content:center; line-height:1;
}
#admqChatInputRow {
  display:flex; align-items:flex-end; gap:8px; padding:10px 14px 12px;
}
#admqChatInput {
  flex:1; resize:none; min-height:40px; max-height:110px;
  padding:10px 12px; border-radius:12px; border:1px solid var(--adm-border);
  background:var(--adm-surface); color:var(--adm-text);
  font-family:var(--adm-font,sans-serif); font-size:0.85rem;
  overflow-y:auto; box-sizing:border-box; line-height:1.45;
}
#admqChatInput:focus { outline:none; border-color:var(--adm-accent); }
.admqc-icon-btn {
  width:38px; height:38px; border-radius:10px; border:1px solid var(--adm-border);
  background:transparent; color:var(--adm-muted); cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  font-size:1rem; flex-shrink:0; transition:color .15s, border-color .15s;
}
.admqc-icon-btn:hover { color:var(--adm-accent); border-color:var(--adm-accent); }
#admqChatSend {
  width:38px; height:38px; border-radius:10px; border:none;
  background:#10b981; color:#fff; cursor:pointer;
  display:flex; align-items:center; justify-content:center;
  font-size:1rem; flex-shrink:0; transition:background .15s;
}
#admqChatSend:hover { background:#059669; }
#admqChatSend:disabled { opacity:.5; cursor:not-allowed; }

/* Spinner */
@keyframes admqSpin { to { transform: rotate(360deg); } }
.admq-spinner {
  width: 20px; height: 20px; border-radius: 50%;
  border: 2px solid var(--adm-border, #1a3050);
  border-top-color: var(--adm-accent, #00d4ff);
  animation: admqSpin 0.7s linear infinite; display: inline-block;
}
</style>

<!-- Row 1: date nav + action buttons -->
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:8px">
  <div class="admq-date-nav">
    <button class="admq-nav-btn" id="admqPrev"><i class="bi bi-chevron-left"></i></button>
    <input type="date" class="admq-date-input" id="admqDatePicker" value="<%= selectedDate %>">
    <button class="admq-nav-btn" id="admqYesterday">Yesterday</button>
    <button class="admq-nav-btn" id="admqToday"><i class="bi bi-calendar-check"></i> Today</button>
    <button class="admq-nav-btn" id="admqTomorrow">Tomorrow</button>
    <button class="admq-nav-btn" id="admqNext"><i class="bi bi-chevron-right"></i></button>
  </div>
  <div style="display:flex;align-items:center;gap:8px">
    <button id="admqTestSoundBtn" class="admq-nav-btn" title="Test notification sound" onclick="admqTestSound()" style="color:var(--adm-muted);border-style:dashed">
      <i class="bi bi-volume-up"></i> Test Sound
    </button>
    <button class="admq-nav-btn" onclick="admqSF.open()" title="Search & filter requests" style="color:#00d4ff;border-color:rgba(0,212,255,0.35)">
      <i class="bi bi-funnel"></i> Search & Filter
    </button>
    <button class="admq-nav-btn" onclick="admqOpenMonthlyReport()" title="Send monthly report to your email" style="color:#8b5cf6;border-color:rgba(139,92,246,0.35)">
      <i class="bi bi-file-earmark-bar-graph"></i> Monthly Report
    </button>
    <% if (user.role_name === 'LOCAL_USER') { %>
    <a href="/admin" class="adm-back-btn"><i class="bi bi-arrow-left"></i> Dashboard</a>
    <% } else { %>
    <a href="/admin/work" class="adm-back-btn"><i class="bi bi-arrow-left"></i> Work</a>
    <% } %>
  </div>
</div>

<!-- Row 2: stat cards -->
<div style="margin-bottom:12px">
  <div class="admq-stats" id="admqStats"></div>
</div>

<!-- Table -->
<div id="admqTableArea">
  <div class="admq-loading"><div class="admq-spinner"></div></div>
</div>

<!-- Search & Filter fullscreen offcanvas — teleported to <body> by JS -->
<div id="admqSFOverlay" style="display:none"></div>
<div id="admqSFPanel" style="display:none;position:fixed;inset:0;z-index:1401;background:var(--adm-bg,#1a1a1a);flex-direction:column">

  <!-- panel header -->
  <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--adm-border,#383838);flex-shrink:0;background:var(--adm-surface,#242424)">
    <i class="bi bi-funnel" style="color:#00d4ff;font-size:1rem"></i>
    <span style="font-weight:600;font-size:0.9rem;color:var(--adm-text,#e8e8e8);flex:1">Search &amp; Filter Requests</span>
    <a id="admqSFExportBtn" href="#" onclick="admqSF.export(event)" style="display:none;align-items:center;gap:6px;padding:5px 14px;border-radius:8px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.35);color:#10b981;font-size:0.78rem;font-weight:600;text-decoration:none">
      <i class="bi bi-download"></i> Export CSV
    </a>
    <button onclick="admqSF.close()" style="background:none;border:none;color:var(--adm-muted,#888);cursor:pointer;font-size:1rem;line-height:1;padding:2px"><i class="bi bi-x-lg"></i></button>
  </div>

  <!-- filter controls -->
  <div style="display:flex;align-items:flex-end;gap:10px;padding:12px 18px;border-bottom:1px solid var(--adm-border,#383838);flex-wrap:wrap;flex-shrink:0;background:var(--adm-surface,#242424)">
    <div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:160px">
      <label style="font-size:0.65rem;font-family:var(--adm-mono);text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888)">Client</label>
      <select id="admqSFClient" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--adm-border,#383838);background:var(--adm-surface-2,#2c2c2c);color:var(--adm-text,#e8e8e8);font-size:0.82rem;cursor:pointer">
        <option value="">All Clients</option>
      </select>
    </div>
    <div style="display:flex;flex-direction:column;gap:4px;flex:1;min-width:160px">
      <label style="font-size:0.65rem;font-family:var(--adm-mono);text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888)">Picked By</label>
      <select id="admqSFPickedBy" style="height:36px;padding:0 10px;border-radius:9px;border:1px solid var(--adm-border,#383838);background:var(--adm-surface-2,#2c2c2c);color:var(--adm-text,#e8e8e8);font-size:0.82rem;cursor:pointer">
        <option value="">All Users</option>
      </select>
    </div>
    <div style="display:flex;flex-direction:column;gap:4px;flex:2;min-width:200px">
      <label style="font-size:0.65rem;font-family:var(--adm-mono);text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888)">Search (title / description / comment)</label>
      <input type="text" id="admqSFQuery" placeholder="Type any keyword…" maxlength="200"
        style="height:36px;padding:0 12px;border-radius:9px;border:1px solid var(--adm-border,#383838);background:var(--adm-surface-2,#2c2c2c);color:var(--adm-text,#e8e8e8);font-size:0.82rem">
    </div>
    <button onclick="admqSF.apply()" style="height:36px;padding:0 18px;border-radius:9px;border:1px solid rgba(0,212,255,0.4);background:rgba(0,212,255,0.1);color:#00d4ff;font-size:0.82rem;font-weight:600;cursor:pointer;white-space:nowrap;flex-shrink:0">
      <i class="bi bi-search"></i> Apply
    </button>
    <button onclick="admqSF.reset()" title="Clear filters" style="height:36px;padding:0 12px;border-radius:9px;border:1px solid var(--adm-border,#383838);background:transparent;color:var(--adm-muted,#888);font-size:0.82rem;cursor:pointer;flex-shrink:0">
      <i class="bi bi-x"></i> Clear
    </button>
  </div>

  <!-- result count bar -->
  <div id="admqSFMeta" style="padding:8px 18px;font-size:0.75rem;color:var(--adm-muted,#888);flex-shrink:0;min-height:30px"></div>

  <!-- results table -->
  <div style="flex:1;overflow-y:auto;padding:0 18px 18px" id="admqSFScroll">
    <div id="admqSFBody">
      <div id="admqSFEmpty" style="display:none;padding:60px 0;text-align:center;color:var(--adm-muted,#888)">
        <i class="bi bi-inbox" style="font-size:2rem;opacity:.3;display:block;margin-bottom:8px"></i>
        <div style="font-size:0.85rem">No results — try different filters or a different keyword.</div>
      </div>
      <table id="admqSFTable" style="display:none;width:100%;border-collapse:collapse;min-width:700px">
        <thead>
          <tr style="position:sticky;top:0;z-index:2">
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Date</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;min-width:200px">Request</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Client</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Priority</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Status</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Picked By</th>
            <th style="font-family:var(--adm-mono);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--adm-muted,#888);padding:10px 12px;border-bottom:1px solid var(--adm-border,#383838);background:var(--adm-bg,#1a1a1a);text-align:left;white-space:nowrap">Comments</th>
          </tr>
        </thead>
        <tbody id="admqSFRows"></tbody>
      </table>
      <!-- infinite scroll sentinel -->
      <div id="admqSFSentinel" style="height:1px"></div>
      <div id="admqSFLoader" style="display:none;padding:20px;text-align:center"><div class="admq-spinner" style="margin:0 auto"></div></div>
    </div>
  </div>

</div>

<!-- Detail drawer & release modal — moved to <body> by JS -->
<div id="admqOverlay"  class="admq-overlay"  style="display:none" onclick="admqCloseDetail()"></div>
<div id="admqDrawer"   class="admq-drawer">
  <div class="admq-drawer-header">
    <div class="admq-drawer-title" id="admqDrawerTitle"><i class="bi bi-clipboard2-check"></i> Request Detail</div>
    <button class="admq-close-btn" onclick="admqCloseDetail()"><i class="bi bi-x-lg"></i></button>
  </div>
  <div class="admq-drawer-body" id="admqDrawerBody">
    <div class="admq-loading"><div class="admq-spinner"></div></div>
  </div>
  <div class="admq-drawer-actions" id="admqDrawerActions" style="display:none"></div>
  <div id="admqDrawerChat" style="display:none">
    <div id="admqDrawerChatLabel">
      <i class="bi bi-chat-left-dots-fill" style="color:var(--adm-accent)"></i>
      Correspondence <span id="admqDrawerChatCount"></span>
      <button id="admqDrawerExpandBtn" onclick="admqDrawerExpandDetail()" title="Show details" style="display:none;margin-left:auto;background:none;border:none;color:var(--adm-muted,#888);cursor:pointer;font-size:0.72rem;padding:0 2px;align-items:center;gap:4px">
        <i class="bi bi-chevron-up"></i> Details
      </button>
    </div>
    <div id="admqDrawerMessages"></div>
    <div id="admqDrawerChatPreviews"></div>
    <div id="admqDrawerCompose">
      <input type="file" id="admqDrawerFileInput" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.zip" style="display:none">
      <div class="admq-compose-box">
        <textarea id="admqDrawerInput" placeholder="Type a message… or paste an image"></textarea>
        <div class="admq-compose-actions">
          <button class="admq-compose-attach" title="Attach file" onclick="document.getElementById('admqDrawerFileInput').click()">
            <i class="bi bi-paperclip"></i>
          </button>
          <button class="admq-compose-send" id="admqDrawerSend" title="Send (Ctrl+Enter)" onclick="admqDrawerSend()">
            <i class="bi bi-arrow-up"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="admqTooltip" class="admq-tooltip"></div>

<div id="admqCommentModal" class="admq-modal-backdrop" style="display:none">
  <div class="admq-modal">
    <div class="admq-modal-title"><i class="bi bi-chat-left-text"></i> Add Comment</div>
    <div class="admq-modal-sub">Comment will be visible to the client and the local team.</div>
    <textarea class="admq-modal-textarea" id="admqQuickCommentInput" placeholder="Type your comment…" rows="3"></textarea>
    <div class="admq-modal-footer">
      <button class="admq-modal-cancel" onclick="admqCloseCommentModal()">Cancel</button>
      <button class="admq-modal-confirm" id="admqCommentSendBtn" onclick="admqConfirmComment()"><i class="bi bi-send"></i> Send</button>
    </div>
  </div>
</div>

<!-- ── Chat Modal ──────────────────────────────────────────────── -->
<div id="admqChatModal">
  <div id="admqChatBox">
    <div id="admqChatHeader">
      <i class="bi bi-chat-left-dots-fill" style="color:var(--adm-accent);font-size:1rem;flex-shrink:0"></i>
      <div id="admqChatTitle">Correspondence<small>Loading…</small></div>
      <button id="admqChatClose" onclick="admqCloseChat()"><i class="bi bi-x-lg"></i></button>
    </div>
    <div id="admqChatMessages"></div>
    <div id="admqChatFooter">
      <div id="admqChatPreviews"></div>
      <div id="admqChatInputRow">
        <textarea id="admqChatInput" placeholder="Type a message… or paste an image" rows="1"></textarea>
        <input type="file" id="admqChatFileInput" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.txt,.csv,.zip" style="display:none">
        <button class="admqc-icon-btn" title="Attach file" onclick="document.getElementById('admqChatFileInput').click()">
          <i class="bi bi-paperclip"></i>
        </button>
        <button id="admqChatSend" title="Send (Ctrl+Enter)" onclick="admqSendChat()">
          <i class="bi bi-send-fill"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<div id="admqDoneModal" class="admq-modal-backdrop" style="display:none">
  <div class="admq-modal">
    <div class="admq-modal-title"><i class="bi bi-check-circle"></i> Mark as Done</div>
    <div class="admq-modal-sub">Add a completion remark before closing this task. This is required.</div>
    <textarea class="admq-modal-textarea" id="admqDoneRemark" placeholder="What was done? Any notes for the client…" rows="3"></textarea>
    <div class="admq-modal-footer">
      <button class="admq-modal-cancel" onclick="admqCloseDoneModal()">Cancel</button>
      <button class="admq-modal-confirm" id="admqDoneConfirmBtn" onclick="admqConfirmDone()"><i class="bi bi-check-lg"></i> Mark Done</button>
    </div>
  </div>
</div>

<div id="admqReleaseModal" class="admq-modal-backdrop" style="display:none">
  <div class="admq-modal">
    <div class="admq-modal-title"><i class="bi bi-arrow-counterclockwise"></i> Release Task</div>
    <div class="admq-modal-sub">The task returns to the open queue for others to pick up.</div>
    <textarea class="admq-modal-textarea" id="admqReleaseReason" placeholder="Reason for releasing (optional)…" rows="3"></textarea>
    <div class="admq-modal-footer">
      <button class="admq-modal-cancel" onclick="admqCloseRelease()">Cancel</button>
      <button class="admq-modal-confirm" onclick="admqConfirmRelease()"><i class="bi bi-check-lg"></i> Release</button>
    </div>
  </div>
</div>

<div id="admqMonthlyReportModal" class="admq-modal-backdrop" style="display:none">
  <div class="admq-modal">
    <div class="admq-modal-title"><i class="bi bi-file-earmark-bar-graph"></i> Monthly Requests Report</div>
    <div class="admq-modal-sub">Select a month to generate and send the report to your email address.</div>
    <label style="font-size:0.78rem;color:var(--adm-text-2);margin-bottom:6px;display:block">Month</label>
    <select class="admq-modal-textarea" id="admqMonthSelect" style="padding:8px 12px;cursor:pointer">
      <option value="">Loading months…</option>
    </select>
    <div id="admqMonthlyStatus" style="margin-top:10px;font-size:0.78rem;min-height:18px"></div>
    <div class="admq-modal-footer">
      <button class="admq-modal-cancel" onclick="admqCloseMonthlyReport()">Cancel</button>
      <button class="admq-modal-confirm" id="admqMonthlyReportBtn" onclick="admqConfirmMonthlyReport()" style="background:#8b5cf6">
        <i class="bi bi-send"></i> Send Report
      </button>
    </div>
  </div>
</div>

<div id="admqRescheduleModal" class="admq-modal-backdrop" style="display:none">
  <div class="admq-modal">
    <div class="admq-modal-title"><i class="bi bi-calendar-plus"></i> Reschedule Request</div>
    <div class="admq-modal-sub">Move this request to a future date. A reason is required so the client knows why.</div>
    <label style="font-size:0.78rem;color:var(--adm-text-2);margin-bottom:4px;display:block">New Date</label>
    <input type="date" class="admq-modal-textarea" id="admqRescheduleDate" style="padding:8px 12px;margin-bottom:10px">
    <label style="font-size:0.78rem;color:var(--adm-text-2);margin-bottom:4px;display:block">Assign To</label>
    <select class="admq-modal-textarea" id="admqRescheduleAssignee" style="padding:8px 12px;margin-bottom:10px;cursor:pointer">
      <option value="">— Unassigned —</option>
    </select>
    <label style="font-size:0.78rem;color:var(--adm-text-2);margin-bottom:4px;display:block">Reason <span style="color:#ef4444">*</span></label>
    <textarea class="admq-modal-textarea" id="admqRescheduleReason" placeholder="Why is this being rescheduled?" rows="3"></textarea>
    <div class="admq-modal-footer">
      <button class="admq-modal-cancel" onclick="admqCloseReschedule()">Cancel</button>
      <button class="admq-modal-confirm" id="admqRescheduleConfirmBtn" onclick="admqConfirmReschedule()"><i class="bi bi-calendar-check"></i> Reschedule</button>
    </div>
  </div>
</div>

<script>
(function () {
  // ── Teleport fixed elements to <body> to escape overflow containers ──
  ['admqSFOverlay','admqSFPanel','admqOverlay','admqDrawer','admqReleaseModal','admqCommentModal','admqChatModal','admqRescheduleModal','admqMonthlyReportModal'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) document.body.appendChild(el);
  });

  // ── Bootstrap data (closing-tag sequences in JSON escaped to avoid early parse end) ──
  var _raw = <%- JSON.stringify({ instances: instances, cancelledInstances: cancelledInstances, stats: stats, selectedDate: selectedDate, today: today }).replace(/<\//g, '<\\/') %>;
  var _localUsers = <%- JSON.stringify(localUsers || []).replace(/<\//g, '<\\/') %>;
  var _onlineClients = new Set();
  var _date      = _raw.selectedDate;
  var _today     = _raw.today;
  var _userId    = <%= user.id %>;
  var _role      = '<%= user.role_name %>';
  var _detailId  = null;
  var _releaseId = null;
  var _admqCommentInstanceId = null;
  var _activeFilter = null;

  // ── Helpers ──────────────────────────────────────────────────────────
  function isPast(d)  { return d < _today; }
  function isAdmin()  { return ['LOCAL_ADMIN','LOCAL_MANAGER'].includes(_role); }
  function esc(s)     { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function fmtDate(d) {
    if (!d) return '—';
    var p = d.split('-'), m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return m[parseInt(p[1])-1]+' '+parseInt(p[2])+', '+p[0];
  }
  // Parse a server datetime string to a correct-epoch Date (handles DST automatically).
  // MySQL TIMESTAMP strings arrive in Eastern timezone (server OS = America/New_York).
  // UTC ISO strings (DATETIME columns, JSON) arrive with 'Z' suffix.
  function _parseTS(s) {
    if (!s) return null;
    s = String(s);
    // Already timezone-aware (JS Date serialized with Z, or offset string)
    if (s.charAt(s.length - 1) === 'Z' || s.indexOf('+') !== -1 ||
        (s.indexOf('T') !== -1 && s.length > 19)) return new Date(s);
    // Bare MySQL datetime string — DB session is UTC, so append Z directly
    var d = new Date(s.replace(' ', 'T') + 'Z');
    return isNaN(d.getTime()) ? null : d;
  }
  function fmtTs(ts) {
    if (!ts) return '';
    var d = _parseTS(ts);
    if (!d) return '';
    return d.toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true });
  }
  function fmtTime(dtStr) {
    if (!dtStr) return '—';
    var d = _parseTS(dtStr);
    if (!d) return '—';
    return d.toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', hour12: true });
  }
  function fmtDateShort(dtStr) {
    if (!dtStr) return '—';
    var datePart = String(dtStr).split(' ')[0] || '';
    var p = datePart.split('-');
    if (p.length < 3) return '—';
    return p[1] + '/' + p[2];
  }
  function descSnippet(inst) {
    var desc = (inst.description || '').trim();
    if (!desc) return '';
    var limit = 52;
    if (desc.length <= limit) return '<span class="admq-org">'+esc(desc)+'</span>';
    return '<span class="admq-org">'+esc(desc.substring(0, limit))+'… <a class="admq-more-link" href="#" onclick="event.stopPropagation();admqOpenDetail('+inst.id+')">more</a></span>';
  }

  function commentSnippet(inst) {
    var body = (inst.latest_comment || '').trim();
    var count = parseInt(inst.comment_count) || 0;
    var countBadge = count > 0 ? '<span style="display:inline-block;font-size:0.62rem;font-family:var(--adm-mono);background:rgba(255,255,255,0.08);border:1px solid var(--adm-border);border-radius:10px;padding:0 5px;margin-left:4px;vertical-align:middle;color:var(--adm-muted)">'+count+'</span>' : '';
    if (!body) return '<span style="color:var(--adm-muted);font-size:0.75rem">—</span>'+countBadge;
    var by = inst.latest_comment_by ? '<span style="font-size:0.68rem;color:var(--adm-muted)"> · '+esc(inst.latest_comment_by)+'</span>' : '';
    var limit = 45;
    if (body.length <= limit) return '<span class="admq-comment-snip">'+esc(body)+'</span>'+by+countBadge;
    return '<span class="admq-comment-snip">'+esc(body.substring(0, limit))+'…</span>'+by+countBadge;
  }

  function recIcon(r) {
    var map = {daily:'bi-arrow-repeat',weekly:'bi-calendar-week',monthly:'bi-calendar-month'};
    return (r && r!=='none') ? '<i class="bi '+map[r]+' admq-rec-icon" title="'+r+'"></i>' : '';
  }
  function priorityHtml(p) {
    var lbl = {high:'High',medium:'Medium',low:'Low'};
    return '<span class="admq-priority p-'+(p||'low')+'"><span class="admq-priority-dot"></span>'+(lbl[p]||p||'—')+'</span>';
  }
  function statusHtml(s, late) {
    if (s === 'done' && late) return '<span class="admq-status s-done-late">Delayed Done</span>';
    var lbl = {open:'Open',picked:'In Progress',done:'Done',missed:'Missed',cancelled:'Cancelled',approved:'Approved ✓',rejected:'Rejected ✗',rescheduled:'Rescheduled'};
    return '<span class="admq-status s-'+(s||'open')+'">'+(lbl[s]||s||'—')+'</span>';
  }
  function fmtDuration(from, to) {
    if (!from || !to) return null;
    var ms = new Date(to) - new Date(from);
    if (ms <= 0) return null;
    var mins = Math.round(ms / 60000);
    if (mins < 60) return mins + 'm';
    var h = Math.floor(mins / 60), m = mins % 60;
    return h + 'h' + (m ? ' ' + m + 'm' : '');
  }
  function fileIcon(fname) {
    var ext = (fname||'').split('.').pop().toLowerCase();
    var m = {pdf:'bi-file-earmark-pdf-fill',doc:'bi-file-earmark-word-fill',docx:'bi-file-earmark-word-fill',xls:'bi-file-earmark-excel-fill',xlsx:'bi-file-earmark-excel-fill',png:'bi-file-earmark-image-fill',jpg:'bi-file-earmark-image-fill',jpeg:'bi-file-earmark-image-fill',zip:'bi-file-earmark-zip-fill'};
    return m[ext]||'bi-file-earmark-fill';
  }

  // ── Stats ────────────────────────────────────────────────────────────
  function renderStats(stats, date) {
    document.getElementById('admqStats').innerHTML =
      '<div class="admq-stat" data-filter="total" onclick="admqSetFilter(\'total\')"><span class="admq-stat-count">'+(stats.total||0)+'</span>&nbsp;Total</div>'
      +'<div class="admq-stat s-open" data-filter="open" onclick="admqSetFilter(\'open\')"><span class="admq-stat-dot" style="background:#f97316"></span><span class="admq-stat-count">'+(stats.open||0)+'</span>&nbsp;Open</div>'
      +'<div class="admq-stat s-picked" data-filter="picked" onclick="admqSetFilter(\'picked\')"><span class="admq-stat-dot" style="background:#3b82f6"></span><span class="admq-stat-count">'+(stats.picked||0)+'</span>&nbsp;In Progress</div>'
      +'<div class="admq-stat s-done" data-filter="done" onclick="admqSetFilter(\'done\')"><span class="admq-stat-dot" style="background:#10b981"></span><span class="admq-stat-count">'+(stats.done||0)+'</span>&nbsp;Done</div>'
      +'<div class="admq-stat s-missed" data-filter="missed" onclick="admqSetFilter(\'missed\')"><span class="admq-stat-dot" style="background:#ef4444"></span><span class="admq-stat-count">'+(stats.missed||0)+'</span>&nbsp;Missed</div>'
      +((stats.rescheduled||0)>0?'<div class="admq-stat s-rescheduled" data-filter="rescheduled" onclick="admqSetFilter(\'rescheduled\')"><span class="admq-stat-dot" style="background:#8b5cf6"></span><span class="admq-stat-count">'+(stats.rescheduled||0)+'</span>&nbsp;Rescheduled</div>':'')
      +((stats.cancelled||0)>0?'<div class="admq-stat s-cancelled" data-filter="cancelled" onclick="admqSetFilter(\'cancelled\')"><span class="admq-stat-dot" style="background:#4b5563"></span><span class="admq-stat-count">'+(stats.cancelled||0)+'</span>&nbsp;Cancelled</div>':'')
      +(isPast(date)?'<div class="admq-past-notice"><i class="bi bi-lock"></i> Past date — read only</div>':'');
    admqSyncStatActiveState();
  }

  window.admqSetFilter = function(key) {
    _activeFilter = (_activeFilter === key || key === 'total') ? null : key;
    admqSyncStatActiveState();
    admqApplyFilter();
  };

  function admqSyncStatActiveState() {
    var statsEl = document.getElementById('admqStats');
    statsEl.classList.toggle('has-filter', !!_activeFilter);
    statsEl.querySelectorAll('.admq-stat').forEach(function(el) {
      el.classList.toggle('active', !!_activeFilter && el.dataset.filter === _activeFilter);
    });
  }

  function admqApplyFilter() {
    document.querySelectorAll('.admq-table tbody tr').forEach(function(row) {
      if (row.id === 'admqCancelledToggle') return;
      if (!_activeFilter) {
        if (!row.classList.contains('row-cancelled')) row.style.display = '';
      } else if (_activeFilter === 'open') {
        row.style.display = (row.classList.contains('row-open') || row.classList.contains('row-overdue')) ? '' : 'none';
      } else {
        row.style.display = row.classList.contains('row-' + _activeFilter) ? '' : 'none';
      }
    });
  }

  // ── Table ────────────────────────────────────────────────────────────
  function renderTable(instances, cancelledInstances, date) {
    var area = document.getElementById('admqTableArea');
    var active    = instances || [];
    var cancelled = cancelledInstances || [];
    _loadedInstances = active.concat(cancelled);
    if (!active.length && !cancelled.length) {
      area.innerHTML = '<div class="admq-empty"><i class="bi bi-inbox"></i><div class="admq-empty-title">Queue is empty</div><div class="admq-empty-sub">No requests for '+fmtDate(date)+'</div></div>';
      return;
    }
    var buildRow = function(inst, idx, hidden, isPastRow) {
      var past       = (isPastRow !== undefined) ? isPastRow : isPast(date);
      var isYesterday = isToday && inst.instance_date === yesterday;
      var overdue    = !isYesterday && inst.instance_date < _today && inst.status === 'open';
      var rowCls     = isYesterday ? 'row-yesterday' : (overdue ? 'row-overdue' : 'row-'+inst.status);
      var badge      = isYesterday ? '<span class="admq-yesterday-chip">Yesterday</span>'
                     : overdue     ? '<span class="admq-overdue-chip">Overdue</span>' : '';
      if (inst.rescheduled_from_date) badge += '<span class="admq-rescheduled-chip" title="Rescheduled from '+esc(inst.rescheduled_from_date)+(inst.rescheduled_by_name?' by '+esc(inst.rescheduled_by_name):'')+'">↻ Rescheduled</span>';
      var actions = '';
      if (inst.status === 'missed' || (past && inst.status === 'open')) {
        actions = '<button class="admq-btn pick" title="Pick up (late)" onclick="event.stopPropagation();admqPick('+inst.id+')"><i class="bi bi-hand-index"></i> Pick</button>';
      } else if (!past) {
        if (inst.status === 'open') {
          actions = '<button class="admq-btn pick" title="Pick up" onclick="event.stopPropagation();admqPick('+inst.id+')"><i class="bi bi-hand-index"></i> Pick</button>';
        } else if (inst.status === 'picked') {
          if (inst.picked_by === _userId) {
            actions = '<button class="admq-btn done" title="Mark done" onclick="event.stopPropagation();admqDone('+inst.id+')"><i class="bi bi-check-lg"></i></button>'
                    + '<button class="admq-btn release" title="Release" onclick="event.stopPropagation();admqOpenRelease('+inst.id+')"><i class="bi bi-arrow-counterclockwise"></i></button>'
                    + '<button class="admq-btn comment" title="Add comment" onclick="event.stopPropagation();admqOpenCommentModal('+inst.id+')"><i class="bi bi-chat-left-text"></i></button>';
          } else if (isAdmin()) {
            actions = '<button class="admq-btn done" title="Mark done" onclick="event.stopPropagation();admqDone('+inst.id+')"><i class="bi bi-check-lg"></i></button>'
                    + '<button class="admq-btn comment" title="Add comment" onclick="event.stopPropagation();admqOpenCommentModal('+inst.id+')"><i class="bi bi-chat-left-text"></i></button>';
          } else {
            actions = '<span style="font-size:0.72rem;color:var(--adm-muted)">'+esc(inst.picked_by_name||'')+'</span>';
          }
        } else if (inst.status === 'done') {
          actions = '<i class="bi bi-check-circle-fill" style="color:#10b981;font-size:1rem"></i>';
        }
      } else if (past && inst.status === 'picked') {
        if (inst.picked_by === _userId || isAdmin()) {
          actions = '<button class="admq-btn done" title="Mark done (late)" onclick="event.stopPropagation();admqDone('+inst.id+')"><i class="bi bi-check-lg"></i></button>'
                  + '<button class="admq-btn release" title="Release" onclick="event.stopPropagation();admqOpenRelease('+inst.id+')"><i class="bi bi-arrow-counterclockwise"></i></button>';
        }
      }
      if (inst.status === 'rejected' && isAdmin()) {
        actions = '<button class="admq-btn pick" title="Re-pick rejected task" onclick="event.stopPropagation();admqConfirmRepick('+inst.id+')"><i class="bi bi-arrow-repeat"></i> Re-pick</button>';
      }
      if (inst.status === 'open') {
        actions += '<button class="admq-btn act" title="Reschedule to another date" onclick="event.stopPropagation();admqOpenReschedule('+inst.id+')"><i class="bi bi-calendar-plus"></i></button>';
      }
      if (inst.status === 'cancelled') {
        var cancelInfo = '';
        if (inst.cancelled_by_name || inst.cancelled_at) {
          cancelInfo = '<span style="font-size:0.7rem;color:var(--adm-muted);display:block;margin-bottom:4px">'
            + 'By ' + esc(inst.cancelled_by_name || '—')
            + (inst.cancelled_at ? ' · ' + fmtTime(inst.cancelled_at) : '')
            + '</span>';
        }
        actions = cancelInfo + (isAdmin()
          ? '<button class="admq-btn act" title="Restore to open" onclick="event.stopPropagation();admqUncancel('+inst.id+')"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>'
          : '');
      }
      var titleAttr   = esc(inst.title||'');
      var descAttr    = esc((inst.description||'').trim());
      var commentAttr = esc((inst.latest_comment||'').trim());
      var titleTipAttrs = titleAttr ? ' data-tooltip="'+descAttr+'" data-tip-title="'+titleAttr+'"' : '';
      return '<tr class="'+rowCls+'"'+(hidden?' style="display:none"':'')+' onclick="admqOpenDetail('+inst.id+')">'
        +'<td style="font-family:var(--adm-mono);font-size:0.75rem;color:var(--adm-muted);text-align:center;width:36px">'+(idx+1)+'</td>'
        +'<td class="admq-title-cell"'+titleTipAttrs+'>'+
          '<span class="admq-title-text">'+recIcon(inst.recurrence)+esc(inst.title)+badge+'</span>'+descSnippet(inst)+'</td>'
        +'<td style="font-family:var(--adm-mono);font-size:0.78rem;color:var(--adm-muted);white-space:nowrap;line-height:1.3">'+fmtTime(inst.request_created_at)+'<br><span style="font-size:0.7rem;opacity:0.6">'+fmtDateShort(inst.request_created_at)+'</span></td>'
        +'<td>'+priorityHtml(inst.priority)+'</td>'
        +'<td style="font-family:var(--adm-mono);font-size:0.82rem">'+(inst.due_time||'—')+'</td>'
        +'<td'+(inst.created_by_name?' data-tooltip="'+esc(inst.created_by_name)+'"':'')+'>'+
          (inst.created_by_name
            ? '<span style="display:inline-flex;align-items:center;gap:4px">'
              + '<span data-online-uid="'+inst.created_by+'" class="'+(inst.created_by && _onlineClients.has(inst.created_by) ? 'admq-online-dot' : '')+'" style="width:7px;height:7px;border-radius:50%;flex-shrink:0;display:inline-block"></span>'
              + esc(inst.created_by_name.split(' ')[0])
              + '</span>'
            : '<span style="color:var(--adm-muted)">—</span>')+'</td>'
        +'<td style="line-height:1.3">'+statusHtml(inst.status, inst.completed_late)+((['done','approved'].includes(inst.status)&&fmtDuration(inst.picked_at,inst.completed_at))?'<br><span style="font-family:var(--adm-mono);font-size:0.7rem;opacity:0.55">'+fmtDuration(inst.picked_at,inst.completed_at)+'</span>':'')+'</td>'
        +'<td style="line-height:1.3">'+
          (inst.picked_by_name
            ? esc(inst.picked_by_name.split(' ')[0])+(inst.picked_at?'<br><span style="font-family:var(--adm-mono);font-size:0.7rem;opacity:0.6">'+fmtTime(inst.picked_at)+'</span>':'')
            : '<span style="color:var(--adm-muted)">—</span>')+'</td>'
        +'<td class="admq-comment-cell"'+(commentAttr?' data-tooltip="'+commentAttr+'"':'')+'>'+commentSnippet(inst)+'</td>'
        +'<td><div class="admq-actions">'+actions+'</div></td>'
        +'</tr>';
    };
    var thead = '<thead><tr>'
      +'<th style="text-align:center;width:36px">SN</th><th>Request</th><th>Created</th><th>Priority</th><th>Due</th><th>Creator</th><th>Status</th><th>Picked By</th><th>Latest Comment</th><th></th>'
      +'</tr></thead>';

    var isToday   = (date === _today);
    var yesterday = shiftDate(_today, -1);
    var overdueList = isToday ? active.filter(function(i){ return i.instance_date < _today; }) : [];
    var todayList   = isToday ? active.filter(function(i){ return i.instance_date >= _today; }) : active;

    var cancelledRows = cancelled.map(function(inst, i) {
      return buildRow(inst, (isToday ? todayList.length : active.length) + i, true, true);
    }).join('');
    var cancelledFooter = cancelled.length > 0
      ? '<tr id="admqCancelledToggle" onclick="admqToggleCancelled()" style="cursor:pointer">'
          +'<td colspan="10"><div class="admq-cancelled-toggle">'
            +'<i class="bi bi-chevron-right" id="admqCancelledChevron" style="transition:transform 0.2s"></i>'
            +'Show '+cancelled.length+' cancelled request'+(cancelled.length > 1 ? 's' : '')
          +'</div></td>'
        +'</tr>'
      : '';

    if (isToday) {
      // Yesterday's items shown at top of Today section with danger background
      // Older items (before yesterday) are hidden for now
      var yesterdayItems = overdueList.filter(function(i){ return i.instance_date === yesterday; });
      var yesterdayRows  = yesterdayItems.map(function(inst, i){ return buildRow(inst, i, false, true); }).join('');
      var todayRows      = todayList.map(function(inst, i){ return buildRow(inst, i, false, false); }).join('');
      var yc = yesterdayItems.length;
      var emptyToday = !todayRows && !yesterdayRows
        ? '<tr><td colspan="10" style="text-align:center;padding:22px;color:var(--adm-muted);font-size:0.82rem"><i class="bi bi-check-circle" style="margin-right:6px"></i>No requests for today</td></tr>'
        : '';

      var hdrCount = '<span class="admq-section-hdr-count admq-today-count">'+todayList.length+'</span>'
        + (yc > 0 ? '<span class="admq-section-hdr-count admq-overdue-count" style="margin-left:4px" title="'+yc+' from yesterday">+'+yc+' yest.</span>' : '');

      area.innerHTML =
        '<div class="admq-section-hdr admq-section-hdr-today">'
          +'<i class="bi bi-calendar-check"></i>'
          +'<span class="admq-section-hdr-title">Today</span>'
          +hdrCount
        +'</div>'
        +'<div class="admq-table-wrap"><table class="admq-table">'+thead
          +'<tbody>'+yesterdayRows+emptyToday+todayRows+cancelledFooter+cancelledRows+'</tbody>'
        +'</table></div>';

    } else {
      var isPastDate  = isPast(date);
      var activeRows  = active.map(function(inst, i){ return buildRow(inst, i, false, isPastDate); }).join('');
      area.innerHTML  = '<div class="admq-table-wrap"><table class="admq-table">'+thead+'<tbody>'+activeRows+cancelledFooter+cancelledRows+'</tbody></table></div>';
    }
    admqApplyFilter();
  }

  window.admqToggleCancelled = function() {
    var rows     = document.querySelectorAll('.admq-table tbody tr.row-cancelled');
    var chevron  = document.getElementById('admqCancelledChevron');
    var toggle   = document.getElementById('admqCancelledToggle');
    var hidden   = rows.length && rows[0].style.display === 'none';
    rows.forEach(function(r) { r.style.display = hidden ? '' : 'none'; });
    if (chevron) chevron.style.transform = hidden ? 'rotate(90deg)' : '';
    if (toggle) {
      var count = rows.length;
      toggle.querySelector('.admq-cancelled-toggle').innerHTML =
        '<i class="bi bi-chevron-'+(hidden?'down':'right')+'" id="admqCancelledChevron" style="transition:transform 0.2s"></i>'
        +(hidden ? 'Hide' : 'Show')+' '+count+' cancelled request'+(count>1?'s':'');
    }
  };

  window.admqToggleOverdue = function() {
    var body    = document.getElementById('admqOverdueBody');
    var chevron = document.getElementById('admqOverdueChevron');
    if (!body) return;
    var opening = body.style.display === 'none';
    body.style.display    = opening ? '' : 'none';
    if (chevron) chevron.style.transform = opening ? 'rotate(90deg)' : '';
  };

  window.admqShowAllOverdue = function() {
    var linkRow = document.getElementById('admqViewAllOverdueRow');
    if (!linkRow || !window._admqOlderOverdueHtml) return;
    linkRow.outerHTML = window._admqOlderOverdueHtml;
    window._admqOlderOverdueHtml = null;
  };

  window.admqUncancel = function(id) {
    if (!confirm('Restore this request to open?')) return;
    fetch('/queue/'+id+'/uncancel', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function(r){ return r.json(); })
      .then(function(res){ if (res.success) loadDate(_date); else alert(res.message || 'Failed to restore'); })
      .catch(function(){ alert('Network error'); });
  };

  // ── Load date via API ────────────────────────────────────────────────
  function loadDate(date) {
    _date = date;
    document.getElementById('admqDatePicker').value = date;
    document.getElementById('admqTableArea').innerHTML = '<div class="admq-loading"><div class="admq-spinner"></div></div>';
    fetch('/queue/data?date='+date).then(function(r){return r.json();}).then(function(res){
      if (!res.success) return;
      _activeFilter = null;
      renderStats(res.data.stats, date);
      renderTable(res.data.instances, res.data.cancelledInstances, date);
    }).catch(function(){
      document.getElementById('admqTableArea').innerHTML = '<div class="admq-empty"><i class="bi bi-exclamation-circle"></i><div class="admq-empty-title">Failed to load</div></div>';
    });
  }

  // ── Date navigation ──────────────────────────────────────────────────
  function shiftDate(d, days) { var dt=new Date(d+'T00:00:00'); dt.setDate(dt.getDate()+days); return dt.toISOString().split('T')[0]; }
  document.getElementById('admqPrev').onclick      = function(){ loadDate(shiftDate(_date,-1)); };
  document.getElementById('admqNext').onclick      = function(){ loadDate(shiftDate(_date, 1)); };
  document.getElementById('admqYesterday').onclick = function(){ loadDate(shiftDate(_today,-1)); };
  document.getElementById('admqToday').onclick     = function(){ loadDate(_today); };
  document.getElementById('admqTomorrow').onclick  = function(){ loadDate(shiftDate(_today, 1)); };
  document.getElementById('admqDatePicker').onchange = function(){ loadDate(this.value); };

  // ── Pick / Done / Release ────────────────────────────────────────────
  function postJson(url) {
    return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'}}).then(function(r){return r.json();});
  }
  window.admqPick = function(id) {
    postJson('/queue/'+id+'/pick').then(function(res){
      if (res.success) { loadDate(_date); if (_detailId===id) admqOpenDetail(id); }
      else alert(res.message||'Failed to pick');
    });
  };

  window.admqConfirmRepick = function(id) {
    var inst = _loadedInstances.find(function(i) { return i.id === id; });
    var title = inst ? esc(inst.title) : 'this task';
    if (!confirm('Re-pick "' + title + '"?\n\nThis task was rejected. Re-picking it will bypass the rejection and assign it back to you.')) return;
    postJson('/queue/'+id+'/pick').then(function(res){
      if (res.success) { loadDate(_date); if (_detailId===id) admqOpenDetail(id); }
      else alert(res.message||'Failed to re-pick');
    });
  };
  var _doneInstanceId = null;
  var _loadedInstances = [];
  window.admqDone = function(id) {
    _doneInstanceId = id;
    var inst = _loadedInstances.find(function(i) { return i.id === id; });
    if (inst && (inst.latest_comment || '').trim()) {
      // Already has a comment — submit directly without modal
      var btn = document.getElementById('admqDoneConfirmBtn');
      btn.disabled = true;
      fetch('/queue/'+id+'/complete', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({remark:''})})
        .then(function(r){ return r.json(); })
        .then(function(res){
          _doneInstanceId = null;
          if (res.success) { loadDate(_date); if (_detailId===id) admqCloseDetail(); }
          else alert(res.message||'Failed to complete');
        }).finally(function(){ btn.disabled = false; });
      return;
    }
    document.getElementById('admqDoneRemark').value = '';
    document.getElementById('admqDoneModal').style.display = 'flex';
    setTimeout(function(){ document.getElementById('admqDoneRemark').focus(); }, 50);
  };
  window.admqCloseDoneModal = function() {
    document.getElementById('admqDoneModal').style.display = 'none';
    _doneInstanceId = null;
  };
  window.admqConfirmDone = function() {
    var id = _doneInstanceId;
    if (!id) return;
    var remark = document.getElementById('admqDoneRemark').value.trim();
    if (!remark) { document.getElementById('admqDoneRemark').focus(); return; }
    var btn = document.getElementById('admqDoneConfirmBtn');
    btn.disabled = true;
    fetch('/queue/'+id+'/complete', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({remark:remark})})
      .then(function(r){ return r.json(); })
      .then(function(res){
        admqCloseDoneModal();
        if (res.success) { loadDate(_date); if (_detailId===id) admqCloseDetail(); }
        else alert(res.message||'Failed to complete');
      }).finally(function(){ btn.disabled = false; });
  };
  var _rescheduleInstanceId = null;
  window.admqOpenReschedule = function(id) {
    _rescheduleInstanceId = id;
    var tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
    var minDate = tomorrow.toISOString().split('T')[0];
    var dateEl = document.getElementById('admqRescheduleDate');
    dateEl.min = minDate;
    dateEl.value = minDate;
    // Populate assignee dropdown
    var sel = document.getElementById('admqRescheduleAssignee');
    sel.innerHTML = '<option value="">— Unassigned —</option>';
    _localUsers.forEach(function(u) {
      var opt = document.createElement('option');
      opt.value = u.id;
      opt.textContent = u.name + ' (' + u.role_name + ')';
      sel.appendChild(opt);
    });
    // Pre-select the instance's current effective assignee
    var inst = _loadedInstances.find(function(i) { return i.id === id; });
    if (inst && inst.effective_assigned_to) sel.value = inst.effective_assigned_to;
    document.getElementById('admqRescheduleReason').value = '';
    document.getElementById('admqRescheduleConfirmBtn').disabled = false;
    document.getElementById('admqRescheduleModal').style.display = 'flex';
    setTimeout(function(){ document.getElementById('admqRescheduleReason').focus(); }, 50);
  };
  window.admqCloseReschedule = function() {
    document.getElementById('admqRescheduleModal').style.display = 'none';
    _rescheduleInstanceId = null;
  };
  window.admqConfirmReschedule = function() {
    if (!_rescheduleInstanceId) return;
    var newDate    = document.getElementById('admqRescheduleDate').value;
    var reason     = document.getElementById('admqRescheduleReason').value.trim();
    var assignedTo = document.getElementById('admqRescheduleAssignee').value;
    if (!newDate) { alert('Please select a date.'); return; }
    if (!reason)  { document.getElementById('admqRescheduleReason').focus(); return; }
    var btn = document.getElementById('admqRescheduleConfirmBtn');
    btn.disabled = true;
    fetch('/queue/'+_rescheduleInstanceId+'/reschedule', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ new_date: newDate, reason: reason, assigned_to: assignedTo || null })
    }).then(function(r){ return r.json(); })
      .then(function(res){
        admqCloseReschedule();
        if (res.success) loadDate(_date);
        else alert(res.message || 'Failed to reschedule');
      }).finally(function(){ btn.disabled = false; });
  };

  window.admqOpenRelease = function(id) {
    _releaseId = id;
    document.getElementById('admqReleaseReason').value = '';
    document.getElementById('admqReleaseModal').style.display = 'flex';
  };
  window.admqCloseRelease = function() {
    document.getElementById('admqReleaseModal').style.display = 'none';
    _releaseId = null;
  };
  window.admqConfirmRelease = function() {
    if (!_releaseId) return;
    var reason = document.getElementById('admqReleaseReason').value.trim();
    fetch('/queue/'+_releaseId+'/release',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({reason:reason})})
      .then(function(r){return r.json();}).then(function(res){
        admqCloseRelease();
        if (res.success) { loadDate(_date); if (_detailId===_releaseId) admqCloseDetail(); }
        else alert(res.message||'Failed');
      });
  };

  // ── Quick Comment modal ──────────────────────────────────────────────
  // redirect old quick-comment button → chat modal
  window.admqOpenCommentModal = function(id) { admqOpenChat(id); };
  window.admqCloseCommentModal = function() {};
