  fetch('/queue/client-online').then(function(r){ return r.json(); }).then(function(res) {
    if (!res.success) return;
    _onlineClients = new Set(res.data.online);
    document.querySelectorAll('[data-online-uid]').forEach(function(el) {
      var uid = parseInt(el.getAttribute('data-online-uid'));
      el.className = _onlineClients.has(uid) ? 'admq-online-dot' : '';
