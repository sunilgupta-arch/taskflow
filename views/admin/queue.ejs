  // ── Chat Modal ───────────────────────────────────────────────────────
  var _chatInstanceId  = null;
  var _chatPendingFiles = [];   // { file, dataUrl, name, mime }

  function _mimeIcon(mime) {
    if (!mime) return 'bi-file-earmark';
    if (mime.startsWith('image/'))    return 'bi-file-image';
    if (mime === 'application/pdf')   return 'bi-file-earmark-pdf';
    if (mime.includes('word'))        return 'bi-file-earmark-word';
    if (mime.includes('excel') || mime.includes('spreadsheet')) return 'bi-file-earmark-excel';
    if (mime.includes('zip'))         return 'bi-file-zip';
    return 'bi-file-earmark';
  }

  function _fmtBytes(b) {
    if (!b) return '';
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b/1024).toFixed(0) + ' KB';
    return (b/1048576).toFixed(1) + ' MB';
  }

  function _renderChatMessages(comments) {
    var box = document.getElementById('admqChatMessages');
    if (!comments || !comments.length) {
      box.innerHTML = '<div class="admqc-empty"><i class="bi bi-chat-left-dots" style="font-size:2rem;opacity:.3"></i><span>No messages yet. Start the conversation.</span></div>';
      return;
    }
    box.innerHTML = comments.map(function(c) {
      var isMe = (c.commenter_role && !c.commenter_role.startsWith('CLIENT'));
      var side  = isMe ? 'mine' : 'theirs';
      var bg    = c.commenter_role && c.commenter_role.startsWith('CLIENT') ? '#3b82f6' : '#10b981';
      var init  = (c.commenter_name || '?').charAt(0).toUpperCase();

      var bodyHtml = c.body ? '<div class="admqc-bubble">'+esc(c.body)+'</div>' : '';

      var filesHtml = '';
      if (c.files && c.files.length) {
        var chips = c.files.map(function(f) {
          var isImg = f.mime_type && f.mime_type.startsWith('image/');
          if (isImg) {
            return '<a href="/queue/chat-file/'+f.id+'" target="_blank" rel="noopener">'
              +'<img src="/queue/chat-file/'+f.id+'" class="admqc-img-thumb" alt="'+esc(f.file_name)+'" loading="lazy" onerror="this.style.display=\'none\'">'
              +'</a>';
          }
          return '<a class="admqc-chip" href="/queue/chat-file/'+f.id+'" target="_blank" rel="noopener">'
            +'<i class="bi '+_mimeIcon(f.mime_type)+'"></i>'
            +esc(f.file_name)+(f.file_size?' <span style="opacity:.5">'+_fmtBytes(f.file_size)+'</span>':'')
            +'</a>';
        }).join('');
        filesHtml = '<div class="admqc-file-chips">'+chips+'</div>';
      }

      if (!bodyHtml && !filesHtml) return '';

      return '<div class="admqc-bubble-wrap '+side+'">'
        +'<div class="admqc-avatar" style="background:'+bg+'">'+init+'</div>'
        +'<div>'
          +(bodyHtml || '') + filesHtml
          +'<div class="admqc-meta">'+esc(c.commenter_name||'')+'&nbsp;·&nbsp;'+fmtTs(c.created_at)+'</div>'
        +'</div>'
      +'</div>';
    }).join('');
    box.scrollTop = box.scrollHeight;
  }

  function _renderPreviews() {
    var strip = document.getElementById('admqChatPreviews');
    if (!_chatPendingFiles.length) { strip.innerHTML = ''; return; }
    strip.innerHTML = _chatPendingFiles.map(function(pf, i) {
      var preview = pf.dataUrl
        ? '<img src="'+pf.dataUrl+'" class="admqc-preview-img">'
        : '<i class="bi '+_mimeIcon(pf.mime)+'" style="font-size:1.2rem"></i>';
      return '<div class="admqc-preview-item">'
        +preview
        +'<span>'+esc(pf.name)+'</span>'
        +'<button class="admqc-preview-rm" onclick="_admqRemoveFile('+i+')">×</button>'
      +'</div>';
    }).join('');
  }

  window._admqRemoveFile = function(i) {
    _chatPendingFiles.splice(i, 1);
    _renderPreviews();
  };

  function _addFiles(fileList) {
    Array.prototype.forEach.call(fileList, function(file) {
      if (_chatPendingFiles.length >= 5) return;
      var isImg = file.type.startsWith('image/');
      if (isImg) {
        var reader = new FileReader();
        reader.onload = function(e) {
          _chatPendingFiles.push({ file: file, dataUrl: e.target.result, name: file.name, mime: file.type });
          _renderPreviews();
        };
        reader.readAsDataURL(file);
      } else {
        _chatPendingFiles.push({ file: file, dataUrl: null, name: file.name, mime: file.type });
        _renderPreviews();
      }
    });
  }

