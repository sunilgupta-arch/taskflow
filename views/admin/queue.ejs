  function _addDrawerFiles(fileList) {
    Array.prototype.forEach.call(fileList, function(file) {
      if (_drawerPendingFiles.length >= 5) return;
      if (file.type.startsWith('image/')) {
        var reader = new FileReader();
        reader.onload = function(e) {
          _drawerPendingFiles.push({ file: file, dataUrl: e.target.result, name: file.name, mime: file.type });
          _renderDrawerPreviews();
        };
        reader.readAsDataURL(file);
      } else {
        _drawerPendingFiles.push({ file: file, dataUrl: null, name: file.name, mime: file.type });
        _renderDrawerPreviews();
      }
    });
