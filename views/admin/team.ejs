    <div class="adm-card-body">
      <div class="adm-card-title">Leave Management</div>
      <div class="adm-card-desc">Review pending leave applications, approve or reject requests, and view leave history</div>
    </div>
    <div class="adm-card-footer"><span>Manage Leaves</span><i class="bi bi-arrow-right"></i></div>
  </a>

  <a href="/admin/comp-off" class="adm-card" style="--card-accent:#8b5cf6;--card-rgb:139,92,246">
    <div class="adm-card-icon"><i class="bi bi-calendar2-check"></i></div>
    <div class="adm-card-body">
      <div class="adm-card-title">Comp-Off</div>
