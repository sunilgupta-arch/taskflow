<div class="adm-hub-header">
  <div class="adm-section-pill" style="background:rgba(139,92,246,0.1);color:#8b5cf6;border:1px solid rgba(139,92,246,0.2)">
    <i class="bi bi-people-fill"></i> Team
  </div>
  <h1 class="adm-hub-title">Team</h1>
  <p class="adm-hub-sub">Monitor your team, manage users, attendance, and leave requests</p>
</div>

<div class="adm-cards">

  <a href="/admin/live-status" class="adm-card" style="--card-accent:#10b981;--card-rgb:16,185,129">
    <div class="adm-card-icon"><i class="bi bi-broadcast"></i></div>
    <div class="adm-card-body">
      <div class="adm-card-title">Live Status</div>
      <div class="adm-card-desc">Real-time view of who is working, idle, absent or off-shift — refreshed live via socket</div>
    </div>
    <div class="adm-card-footer"><span>View Status</span><i class="bi bi-arrow-right"></i></div>
  </a>

  <a href="/admin/users" class="adm-card" style="--card-accent:#8b5cf6;--card-rgb:139,92,246">
    <div class="adm-card-icon"><i class="bi bi-people"></i></div>
    <div class="adm-card-body">
      <div class="adm-card-title">Users</div>
      <div class="adm-card-desc">Manage team members, their roles, shifts, and account settings from one place</div>
    </div>
    <div class="adm-card-footer"><span>Manage Users</span><i class="bi bi-arrow-right"></i></div>
  </a>

  <a href="/admin/attendance" class="adm-card" style="--card-accent:#f59e0b;--card-rgb:245,158,11">
    <div class="adm-card-icon"><i class="bi bi-clock-history"></i></div>
    <div class="adm-card-body">
      <div class="adm-card-title">Attendance</div>
