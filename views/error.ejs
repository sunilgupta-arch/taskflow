<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<script>(function(){var t=localStorage.getItem('tf-theme')||'dark';document.documentElement.setAttribute('data-bs-theme',t);})()</script>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error <%= code || 500 %> - TaskFlow</title>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
  <style>
    [data-bs-theme="dark"] { --bg: #0a0e1a; --text: #e2e8f0; --accent: #00d4ff; --muted: #64748b; }
    [data-bs-theme="light"] { --bg: #f1f5f9; --text: #1e293b; --accent: #0284c7; --muted: #64748b; }
    body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .code { font-family: 'Space Mono', monospace; font-size: 6rem; font-weight: 700; color: var(--accent); line-height: 1; }
    .msg { font-size: 1.1rem; color: var(--muted); margin: 1rem 0 1.5rem; }
    .actions { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
    a.link { color: var(--accent); text-decoration: none; font-family: 'Space Mono', monospace; font-size: 0.8rem; }
    .clear-btn { display: inline-flex; align-items: center; gap: 8px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #ef4444; font-family: 'Space Mono', monospace; font-size: 0.78rem; padding: 8px 18px; border-radius: 8px; text-decoration: none; transition: background 0.15s; cursor: pointer; }
    .clear-btn:hover { background: rgba(239,68,68,0.18); }
    .clear-hint { font-size: 0.7rem; color: var(--muted); max-width: 340px; line-height: 1.5; }
  </style>
</head>
<body>
  <div style="text-align:center;">
    <div class="code"><%= code || 500 %></div>
    <div class="msg"><%= message || 'Something went wrong' %></div>
    <div class="actions">
      <a href="/dashboard" class="link">← Return to Dashboard</a>
      <% if ((code || 500) === 403) { %>
        <a href="/auth/clear-session" class="clear-btn">⟳ Clear session &amp; Login again</a>
        <div class="clear-hint">If you keep seeing this after logging in, click the button above. It clears your stored session and takes you back to the login page.</div>
      <% } %>
    </div>
  </div>
</body>
</html>
